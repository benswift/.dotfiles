<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Mirror ~/Documents to weddle every hour (bin/backup with the -d flag).

  Hourly is cheap: a run with little to push takes seconds (about 150k files
  checked), bin/backup exits at once on a metered network (a tethered phone),
  and launchd never starts a second copy of a job that is still running.

  Maildir is not included --- com.benswift.maildir-mirror pushes that hourly,
  and keeping the two jobs to separate trees means they never sync the same
  one at once. A disk image attached from ~/Documents (the vault) is skipped
  for that run and picked up by the next one after it is ejected.

  Install (not in the symlink manifest because ~/Library only exists on
  macOS):

    cp ~/.dotfiles/launchd/com.benswift.documents-backup.plist ~/Library/LaunchAgents/
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.benswift.documents-backup.plist
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.benswift.documents-backup</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/ben/.dotfiles/bin/backup</string>
        <string>--documents</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/ben/.dotfiles/bin:/Users/ben/.local/share/mise/shims:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
    <key>StartInterval</key>
    <integer>3600</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/Users/ben/Library/Logs/documents-backup.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/ben/Library/Logs/documents-backup.log</string>
</dict>
</plist>

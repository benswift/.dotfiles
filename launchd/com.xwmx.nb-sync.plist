<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hourly nb sync on macOS hosts (the notebook's ~/.nb/home/CLAUDE.md Sync
  section refers to this), run under bin/launchd-run (PATH, timeout, failure
  paging --- see its header). weddle runs the same cadence from nb-sync.timer,
  seven minutes past the hour so the two hosts never push at once.

  Hourly rather than daily because the notebook is written from several hosts
  at once: a daily sync left weddle nineteen commits behind by mid-afternoon
  and diverged by evening, so each side kept merging the other's day.

  StartCalendarInterval is not a wall-clock guarantee: on a laptop asleep at
  the hour, launchd defers the run until the machine wakes and then fires it
  immediately, before wifi has associated, and `nb sync` dies resolving
  github.com. bin/wait-for-network is the same guard the systemd units use as
  ExecStartPre. If the network never arrives the run is skipped with exit 0:
  being offline is not a failure, and the next hour retries.

  The wake launchd fires that deferred run in may be a DarkWake --- powerd's
  screen-off maintenance window --- which can end seconds later with the sync
  still running. Nothing runs while suspended, so the -t alarm below does not
  fire either: one such run held launchd's one-instance slot for two hours and
  the next hourly sync never started. bin/in-darkwake skips those, also with
  exit 0, since launchd re-fires the deferred run at the following wake.

  Install:
    cp ~/.dotfiles/launchd/com.xwmx.nb-sync.plist ~/Library/LaunchAgents/
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.xwmx.nb-sync.plist
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.xwmx.nb-sync</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/ben/.dotfiles/bin/launchd-run</string>
        <string>nb-sync</string>
        <string>-t</string>
        <string>900</string>
        <string>--</string>
        <string>/bin/sh</string>
        <string>-c</string>
        <string>in-darkwake &amp;&amp; exit 0; wait-for-network || exit 0; nb sync --all</string>
    </array>
    <!-- Minute alone, with no Hour key, means every hour on the hour. A run
         missed while the machine slept is coalesced into a single run at
         wake, not replayed once per hour skipped. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Minute</key>
        <integer>0</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>/Users/ben/Library/Logs/nb-sync.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/ben/Library/Logs/nb-sync.log</string>
</dict>
</plist>

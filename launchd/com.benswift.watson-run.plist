<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  watson only: every 15 minutes, run the lx vault's automation
  (~/wiz/admin/tools/watson-run, whose header says what it does) under
  bin/launchd-run (PATH, timeout, failure paging; see its header). watson
  takes the place of the generic wiz-due agent here, because it runs the wiz
  the lx vault pins rather than the dotfiles' build.

  watson is always on, so there is no DarkWake or network guard: a run that
  can't reach GitLab is a failure worth paging about. weddle's morning health
  check watches this job's last exit and its log's age, so a watson that dies
  outright still pages.

  Install:
    cp ~/.dotfiles/launchd/com.benswift.watson-run.plist ~/Library/LaunchAgents/
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.benswift.watson-run.plist
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.benswift.watson-run</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/ben/.dotfiles/bin/launchd-run</string>
        <string>watson-run</string>
        <string>-t</string>
        <string>600</string>
        <string>--</string>
        <string>/bin/sh</string>
        <string>/Users/ben/wiz/admin/tools/watson-run</string>
    </array>
    <key>StartInterval</key>
    <integer>900</integer>
    <key>StandardOutPath</key>
    <string>/Users/ben/Library/Logs/watson-run.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/ben/Library/Logs/watson-run.log</string>
</dict>
</plist>

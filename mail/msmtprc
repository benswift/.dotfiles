# msmtp configuration file

# Default settings
defaults
auth on
tls on
logfile ~/.local/state/msmtp/msmtp.log

# ANU Office 365 account
account anu
host smtp.office365.com
port 587
from ben.swift@anu.edu.au
user u2548636@anu.edu.au
auth xoauth2
passwordeval "$HOME/.dotfiles/bin/mail-secret oauth anu"

# Same mailbox, reached via the uid address. msmtp picks the account whose
# `from` matches the envelope sender, and neomutt's reverse_name puts this
# address in From when replying to mail sent to it; without this block such
# replies fall through to the default (Fastmail) account and are rejected.
account anu-uid : anu
from u2548636@anu.edu.au

# PhD Convenor ANU account (delegated mailbox)
account phdconvenor
host smtp.office365.com
port 587
from phdconvenor.cybernetics@anu.edu.au
user u2548636@anu.edu.au
auth xoauth2
passwordeval "$HOME/.dotfiles/bin/mail-secret oauth anu"

# Personal Fastmail account
account personal
host smtp.fastmail.com
port 587
from ben@benswift.me
user benswift@fastmail.com
auth plain
passwordeval "$HOME/.dotfiles/bin/mail-secret get benswift@fastmail.com mbsync-fastmail"

# Set a default account
account default : personal

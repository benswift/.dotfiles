# ANU (Office 365) account settings

# Email addresses for this account
alternates ^u2548636@anu\\.edu\\.au$ ^ben\\.swift@anu\\.edu\\.au$

# Folder settings
set from = "ben.swift@anu.edu.au"

# Message-ID domain (without this neomutt uses the system FQDN, which
# here is a Tailscale name that doesn't resolve publicly --- a spam
# signal at some receivers).
set hostname = "anu.edu.au"
set folder = ~/Maildir/anu/
set spoolfile = +INBOX
set postponed = +Drafts
# No Fcc: Office 365 files its own copy of anything submitted through SMTP
# AUTH into Sent Items, and there's no supported way to turn that off. An
# Fcc on top of that is a second copy of every message neomutt sends ---
# which is how 40% of this folder ended up duplicated. Exchange's copy is
# the better one anyway: neomutt writes its Fcc before submission, so it
# carries no Received chain and no X-MS-Exchange-* headers. The cost is
# that a sent message only shows up here after the next mailsync.
#
# Fastmail does NOT do this, so the personal account keeps its record.
unset record
set trash = +Deleted\ Items

# Sending mail via msmtp
set sendmail = "msmtp"
set use_from = yes
set envelope_from = yes

# Signature
set signature = ~/.config/neomutt/signature-anu

# ANU account specific settings
set status_format = "[ANU] %f [%M/%m] %?n?%n new? %?d?%d del? %?t?%t tag?"

# Account-specific colours (catppuccin mocha — mauve)
color status #1e1e2e #cba6f7

# Account-specific search (restricted to this account)
macro index / "<shell-escape>~/.config/neomutt/scripts/mu-search.sh /anu/<enter><change-folder-readonly>~/.mu/results<enter>" "search anu"

# LX Convenor (shared mailbox) account settings

# Email addresses for this account. The address is shared, so "from me" is
# only half true here: mail the other holders send from it is marked as Ben's
# own too (the F flag, "To <recipient>" in the index), and it is a mu personal
# address on the same terms. Kept regardless, because it is what makes Sent
# Items readable and lets reverse_name reply from the role address.
alternates ^lxconvenor\\.cybernetics@anu\\.edu\\.au$

# Folder settings
set from = "lxconvenor.cybernetics@anu.edu.au"

# Message-ID domain (without this neomutt uses the system FQDN, which
# here is a Tailscale name that doesn't resolve publicly --- a spam
# signal at some receivers).
set hostname = "anu.edu.au"
set folder = ~/Maildir/lxconvenor/
set spoolfile = +INBOX
set postponed = +Drafts
# No Fcc --- same reason as the anu account: Exchange files its own copy of
# anything submitted over SMTP AUTH.
unset record
set trash = +"Deleted Items"

# Sending mail via msmtp
set sendmail = "msmtp"
set use_from = yes
set envelope_from = yes

# No signature: mail from the role address isn't signed as Ben. Explicitly
# unset, because the folder-hook sources this over whichever account was
# active before and would otherwise inherit its signature.
unset signature

# LX Convenor specific settings
set status_format = "[LX CONVENOR] %f [%M/%m] %?n?%n new? %?d?%d del? %?t?%t tag?"

# Account-specific colours (catppuccin mocha — green)
color status #1e1e2e #a6e3a1

# Account-specific search (restricted to this account)
macro index / "<shell-escape>~/.config/neomutt/scripts/mu-search.sh /lxconvenor/<enter><change-folder-readonly>~/.mu/results<enter>" "search lxconvenor"

# PhD Convenor (delegated mailbox) account settings

# Email addresses for this account
alternates ^phdconvenor\\.cybernetics@anu\\.edu\\.au$

# Folder settings
set from = "phdconvenor.cybernetics@anu.edu.au"
set folder = ~/Maildir/phdconvenor/
set spoolfile = +INBOX
set postponed = +Drafts
# No Fcc --- same reason as the anu account, and even more pronounced here
# (91% of this folder was duplicated). Exchange files send-as mail into the
# delegated mailbox's own Sent Items, not Ben's: the pulled copies carry
# X-MS-Exchange-MessageSentRepresentingType, so dropping the local Fcc
# doesn't cost the convenor trail.
unset record
set trash = +"Deleted Items"

# Sending mail via msmtp
set sendmail = "msmtp"
set use_from = yes
set envelope_from = yes

# Signature
set signature = ~/.config/neomutt/signature-anu

# PhD Convenor specific settings
set status_format = "[PHD CONVENOR] %f [%M/%m] %?n?%n new? %?d?%d del? %?t?%t tag?"

# Account-specific colours (catppuccin mocha — teal)
color status #1e1e2e #94e2d5

# Account-specific search (restricted to this account)
macro index / "<shell-escape>~/.config/neomutt/scripts/mu-search.sh /phdconvenor/<enter><change-folder-readonly>~/.mu/results<enter>" "search phdconvenor"

# Personal (Fastmail) account settings

# Email addresses for this account
alternates ^benswift@fastmail\\.com$ ^ben@benswift\\.me$

# Folder settings
set from = "ben@benswift.me"

# Message-ID domain (without this neomutt uses the system FQDN, which
# here is a Tailscale name that doesn't resolve publicly --- a spam
# signal at some receivers).
set hostname = "benswift.me"
set folder = ~/Maildir/personal/
set spoolfile = +INBOX
set postponed = +Drafts
set record = +"Sent Items"
set trash = +Trash

# Sending mail via msmtp
set sendmail = "msmtp"
set use_from = yes
set envelope_from = yes

# Signature
set signature = ~/.config/neomutt/signature

# Personal account specific settings
set status_format = "[PERSONAL] %f [%M/%m] %?n?%n new? %?d?%d del? %?t?%t tag?"

# Account-specific colours (catppuccin mocha — peach)
color status #1e1e2e #fab387

# Account-specific search (restricted to this account)
macro index / "<shell-escape>~/.config/neomutt/scripts/mu-search.sh /personal/<enter><change-folder-readonly>~/.mu/results<enter>" "search personal"

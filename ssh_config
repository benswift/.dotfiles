# Added by OrbStack: 'orb' SSH host for Linux machines
# This only works if it's at the top of ssh_config (before any Host blocks).
# Comment this line if you don't want it to be added again.
Include ~/.orbstack/ssh/config

# The private overlay's hosts (lib/private.sh). Up here for the same reason as
# OrbStack's: an Include after a Host line is scoped to that block. A missing
# file matches nothing, so a machine without the overlay just skips it.
Include ~/.dotfiles/private/ssh_config

Host *
  IgnoreUnknown UseKeychain
  AddKeysToAgent yes
  UseKeychain yes
  # Bound every stalled connection. Without these, ssh has ConnectTimeout none
  # and ServerAliveInterval 0, so a session whose TCP died under the laptop ---
  # a sleep mid-transfer, a wifi roam --- blocks until the kernel's 2-hour
  # keepalive gives up. That is how a scheduled sync held launchd's
  # one-instance slot for two hours and skipped the next hourly run. Probes go
  # out regardless of traffic and the server answers them, so an idle but
  # healthy session is untouched; only a dead path is reaped, after ~60s.
  # First-obtained-value-wins, and this block is first, so these are global.
  ConnectTimeout 20
  ServerAliveInterval 20
  ServerAliveCountMax 3

# git remotes
Host github.com
  HostName github.com
  User git

Host gitlab.anu.edu.au
  HostName gitlab.anu.edu.au
  User git
  IdentityFile ~/.ssh/id_ed25519
  IdentitiesOnly yes

Host gitlab.comp.anu.edu.au
  HostName gitlab.comp.anu.edu.au
  User git
  IdentityFile ~/.ssh/id_ed25519
  IdentitiesOnly yes

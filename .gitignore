mail/backups-and-logs/

# Zed extension build artifacts
zed/extensions/**/*.wasm

# Compiled Apple Shortcuts (built from .cherri sources)
*.shortcut

# Python bytecode
__pycache__/

# Claude Code project-local directory (machine-specific), except the
# settings file: it switches off the impeccable design hook, which has
# nothing to do here and scatters .impeccable/ caches through the tree.
# That decision belongs on every machine, so it's tracked.
.claude/*
!.claude/settings.json

# Agent runtime state and obsolete project-level shims
.agents
codex.md
.impeccable/
.remember/

# Tool caches and scratch space
.pytest_cache/
.ruff_cache/
/tmp/

# Private Claude Code plugins (cloned separately by install.sh / dotfiles update)
claude-plugins/

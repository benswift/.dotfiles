#!/usr/bin/env bash
###############################################################################
# lumis-highlight.nb-plugin
#
# Highlight `nb show` (and everything else that renders note content) with
# bin/ts-cat --- lumis, falling back to bat --- instead of nb's plain bat, by
# overriding nb's _highlight_syntax_if_available(). lumis follows tree-sitter
# language injections, so the YAML frontmatter atop a note gets highlighted as
# YAML and fenced code blocks as their own language. Language overrides, theme
# and fallback all live in ts-cat, shared with yazi's preview pane.
#
# Overriding an internal function is possible because nb sources plugins
# after its own definitions, and it's inherently coupled to nb's interface:
# the argument is either a path (contains a slash) or a bare extension, with
# stdin holding the content in the extension case. If an nb update changes
# that contract, delete this plugin and nb falls back to bat unharmed.
#
# Installation: symlinked into ~/.nb/.plugins by create_symlinks.sh.
###############################################################################

if command -v ts-cat &> /dev/null; then
  _highlight_syntax_if_available() {
    if ! ((_COLOR_ENABLED)); then
      if [[ "${1:-}" =~ / ]]; then
        cat "${1}"
      else
        cat
      fi

      return 0
    fi

    # nb shows whole notes, so ts-cat's preview-pane truncation stays off.
    if [[ "${1:-}" =~ / ]]; then
      TS_CAT_MAX_LINES=0 ts-cat "${1}"
    else
      TS_CAT_MAX_LINES=0 ts-cat --ext "${1:-md}" -
    fi
  }
fi

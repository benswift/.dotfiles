[Unit]
Description=Mirror the key ANU GitLab repos for the offsite restic backup
Documentation=file:///home/ben/.dotfiles/bin/gitlab-mirror
OnFailure=unit-oncall@%n.service
OnSuccess=unit-oncall-clear@%n.service
RequiresMountsFor=/data

[Service]
Type=oneshot
ExecStartPre=/home/ben/.dotfiles/bin/wait-for-network
Environment=PATH=/home/ben/.dotfiles/bin:/home/ben/.local/share/mise/shims:/home/ben/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/ben/.dotfiles/bin/gitlab-mirror
TimeoutStartSec=1h
Nice=10
IOSchedulingClass=idle

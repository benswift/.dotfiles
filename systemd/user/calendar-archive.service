[Unit]
Description=Archive the ANU calendars' published feeds into the notebook
Documentation=file:///home/ben/.dotfiles/bin/calendar-archive
OnFailure=unit-oncall@%n.service
OnSuccess=unit-oncall-clear@%n.service

[Service]
Type=oneshot
ExecStartPre=/home/ben/.dotfiles/bin/wait-for-network
Environment=PATH=/home/ben/.dotfiles/bin:/home/ben/.local/share/mise/shims:/home/ben/.local/bin:/usr/local/bin:/usr/bin:/bin
# mise exec for the feed URLs, which live in the untracked mise env. nb-sync
# commits and pushes what this writes.
ExecStart=/usr/bin/env mise exec -- /home/ben/.dotfiles/bin/calendar-archive
TimeoutStartSec=15min

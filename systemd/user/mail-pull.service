[Unit]
Description=Pull every mail account into weddle's read-only mirror
Documentation=file:///home/ben/.dotfiles/mail/mbsyncrc-weddle
OnFailure=unit-oncall@%n.service
OnSuccess=unit-oncall-clear@%n.service
# Never into a bare mountpoint: an unmounted /data would look like five
# empty mailboxes.
RequiresMountsFor=/data

[Service]
Type=oneshot
ExecStartPre=/home/ben/.dotfiles/bin/wait-for-network
Environment=PATH=/home/ben/.dotfiles/bin:/home/ben/.local/share/mise/shims:/home/ben/.local/bin:/usr/local/bin:/usr/bin:/bin
# Ubuntu's XOAUTH2 SASL plugin prints four debug lines per login to stderr,
# about 5,000 a day, burying mbsync's own errors. sed rather than grep -v,
# which exits 1 if it filters everything; pipefail keeps mbsync's status.
ExecStart=/bin/bash -o pipefail -c 'mbsync -c /home/ben/.dotfiles/mail/mbsyncrc-weddle -a 2>&1 | sed -u "/^\\[SASL-XOAUTH2\\]/d"'
# Through mu-index.service rather than `mu index` here, so this and the
# anu-archive push from daysy (mu-index.path) never fight over mu's lock.
ExecStartPost=/usr/bin/systemctl --user start --no-block mu-index.service
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=30min

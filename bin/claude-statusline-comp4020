#!/usr/bin/env bash
# Claude Code status line for course repos that run on COMP4020 credits:
# the usual "<host> <dir> <branch>" line, plus the comp4020-statusline
# plugin's budget segment ("comp4020 $12.34/$500 (2%)").
#
# The plugin is installed at local scope in those repos
# (claude plugin install comp4020-statusline@comp4020 --scope local), so its
# SessionStart hook only syncs the script when a session starts there. This
# wrapper is needed only because settings.json already has a status line: the
# segment reads nothing from stdin (hence </dev/null), leaving the session JSON
# to claude-statusline, which consumes all of it.
#
# On a machine where the plugin was never installed the segment is simply
# absent, and the usual line stands.

set -uo pipefail

here="${BASH_SOURCE[0]%/*}"
line=$("$here/claude-statusline")

budget="$HOME/.claude/comp4020/statusline.sh"
if [[ -x "$budget" ]]; then
  segment=$("$budget" </dev/null)
  [[ -n "$segment" ]] && line+="  $segment"
fi

printf '%s' "$line"

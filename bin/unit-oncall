#!/usr/bin/env bash
# unit-oncall: turn a failed systemd user unit into a task in the anu vault.
#
# Scheduled jobs fail silently by default: the journal records it, but nothing
# reaches Ben unless he goes looking. This is the backchannel --- a failure
# files an open task in the anu vault (with the tail of the unit's journal),
# tagged bot and oncall with the unit in its `unit` field, and shares it, so it
# shows up wherever the vault does.
#
# Wired via a drop-in on the job's unit, so no job script knows about it:
#
#   [Unit]
#   OnFailure=unit-oncall@%n.service
#   OnSuccess=unit-oncall-clear@%n.service
#
# Usage: unit-oncall fail  <unit>   # file a task (deduped, see below)
#        unit-oncall clear <unit>   # the unit succeeded; re-arm and delete its tasks
#
# DEDUP: a unit that fails every 15 minutes must not write 96 times a day. The
# first failure files a task and drops a marker; later failures append to the
# marker instead. A marker older than REARM_HOURS writes again, so a failure
# that outlives a day re-pages rather than going quiet. A success clears it and
# deletes the open task: a recovered failure is machine output, which belongs
# in the journal and git history, not among Ben's tasks.
#
# Filing, paging and deleting are bin/oncall's, shared with launchd-run and the
# comp4020 sweeps: it appends to the unit's open task rather than filing a
# second, and caps pages across units. This script finds the failed run.

set -euo pipefail

STATE="${XDG_STATE_HOME:-$HOME/.local/state}/unit-oncall"
LOG="$STATE/unit-oncall.log"
JOURNAL_LINES="${JOURNAL_LINES:-40}"
REARM_HOURS="${REARM_HOURS:-24}"

mkdir -p "$STATE"

say() { printf '[%s] %s\n' "$(date -Is)" "$*" >>"$LOG"; }

usage() {
	echo "usage: unit-oncall (fail|clear) <unit>" >&2
	exit 2
}

[[ $# -eq 2 ]] || usage
action="$1"
unit="$2"
marker="$STATE/${unit}.failed"

case "$action" in
clear)
	if [[ -f "$marker" ]]; then
		rm -f "$marker"
		say "$unit: recovered; marker cleared"
	fi

	oncall clear "$unit"
	exit 0
	;;
fail) ;;
*) usage ;;
esac

# Marker still fresh? Record the repeat and stay quiet.
#
# Age comes from the first-failure line inside the marker, not the file's mtime:
# the repeat below appends, which bumps mtime, so an mtime-based age resets to
# zero on every failure and a unit failing more often than REARM_HOURS never
# re-arms. That is exactly the case the re-arm exists for --- a daily unit
# crossed 24h between firings and re-filed, while an hourly one stayed quiet
# under a single todo from its first failure. Fall back to mtime if the line is
# missing or unparseable: re-arming late beats dying in the OnFailure= handler.
if [[ -f "$marker" ]]; then
	first_ts="$(sed -n '1s/^first failure //p' "$marker")"
	first_s=""
	# Test for emptiness before parsing: `date -d ""` succeeds and yields
	# midnight today, which would read as a fresh marker and suppress the
	# re-arm --- the opposite of the fallback's intent.
	if [[ -n "$first_ts" ]]; then
		first_s="$(date -d "$first_ts" +%s 2>/dev/null || true)"
	fi
	if [[ -z "$first_s" ]]; then
		first_s="$(stat -c %Y "$marker")"
	fi
	age_h=$((($(date +%s) - first_s) / 3600))
	if [[ $age_h -lt $REARM_HOURS ]]; then
		printf 'repeat failure %s\n' "$(date -Is)" >>"$marker"
		say "$unit: repeat failure (${age_h}h since first, under ${REARM_HOURS}h re-arm); no new todo"
		exit 0
	fi
	say "$unit: still failing ${age_h}h on; re-arming"
fi

# Which run failed, and how. Neither `systemctl show` nor the MONITOR_* variables
# systemd hands an OnFailure= handler can say: both read the unit's live state
# when the handler starts, and a unit that restarts back to back (the publish
# generators) is already into its next run by then --- which is how a failure
# gets filed as "result=success, exit=0", quoting the next run's journal.
#
# The journal records the failed run itself: the manager's "Failed with result"
# line (MESSAGE_ID d9b373ed...) carries its invocation id and UNIT_RESULT, and
# the "Main process exited" line (98e32220...) for that id carries EXIT_STATUS.
# Only a failure from the last few minutes counts, so an old one is never
# mistaken for this one; journald can lag the handler slightly, hence the retry.
# With no such line (a manual `unit-oncall fail`), fall back to live state.
MSG_UNIT_FAILED=d9b373ed55a64feb8242e02dbe79a49c
MSG_PROCESS_EXIT=98e322203f7a4ed290d09fe03c09fe15

journal_field() { # <field> <match>...
	local field="$1"
	shift
	journalctl --user "$@" --since -10min -n 1 -o json --no-pager 2>/dev/null \
		| jq -r --arg f "$field" '.[$f] // empty' 2>/dev/null || true
}

failed_inv=""
result=""
status=""
for _ in 1 2 3 4 5; do
	failed_inv="$(journal_field USER_INVOCATION_ID "USER_UNIT=$unit" "MESSAGE_ID=$MSG_UNIT_FAILED")"
	[[ -n "$failed_inv" ]] && break
	sleep 1
done
if [[ -n "$failed_inv" ]]; then
	result="$(journal_field UNIT_RESULT "USER_INVOCATION_ID=$failed_inv" "MESSAGE_ID=$MSG_UNIT_FAILED")"
	status="$(journal_field EXIT_STATUS "USER_INVOCATION_ID=$failed_inv" "MESSAGE_ID=$MSG_PROCESS_EXIT")"
	# A run killed by a timeout or signal has no exit status to report.
	[[ -n "$status" ]] || status='?'
fi
[[ -n "$result" ]] || result="$(systemctl --user show -p Result --value "$unit" 2>/dev/null || echo unknown)"
[[ -n "$status" ]] || status="$(systemctl --user show -p ExecMainStatus --value "$unit" 2>/dev/null || echo '?')"

# Scope the body to the failed invocation too, or it quotes the next run's
# happy output and argues with its own title. The id alone identifies the run,
# so this does not want `-u` as well (that would OR the whole unit back in). The
# job's own output is tagged `_SYSTEMD_INVOCATION_ID`, the manager's lines about
# it `USER_INVOCATION_ID`, and `+` is journalctl's OR between match groups.
tail_out=""
if [[ -n "$failed_inv" ]]; then
	tail_out="$(journalctl --user \
		"_SYSTEMD_INVOCATION_ID=$failed_inv" \
		+ "USER_INVOCATION_ID=$failed_inv" \
		-n "$JOURNAL_LINES" --no-pager -o short-iso 2>/dev/null || true)"
fi
tail_label="failed run's journal"
if [[ -z "$tail_out" ]]; then
	tail_out="$(journalctl --user -u "$unit" -n "$JOURNAL_LINES" --no-pager -o short-iso 2>&1 || echo '(journal unavailable)')"
	tail_label="last $JOURNAL_LINES journal lines"
fi

title="$unit failed on weddle (result=$result, exit=$status) --- check the journal"
description="$(
	cat <<EOF
Filed automatically by unit-oncall at $(date -Is).

  systemctl --user status $unit
  journalctl --user -u $unit -n 200

The $tail_label:

$tail_out
EOF
)"

# Lead the page with what the job itself printed --- for the course heartbeat
# that is the STALE line naming the dead timer --- since systemd's own "Failed
# with result" gives nothing to act on from a phone. Drop systemd's own lines and
# journalctl's `-- Boot ... --` separators, then strip the `<ts> <host>
# <ident>[<pid>]: ` prefix, which is three space-free fields and only eats width
# on a phone.
own_output="$(
	printf '%s\n' "$tail_out" \
		| grep -vE 'systemd\[[0-9]+\]:|^-- ' \
		| sed 's/^[^ ]* [^ ]* [^ ]*: //' \
		| tail -3 || true
)"

if printf '%s\n' "$description" | oncall file -t oncall \
	-p "$(printf 'result=%s exit=%s\n%s' "$result" "$status" "$own_output")" \
	"$unit" "$title" >/dev/null; then
	printf 'first failure %s\n' "$(date -Is)" >"$marker"
	say "$unit: filed (see oncall.log)"
else
	say "$unit: FAILED to file a task --- the journal is the only record"
	exit 1
fi

#!/usr/bin/env bash
# unit-oncall: turn a failed systemd user unit into a pkb todo.
#
# Scheduled jobs fail silently by default: the journal records it, but nothing
# reaches Ben unless he goes looking. This is the backchannel --- a failure
# files an open todo in the notebook (with the tail of the unit's journal) and
# syncs, so it shows up wherever the notebook does.
#
# Wired via a drop-in on the job's unit, so no job script knows about it:
#
#   [Unit]
#   OnFailure=unit-oncall@%n.service
#   OnSuccess=unit-oncall-clear@%n.service
#
# Usage: unit-oncall fail  <unit>   # file a todo (deduped, see below)
#        unit-oncall clear <unit>   # the unit succeeded; re-arm
#
# DEDUP: a unit that fails every 15 minutes must not file 96 todos a day. The
# first failure files one and drops a marker; later failures append to the
# marker instead. A success clears it. A marker older than REARM_HOURS files a
# fresh todo anyway, so a failure that persists past a ticked-off todo does not
# go quiet.
#
# A todo also sends a Pushover page, so a failure reaches a phone rather than
# waiting for the notebook to be opened. The page sits inside the dedup above,
# so it inherits it: one page per todo, not one per failure.
#
# BURST: that marker only debounces a single unit, and whole families fail
# together --- one crit sweep per group, six at a time. So the pages are capped
# across units as well: PUSH_CAP per PUSH_WINDOW_MIN, then one page saying how
# many more are failing, then silence for the rest of the window. Every failure
# still files its own todo; only the paging is capped, so nothing is lost --- the
# notebook stays the record and the page is only the nudge towards it.

set -euo pipefail

STATE="${XDG_STATE_HOME:-$HOME/.local/state}/unit-oncall"
LOG="$STATE/unit-oncall.log"
LOCK="$STATE/nb.lock"
WINDOW="$STATE/push-window"
JOURNAL_LINES="${JOURNAL_LINES:-40}"
REARM_HOURS="${REARM_HOURS:-24}"
PUSH_CAP="${PUSH_CAP:-3}"
PUSH_WINDOW_MIN="${PUSH_WINDOW_MIN:-15}"

mkdir -p "$STATE"

say() { printf '[%s] %s\n' "$(date -Is)" "$*" >>"$LOG"; }

# This page's number within the current burst window, resetting a stale one.
# Called under the flock below, so concurrent handlers cannot both read the same
# count. A malformed or missing file starts a fresh window rather than failing:
# losing a window is a worse outcome than losing the cap for one burst.
push_seq() {
	local now start count
	now="$(date +%s)"
	start=0
	count=0
	if [[ -f "$WINDOW" ]]; then
		read -r start count <"$WINDOW" || true
		[[ "$start" =~ ^[0-9]+$ ]] || start=0
		[[ "$count" =~ ^[0-9]+$ ]] || count=0
	fi
	if ((now - start >= PUSH_WINDOW_MIN * 60)); then
		start="$now"
		count=0
	fi
	count=$((count + 1))
	printf '%s %s\n' "$start" "$count" >"$WINDOW"
	printf '%s' "$count"
}

# Best effort by construction: a Pushover outage must not turn a job's failure
# into a failed OnFailure= handler, so every path here logs and returns 0. The
# todo is already on disk by the time this runs.
#
# `mise exec` supplies PUSHOVER_TOKEN/PUSHOVER_USER_KEY from the untracked
# [env] block in ~/.config/mise/config.local.toml --- the unit gives this script
# an explicit PATH and no other environment, and the credentials must not be
# written into a unit file to get here.
page() {
	local title="$1" body="$2"
	if printf '%s' "$body" \
		| mise exec -- notify-pushover --title "$title" >/dev/null 2>>"$LOG"; then
		return 0
	fi
	say "pushover failed for '$title' --- the todo is still filed"
	return 0
}

usage() {
	echo "usage: unit-oncall (fail|clear) <unit>" >&2
	exit 2
}

[[ $# -eq 2 ]] || usage
action="$1"
unit="$2"
marker="$STATE/${unit}.failed"

case "$action" in
clear)
	if [[ -f "$marker" ]]; then
		rm -f "$marker"
		say "$unit: recovered; marker cleared"
	fi
	exit 0
	;;
fail) ;;
*) usage ;;
esac

# Marker still fresh? Record the repeat and stay quiet.
if [[ -f "$marker" ]]; then
	age_h=$(((($(date +%s) - $(stat -c %Y "$marker")) / 3600)))
	if [[ $age_h -lt $REARM_HOURS ]]; then
		printf 'repeat failure %s\n' "$(date -Is)" >>"$marker"
		say "$unit: repeat failure (${age_h}h since first, under ${REARM_HOURS}h re-arm); no new todo"
		exit 0
	fi
	say "$unit: still failing ${age_h}h on; re-arming"
fi

result="$(systemctl --user show -p Result --value "$unit" 2>/dev/null || echo unknown)"
status="$(systemctl --user show -p ExecMainStatus --value "$unit" 2>/dev/null || echo '?')"
tail_out="$(journalctl --user -u "$unit" -n "$JOURNAL_LINES" --no-pager -o short-iso 2>&1 || echo '(journal unavailable)')"

title="$unit failed on weddle (result=$result, exit=$status) --- check the journal"
description="$(
	cat <<EOF
Filed automatically by unit-oncall at $(date -Is).

  systemctl --user status $unit
  journalctl --user -u $unit -n 200

Last $JOURNAL_LINES journal lines:

$tail_out
EOF
)"

# nb writes to a git working tree, and pkb-agent and the daily sync touch the
# same one. Serialise so a concurrent handler cannot land mid-commit.
exec 9>"$LOCK"
flock 9

if nb todo add "$title" --description "$description" --tags oncall >/dev/null 2>>"$LOG"; then
	printf 'first failure %s\n' "$(date -Is)" >"$marker"
	say "$unit: filed a todo"
else
	say "$unit: FAILED to file a todo --- the journal is the only record"
	exit 1
fi

# Page before `nb sync`, which reaches the network and can be slow: the phone
# should buzz as soon as the todo is on disk, not after a remote round trip.
#
# Lead with what the job itself printed --- for the course heartbeat that is the
# STALE line naming the dead timer --- since systemd's own "Failed with result"
# gives nothing to act on from a phone. Drop systemd's own lines and journalctl's
# `-- Boot ... --` separators, then strip the `<ts> <host> <ident>[<pid>]: `
# prefix, which is three space-free fields and only eats width on a phone.
own_output="$(
	printf '%s\n' "$tail_out" \
		| grep -vE 'systemd\[[0-9]+\]:|^-- ' \
		| sed 's/^[^ ]* [^ ]* [^ ]*: //' \
		| tail -3 || true
)"
page_n="$(push_seq)"
if ((page_n <= PUSH_CAP)); then
	page "oncall: $unit" "$(printf 'result=%s exit=%s\n%s' "$result" "$status" "$own_output")"
	say "$unit: paged ($page_n/$PUSH_CAP this ${PUSH_WINDOW_MIN}m window)"
elif ((page_n == PUSH_CAP + 1)); then
	page "oncall: burst on weddle" \
		"More than $PUSH_CAP units failing within ${PUSH_WINDOW_MIN}m; pages suppressed for the rest of the window. Todos are still being filed --- nb todos open --tags oncall"
	say "$unit: paged the burst summary; further pages suppressed this window"
else
	say "$unit: page suppressed (burst, page $page_n this ${PUSH_WINDOW_MIN}m window)"
fi

# Best effort: the todo is already on disk, and the 00:00 `nb sync --all`
# will carry it if this one cannot (offline, remote unreachable).
if nb sync >/dev/null 2>>"$LOG"; then
	say "$unit: synced"
else
	say "$unit: nb sync failed --- todo is local until the next sync"
fi

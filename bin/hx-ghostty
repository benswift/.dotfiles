#!/usr/bin/env bash
# hx-ghostty --- open files in helix, in a tab of the running Ghostty, and be
# the macOS handler that sends double-clicked documents there.
#
#   hx-ghostty FILE...       open FILEs in helix in a new Ghostty tab (a new
#                            window if Ghostty isn't running yet)
#   hx-ghostty --register    build the LaunchServices handler and make it the
#                            default app for every type listed below, so
#                            Finder and `open` stop routing text at Xcode,
#                            VLC, GarageBand and friends
#   hx-ghostty --unregister  remove the handler app again
#
# The tab is created through Ghostty's AppleScript dictionary (1.3+, see
# Ghostty.app/Contents/Resources/Ghostty.sdef): `ghostty +new-window` refuses
# to run on macOS. Note `new tab` needs an explicit `in <window>` --- without
# it Ghostty answers errAEEventNotHandled. The tab closes when helix exits,
# the same as a shell tab would.
#
# macOS hands documents to an .app, never to a script, so --register compiles
# a tiny AppleScript applet into ~/Applications whose `on open` handler calls
# this script. It is ad-hoc signed so TCC keys the Automation permission
# ("Open in Helix" controlling Ghostty, granted once on first open) to a stable
# identity rather than re-prompting.
set -euo pipefail

SELF="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"

APP_NAME="Open in Helix"
APP="$HOME/Applications/$APP_NAME.app"
BUNDLE_ID="me.benswift.open-in-helix"
LSREGISTER="/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister"

# Types the handler claims, in two halves.
#
# HANDLED_UTIS are the types macOS already knows, each of which had a default
# that was an accident of what installed last rather than a choice: markdown
# and most source files to Xcode, `.ts` to VLC (it is also the extension for
# an MPEG transport stream), `.exs` to GarageBand (a Logic sampler
# instrument), `.toml` to Kontakt.
#
# Deliberately absent: `public.html` (Safari renders it), and the binary
# formats `com.apple.property-list` and `com.apple.applescript.script`, which
# helix would show as mojibake.
HANDLED_UTIS=(
    net.daringfireball.markdown
    public.plain-text
    public.source-code
    public.script
    public.json
    public.yaml
    public.toml
    public.xml
    public.css
    public.svg-image
    public.comma-separated-values-text
    public.tab-separated-values-text
    com.netscape.javascript-source
    com.microsoft.typescript
    public.mpeg-2-transport-stream
    public.python-script
    public.ruby-script
    public.perl-script
    public.php-script
    public.shell-script
    public.bash-script
    public.zsh-script
    public.csh-script
    public.c-source
    public.c-header
    public.c-plus-plus-source
    public.c-plus-plus-header
    public.objective-c-source
    public.objective-c-plus-plus-source
    public.swift-source
    com.sun.java-source
    public.make-source
    org.iso.sql
    public.patch-file
    com.apple.log
    com.microsoft.ini
    com.apple.logic.exs
    com.apple.rez-source
    com.apple.applescript.text
)

# The other half have no UTI at all: macOS invents a per-extension `dyn.*`
# type, which cannot be claimed. So the applet exports one type of its own
# covering the lot --- being the only declaration, it becomes the system's
# answer for these extensions, and duti then has something to point at.
OWN_UTI="me.benswift.plain-text-source"
CLAIMED_EXTENSIONS=(
    mdx svx qmd rmd rst org
    typ tex sty cls bib
    kdl conf env fish jsonc json5 lock properties
    ex eex heex erl el clj cljs edn
    rs go lua jsx hs zig nix vim
    astro svelte vue scss sass less
    ipynb
)

usage() {
    sed -n '3,/^$/p' "$SELF" | sed 's/^# \{0,1\}//' >&2
    exit 2
}

# helix is a source build in ~/.local/bin (see bin/helix-build), which is not
# on the stub PATH `do shell script` hands the applet.
hx_bin() {
    if [[ -x "$HOME/.local/bin/hx" ]]; then
        echo "$HOME/.local/bin/hx"
    elif command -v hx >/dev/null 2>&1; then
        command -v hx
    else
        echo "hx-ghostty: no hx found --- run helix-build" >&2
        exit 1
    fi
}

# Ghostty runs a command with arguments through `/bin/sh -c`, so the command
# string is shell syntax and the paths in it need shell quoting.
shq() {
    local s=${1//\'/\'\\\'\'}
    printf "'%s'" "$s"
}

# ... and the command string then goes inside an AppleScript literal.
as_string() {
    local s=${1//\\/\\\\}
    s=${s//\"/\\\"}
    printf '"%s"' "$s"
}

# A JSON array literal, for the plutil -json calls in register().
json_array() {
    local out="" item
    for item in "$@"; do out="${out:+$out, }\"$item\""; done
    printf '[%s]' "$out"
}

abspath() { printf '%s\n' "$(cd "$(dirname "$1")" && pwd -P)/$(basename "$1")"; }

open_files() {
    local hx file paths=() cmd dir
    hx="$(hx_bin)"
    for file in "$@"; do paths+=("$(abspath "$file")"); done
    dir="$(dirname "${paths[0]}")"

    # `application "X" is running` rather than pgrep: the executable inside
    # Ghostty.app is lowercase `ghostty`, and unlike a `tell` block this query
    # does not launch the app.
    if [[ "$(osascript -e 'application "Ghostty" is running')" != "true" ]]; then
        # Let the launch itself run helix: opening a tab afterwards would
        # leave the window Ghostty starts with sitting there as a stray shell.
        open -na Ghostty.app --args -e "$hx" "${paths[@]}"
        return
    fi

    cmd="$(shq "$hx")"
    for file in "${paths[@]}"; do cmd="$cmd $(shq "$file")"; done

    osascript <<EOF >/dev/null
tell application "Ghostty"
  set cfg to new surface configuration from {command:$(as_string "$cmd"), initial working directory:$(as_string "$dir")}
  if (count of windows) is 0 then
    new window with configuration cfg
  else
    new tab in front window with configuration cfg
  end if
  activate
end tell
EOF
}

register() {
    command -v duti >/dev/null 2>&1 || {
        echo "hx-ghostty: duti is required (brew install duti)" >&2
        exit 1
    }

    local work
    work="$(mktemp -d)"
    cat >"$work/applet.applescript" <<EOF
on open theFiles
  set args to ""
  repeat with f in theFiles
    set args to args & " " & quoted form of POSIX path of f
  end repeat
  do shell script "$SELF" & args
end open

-- Launched with no document (from Spotlight, say): nothing to edit, so just
-- bring the terminal up.
on run
  do shell script "/usr/bin/open -a Ghostty"
end run
EOF

    mkdir -p "$(dirname "$APP")"
    rm -rf "$APP"
    osacompile -o "$APP" "$work/applet.applescript"
    rm -rf "$work"

    local plist="$APP/Contents/Info.plist"
    plutil -replace CFBundleIdentifier -string "$BUNDLE_ID" "$plist"
    plutil -replace CFBundleName -string "$APP_NAME" "$plist"
    # No dock icon or menu bar: this app exists only to forward an odoc event.
    plutil -replace LSUIElement -bool true "$plist"
    plutil -replace CFBundleDocumentTypes -json "[
        {
            \"CFBundleTypeName\": \"Text file\",
            \"CFBundleTypeRole\": \"Editor\",
            \"LSHandlerRank\": \"Owner\",
            \"LSItemContentTypes\": $(json_array "${HANDLED_UTIS[@]}")
        },
        {
            \"CFBundleTypeName\": \"Plain-text source file\",
            \"CFBundleTypeRole\": \"Editor\",
            \"LSHandlerRank\": \"Owner\",
            \"LSItemContentTypes\": [\"$OWN_UTI\"],
            \"CFBundleTypeExtensions\": $(json_array "${CLAIMED_EXTENSIONS[@]}")
        }
    ]" "$plist"

    # Claiming the extensions above also means declaring what they are. The
    # extension list here is what makes LaunchServices resolve them to this
    # type instead of a dyn.* one.
    plutil -replace UTExportedTypeDeclarations -json "[{
        \"UTTypeIdentifier\": \"$OWN_UTI\",
        \"UTTypeDescription\": \"Plain-text source file\",
        \"UTTypeConformsTo\": [\"public.plain-text\"],
        \"UTTypeTagSpecification\": {
            \"public.filename-extension\": $(json_array "${CLAIMED_EXTENSIONS[@]}")
        }
    }]" "$plist"

    codesign --force --sign - "$APP" >/dev/null 2>&1 ||
        echo "hx-ghostty: could not ad-hoc sign $APP (TCC may re-prompt)" >&2
    "$LSREGISTER" -f "$APP"

    # lsregister returns before the claim is visible, and a duti -s that
    # lands in that gap exits 0 having changed nothing --- so set, verify,
    # and retry rather than trusting the exit status. `duti -d` is the query
    # that takes a UTI; `duti -x` parses its argument as a filename extension.
    local uti tries failed=()
    sleep 1
    for uti in "${HANDLED_UTIS[@]}" "$OWN_UTI"; do
        tries=0
        while ((tries++ < 5)); do
            duti -s "$BUNDLE_ID" "$uti" all
            [[ "$(duti -d "$uti" 2>/dev/null)" == "$BUNDLE_ID" ]] && break
            sleep 1
        done
        [[ "$(duti -d "$uti" 2>/dev/null)" == "$BUNDLE_ID" ]] || failed+=("$uti")
    done

    if ((${#failed[@]})); then
        echo "hx-ghostty: could not claim: ${failed[*]}" >&2
    fi
    echo "hx-ghostty: claiming $((${#HANDLED_UTIS[@]} + 1 - ${#failed[@]})) types" \
        "and ${#CLAIMED_EXTENSIONS[@]} extensions"
}

unregister() {
    [[ -d "$APP" ]] || {
        echo "hx-ghostty: no handler installed at $APP"
        return
    }
    "$LSREGISTER" -u "$APP" || true
    rm -rf "$APP"
    echo "hx-ghostty: removed $APP --- every type it claimed falls back to"
    echo "            the next claimant (Xcode, mostly). Set one by hand with:"
    echo "            duti -s <bundle id> <uti> all"
}

[[ $# -ge 1 ]] || usage
case "$1" in
--register) register ;;
--unregister) unregister ;;
-h | --help) usage ;;
-*) usage ;;
*) open_files "$@" ;;
esac

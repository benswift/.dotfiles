#!/usr/bin/env bash
#
# Copy weddle's mirror of the LX convenor mailbox to watson as a read-only
# Maildir at ~/wiz-mail/lxconvenor, outside the wiz clone (wiz decision-4).
# systemd/user/wiz-mail.path runs it after each Maildir push from daysy.
#
# Only that one mailbox goes to watson. The copy is made writable for the
# sync and read-only again afterwards: a guard against an agent editing the
# archive by mistake, not a security boundary (it is still Ben's account).

set -euo pipefail

SRC="$HOME/Maildir/lxconvenor/"
DEST="wiz-mail/lxconvenor"

if [[ ! -d "$SRC" ]]; then
	echo "wiz-mail-copy: $SRC missing on weddle" >&2
	exit 1
fi

ssh -o BatchMode=yes watson "mkdir -p $DEST && chmod -R u+w $DEST"
rsync -a --delete --exclude .DS_Store --exclude '.mbsyncstate*' --exclude .uidvalidity \
	"$SRC" "watson:$DEST/"
ssh -o BatchMode=yes watson "chmod -R a-w $DEST"

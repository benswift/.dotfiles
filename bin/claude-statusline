#!/usr/bin/env bash
# Claude Code status line: prints "<host> <HH:MM> <dir> <branch>" with colours
# matching the zsh prompt (the terminal's ANSI palette). Reads the session
# JSON from stdin --- Claude Code passes session info this way.

set -euo pipefail

input=$(cat)
cwd=$(jq -r '.workspace.current_dir // .cwd // ""' <<<"$input")

# Shorten cwd to "~" for $HOME or the basename otherwise (zsh's %1~).
if [[ "$cwd" == "$HOME" ]]; then
  short_cwd="~"
elif [[ -n "$cwd" ]]; then
  short_cwd="${cwd##*/}"
else
  short_cwd=""
fi

branch=""
[[ -n "$cwd" && -d "$cwd" ]] && branch=$(git -C "$cwd" branch --show-current 2>/dev/null || true)

# Host badge, black on the host colour --- mirrors the case statement in zshrc.
host=$(hostname -s)
case "$host" in
  daysy)       host_color=$'\e[1;30;43m' ;;   # yellow
  weddle)      host_color=$'\e[1;30;42m' ;;   # green
  cybersonic)  host_color=$'\e[1;30;45m' ;;   # magenta
  jetson-orin) host_color=$'\e[1;30;46m' ;;   # cyan
  strproxy)    host_color=$'\e[1;30;101m' ;;  # bright red
  *)           host_color=$'\e[1;30;101m' ;;  # bright red
esac

reset=$'\e[0m'
dir_color=$'\e[1;34m'  # blue
vcs_color=$'\e[1;35m'  # magenta

out=""
out+="${host_color} ${host} ${reset} "
out+="$(date +%H:%M) "
[[ -n "$short_cwd" ]] && out+="${dir_color}${short_cwd}${reset}"
[[ -n "$branch" ]] && out+=" ${vcs_color}${branch}${reset}"

printf '%s' "$out"

#!/usr/bin/env bash
# Compile a set list of chord charts into one PDF, named for next Sunday, and
# open it.
#
#   church-chart [song[:key]]...
#
# Songs come from the chord-charts repo ($CHORD_CHARTS, default
# ~/projects/chord-charts) and are typeset fresh by its bin/opc, each in its
# own key or the one given (10000-reasons:E). With no songs named, pick them
# with fzf (ESC when done), giving each a key or Enter for its own.
set -euo pipefail

repo=${CHORD_CHARTS:-$HOME/projects/chord-charts}
[ -x "$repo/bin/opc" ] || { echo "church-chart: no chord-charts repo at $repo" >&2; exit 1; }
command -v pdfunite >/dev/null || { echo "church-chart: needs pdfunite (poppler)" >&2; exit 1; }

# a header field of a song: field name song
field() { sed -n "/^\$/q; s/^$1: *//p" "$repo/songs/$2.opc"; }

next_sunday() {
  local days=$(((7 - $(date +%u)) % 7))
  if [ "$(uname)" = Darwin ]; then date -v+"${days}d" +%F; else date -d "+$days days" +%F; fi
}

picks=("$@")
if [ ${#picks[@]} -eq 0 ]; then
  command -v fzf >/dev/null || { echo "church-chart: needs fzf to pick songs" >&2; exit 1; }
  # song <tab> title (key) song, read from each song's header in one pass
  menu=$(awk '
    FNR == 1 { song = FILENAME; sub(/.*\//, "", song); sub(/\.opc$/, "", song); title = key = "" }
    /^title:/ { title = $0; sub(/^title: */, "", title) }
    /^key:/ { key = $2 }
    /^$/ { printf "%s\t%s  (%s)  \033[2m%s\033[0m\n", song, title, key, song; nextfile }
  ' "$repo"/songs/*.opc | sort -t$'\t' -k2)
  while song=$(fzf --prompt="Song $((${#picks[@]} + 1)) (ESC when done): " --height=40% \
    --ansi --delimiter=$'\t' --with-nth=2 <<<"$menu" | cut -f1); do
    own=$(field key "$song" | awk '{print $1}')
    read -r -p "Key for $(field title "$song") [$own]: " key </dev/tty
    picks+=("$song${key:+:$key}")
  done
fi
[ ${#picks[@]} -gt 0 ] || { echo "No songs picked"; exit 0; }

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
charts=()
for i in "${!picks[@]}"; do
  song=${picks[$i]%%:*}
  key=${picks[$i]#"$song"}
  out=$tmp/$i.pdf
  "$repo/bin/opc" -q ${key:+-k "${key#:}"} -o "$out" "$song" >/dev/null
  charts+=("$out")
done

set_list=/tmp/$(next_sunday).pdf
pdfunite "${charts[@]}" "$set_list"
echo "Set list: $set_list"
if [ "$(uname)" = Darwin ]; then
  open "$set_list"
elif [ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ] && command -v xdg-open >/dev/null; then
  xdg-open "$set_list"
fi

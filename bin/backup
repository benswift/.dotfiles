#!/usr/bin/env bash

set -euo pipefail

# Configuration. The remote base is per-host: weddle:backup/ holds one
# directory per machine, and a hardcoded default would let one machine's
# `rclone sync` (which deletes) silently mirror over another's backup.
REMOTE="${RCLONE_REMOTE:-weddle}"
REMOTE_BASE="${RCLONE_REMOTE_BASE:-backup/$(hostname -s)}"
DRY_RUN="${DRY_RUN:-false}"
FORCE=false
# Sections named on the command line, space-separated; empty means all three.
SECTIONS=""

# Exclude patterns for build artifacts and regeneratable content
EXCLUDES=(
  ".git/**"
  "node_modules/**"
  ".venv/**"
  "venv/**"
  "_build/**"
  "deps/**"
  ".elixir_ls/**"
  ".expert/**"
  ".tox/**"
  "target/**"
  "build/**"
  "llvm/**"
  "__pycache__/**"
  ".pytest_cache/**"
  "*.egg-info/**"
  ".DS_Store"
  ".cache/**"
  "CLAUDE.md"
  "codex.md"
)

usage() {
  cat <<EOF
Usage: $(basename "$0") [OPTIONS] [SECTION...]

Sync ~/Documents, ~/Zotero and ~/Maildir/anu-archive to remote storage using
rclone. The hourly push-to-weddle launchd job runs this. The rest of weddle's
Maildir comes from the servers (mail/mbsyncrc-weddle), not from here.

Sections: documents, zotero, mail. With none named, all three are synced.
Naming one is a deliberate act, so it runs even on a metered network:
\`$(basename "$0") mail\` pushes just the mail from a tethered phone.

Options:
  -n, --dry-run    Show what would be transferred without making changes
  -r, --remote     Set remote name (default: weddle)
  -f, --force      Run everything even on a metered network (tethered phone)
  -h, --help       Show this help message

Environment variables:
  RCLONE_REMOTE       Remote name (default: weddle)
  RCLONE_REMOTE_BASE  Remote base path (default: backup/<hostname>)
  DRY_RUN             Set to 'true' for dry run mode
EOF
}

# Parse command-line arguments
while [[ $# -gt 0 ]]; do
  case "$1" in
    -n|--dry-run)
      DRY_RUN=true
      shift
      ;;
    -f|--force)
      FORCE=true
      shift
      ;;
    -r|--remote)
      REMOTE="$2"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    documents|zotero|mail)
      SECTIONS+=" $1"
      shift
      ;;
    *)
      echo "Unknown option or section: $1"
      usage
      exit 1
      ;;
  esac
done

# weddle is the backup destination, not a source: it has no ~/Documents or
# ~/Maildir worth pushing, and `rclone sync` to a remote pointing back at this
# host would happily empty the target. Checked after argument parsing so
# `--help` still works here.
if [[ "$(hostname -s)" == "weddle" ]]; then
  echo "backup: weddle is the backup destination --- run this from a laptop/desktop instead." >&2
  exit 1
fi

# Tens of GB to list and whatever changed to push: never on a tethered phone's
# data. Exits 0, so the hourly launchd run records a skip, not a failure.
# Only the bare run is guarded: nothing unattended names a section, so one
# that does was typed by someone who knows what network they are on.
if [[ "$FORCE" != "true" && -z "$SECTIONS" ]] && "$(dirname "$0")/on-metered-network"; then
  echo "backup: on a metered network --- skipping (--force to run anyway)." >&2
  exit 0
fi

# `rclone sync` makes the remote an exact mirror, so a file deleted or
# corrupted here is gone from weddle at the next run. History lives in weddle's
# hourly restic snapshots (bin/restic-backup), not here.

# An attached disk image is a live filesystem, so copying its backing file can
# capture a torn write (the vault sparseimage is the one that matters). Leave
# any image attached from under $1 out of this run: sync never deletes excluded
# files at the destination, so weddle keeps the last copy taken while ejected.
# Emits rclone filter args one per line. hdiutil and plutil live in /usr/bin,
# so this needs nothing from a launchd job's PATH.
attached_image_excludes() {
  local root="$1" plist image rel i=0
  plist="$(hdiutil info -plist)"
  while image="$(plutil -extract "images.$i.image-path" raw -o - - <<<"$plist" 2>/dev/null)"; do
    i=$((i + 1))
    [[ "$image" == "$root/"* ]] || continue
    # sed, not ${//}: escaping needs the matched character back, and & in a
    # parameter substitution is bash 5.2+ only.
    # shellcheck disable=SC2001
    rel="$(sed 's/[][*?{}\\]/\\&/g' <<<"${image#"$root"}")"
    echo "Skipping attached disk image (eject it to back it up): $image" >&2
    printf '%s\n' --exclude "$rel" --exclude "$rel/**"
  done
}

wants() { [[ -z "$SECTIONS" || " $SECTIONS " == *" $1 "* ]]; }

# Build exclude arguments for Documents
EXCLUDE_ARGS=()
for pattern in "${EXCLUDES[@]}"; do
  EXCLUDE_ARGS+=(--exclude "$pattern")
done

# Directory mtimes on the mirror are never read, and setting them is a write
# per directory per run (and a log line each under -v).
BASE_ARGS=(sync --no-update-dir-modtime)
# --progress redraws twice a second, which in a log file is thousands of lines
# per long run. Off a terminal, log each transfer and one summary line instead.
if [[ -t 1 ]]; then
  BASE_ARGS+=(--progress)
else
  BASE_ARGS+=(-v --stats-one-line)
fi
if [[ "$DRY_RUN" == "true" ]]; then
  BASE_ARGS+=(--dry-run)
  echo "DRY RUN MODE - no changes will be made"
fi

# Only anu-archive: it is local-only (mail ANU's retention expunged from the
# server), so the servers can't supply it. Everything else in weddle's Maildir
# is mbsync's, and an rclone sync of the whole tree would wipe its state.
if wants mail; then
  echo "=== Maildir/anu-archive ==="
  echo "Syncing $HOME/Maildir/anu-archive to $REMOTE:Maildir/anu-archive"
  echo
  rclone "${BASE_ARGS[@]}" --exclude ".DS_Store" \
    "$HOME/Maildir/anu-archive" "$REMOTE:Maildir/anu-archive"
  # weddle's mu-index.path watches this to re-index the mirror. Separate from
  # .last-push below, which must only vouch for a full run.
  if [[ "$DRY_RUN" != "true" ]]; then
    rclone rcat "$REMOTE:$REMOTE_BASE/.last-mail-push" <<<"$(date +%s)"
  fi
  echo
fi

if wants documents; then
  echo "=== Documents ==="
  echo "Syncing $HOME/Documents to $REMOTE:$REMOTE_BASE/Documents"
  echo "Excluding: ${EXCLUDES[*]}"
  echo
  while IFS= read -r arg; do
    EXCLUDE_ARGS+=("$arg")
  done < <(attached_image_excludes "$HOME/Documents")
  rclone "${BASE_ARGS[@]}" "${EXCLUDE_ARGS[@]}" \
    "$HOME/Documents" "$REMOTE:$REMOTE_BASE/Documents"
  echo
fi

if wants zotero; then
  echo "=== Zotero ==="
  echo "Syncing $HOME/Zotero to $REMOTE:$REMOTE_BASE/Zotero"
  echo
  rclone "${BASE_ARGS[@]}" --exclude ".DS_Store" \
    "$HOME/Zotero" "$REMOTE:$REMOTE_BASE/Zotero"
  echo
fi

if [[ "$DRY_RUN" != "true" ]] && wants documents && wants zotero && wants mail; then
  # weddle's restic-backup fails when this goes stale: a skipped run exits 0
  # here, so a laptop that stops pushing is only visible from the far end.
  # Stamped only when everything was pushed, or a run of mail-only syncs would
  # vouch for a Documents mirror that has not moved.
  rclone rcat "$REMOTE:$REMOTE_BASE/.last-push" <<<"$(date +%s)"
fi

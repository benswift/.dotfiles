#!/usr/bin/env bash

set -euo pipefail

# Configuration. The remote base is per-host: weddle:backup/ holds one
# directory per machine, and a hardcoded default would let one machine's
# `rclone sync` (which deletes) silently mirror over another's backup.
REMOTE="${RCLONE_REMOTE:-weddle}"
REMOTE_BASE="${RCLONE_REMOTE_BASE:-backup/$(hostname -s)}"
DRY_RUN="${DRY_RUN:-false}"
MAILDIR_ONLY=false
DOCUMENTS_ONLY=false
FORCE=false

# Exclude patterns for build artifacts and regeneratable content
EXCLUDES=(
  ".git/**"
  "node_modules/**"
  ".venv/**"
  "venv/**"
  "_build/**"
  "deps/**"
  ".elixir_ls/**"
  ".expert/**"
  ".tox/**"
  "target/**"
  "build/**"
  "llvm/**"
  "__pycache__/**"
  ".pytest_cache/**"
  "*.egg-info/**"
  ".DS_Store"
  ".cache/**"
  "CLAUDE.md"
  "codex.md"
)

usage() {
  cat <<EOF
Usage: $(basename "$0") [OPTIONS]

Sync ~/Documents and ~/Maildir to remote storage using rclone.

Options:
  -n, --dry-run    Show what would be transferred without making changes
  -m, --maildir    Sync only ~/Maildir (the hourly launchd job on daysy, so
                   weddle's read-only mirror stays fresh for pkb-triage)
  -d, --documents  Sync only ~/Documents (the scheduled launchd job, kept
                   apart from -m so the two can never sync Maildir at once)
  -r, --remote     Set remote name (default: weddle)
  -f, --force      Run even on a metered network (tethered phone)
  -h, --help       Show this help message

Environment variables:
  RCLONE_REMOTE       Remote name (default: weddle)
  RCLONE_REMOTE_BASE  Remote base path (default: backup/<hostname>)
  DRY_RUN             Set to 'true' for dry run mode
EOF
}

# Parse command-line arguments
while [[ $# -gt 0 ]]; do
  case "$1" in
    -n|--dry-run)
      DRY_RUN=true
      shift
      ;;
    -m|--maildir)
      MAILDIR_ONLY=true
      shift
      ;;
    -d|--documents)
      DOCUMENTS_ONLY=true
      shift
      ;;
    -f|--force)
      FORCE=true
      shift
      ;;
    -r|--remote)
      REMOTE="$2"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown option: $1"
      usage
      exit 1
      ;;
  esac
done

if [[ "$MAILDIR_ONLY" == "true" && "$DOCUMENTS_ONLY" == "true" ]]; then
  echo "backup: --maildir and --documents are exclusive; pass neither to sync both." >&2
  exit 1
fi

# weddle is the backup destination, not a source: it has no ~/Documents or
# ~/Maildir worth pushing, and `rclone sync` to a remote pointing back at this
# host would happily empty the target. Checked after argument parsing so
# `--help` still works here.
if [[ "$(hostname -s)" == "weddle" ]]; then
  echo "backup: weddle is the backup destination --- run this from a laptop/desktop instead." >&2
  exit 1
fi

# Tens of GB to list and whatever changed to push: never on a tethered phone's
# data. Exits 0, so the hourly launchd run records a skip, not a failure.
if [[ "$FORCE" != "true" ]] && "$(dirname "$0")/on-metered-network"; then
  echo "backup: on a metered network --- skipping (--force to run anyway)." >&2
  exit 0
fi

# `rclone sync` makes the remote a mirror, so a file deleted or corrupted here
# is deleted or corrupted on weddle at the next run. --backup-dir turns each
# of those destructive operations into a server-side move: whatever a run would
# overwrite or delete lands under versions/<run>/ instead. The mirror stays an
# exact mirror, and nothing it discards is lost for RETENTION_DAYS.
RUN_STAMP="$(date +%Y-%m-%dT%H%M%S)"
VERSIONS="$REMOTE_BASE/versions"
RETENTION_DAYS=90

# Prune on the run stamp in the directory name, never with --min-age: a
# displaced file keeps its original modtime, so an age filter would delete a
# years-old document the moment it was displaced.
prune_versions() {
  local cutoff dir
  cutoff="$(date -v-"${RETENTION_DAYS}"d +%Y-%m-%dT%H%M%S 2>/dev/null ||
    date -d "$RETENTION_DAYS days ago" +%Y-%m-%dT%H%M%S)"
  rclone lsf --dirs-only "$REMOTE:$VERSIONS" 2>/dev/null | while IFS= read -r dir; do
    dir="${dir%/}"
    [[ "$dir" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{6}$ && "$dir" < "$cutoff" ]] || continue
    echo "Pruning $REMOTE:$VERSIONS/$dir"
    rclone purge "$REMOTE:$VERSIONS/$dir"
  done
}

# An attached disk image is a live filesystem, so copying its backing file can
# capture a torn write (the vault sparseimage is the one that matters). Leave
# any image attached from under $1 out of this run: sync never deletes excluded
# files at the destination, so weddle keeps the last copy taken while ejected.
# Emits rclone filter args one per line. hdiutil and plutil live in /usr/bin,
# so this needs nothing from a launchd job's PATH.
attached_image_excludes() {
  local root="$1" plist image rel i=0
  plist="$(hdiutil info -plist)"
  while image="$(plutil -extract "images.$i.image-path" raw -o - - <<<"$plist" 2>/dev/null)"; do
    i=$((i + 1))
    [[ "$image" == "$root/"* ]] || continue
    # sed, not ${//}: escaping needs the matched character back, and & in a
    # parameter substitution is bash 5.2+ only.
    # shellcheck disable=SC2001
    rel="$(sed 's/[][*?{}\\]/\\&/g' <<<"${image#"$root"}")"
    echo "Skipping attached disk image (eject it to back it up): $image" >&2
    printf '%s\n' --exclude "$rel" --exclude "$rel/**"
  done
}

# Build exclude arguments for Documents
EXCLUDE_ARGS=()
for pattern in "${EXCLUDES[@]}"; do
  EXCLUDE_ARGS+=(--exclude "$pattern")
done

BASE_ARGS=(sync --progress)
if [[ "$DRY_RUN" == "true" ]]; then
  BASE_ARGS+=(--dry-run)
  echo "DRY RUN MODE - no changes will be made"
fi

if [[ "$MAILDIR_ONLY" != "true" ]]; then
  echo "=== Documents ==="
  echo "Syncing $HOME/Documents to $REMOTE:$REMOTE_BASE/Documents"
  echo "Excluding: ${EXCLUDES[*]}"
  echo
  while IFS= read -r arg; do
    EXCLUDE_ARGS+=("$arg")
  done < <(attached_image_excludes "$HOME/Documents")
  rclone "${BASE_ARGS[@]}" "${EXCLUDE_ARGS[@]}" \
    --backup-dir "$REMOTE:$VERSIONS/$RUN_STAMP/Documents" \
    "$HOME/Documents" "$REMOTE:$REMOTE_BASE/Documents"
  echo
fi

if [[ "$DOCUMENTS_ONLY" != "true" ]]; then
  echo "=== Maildir ==="
  echo "Syncing $HOME/Maildir to $REMOTE:Maildir"
  echo
  rclone "${BASE_ARGS[@]}" --exclude ".DS_Store" \
    --backup-dir "$REMOTE:$VERSIONS/$RUN_STAMP/Maildir" \
    "$HOME/Maildir" "$REMOTE:Maildir"
fi

# Pruning rides on the Documents runs only, so the hourly Maildir job and the
# Documents job never purge the same directory concurrently.
if [[ "$DRY_RUN" != "true" && "$MAILDIR_ONLY" != "true" ]]; then
  prune_versions
fi

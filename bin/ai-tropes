@dataclass
class Density:
    words: int = 0
    em_dashes: int = 0
    echo_words: list[tuple[str, int]] = field(default_factory=list)


def density(text: str) -> Density:
    words = WORD_RE.findall(text.lower())
    counts = Counter(
        w for w in words if len(w) >= 5 and w.isalpha() and w not in ECHO_STOPWORDS
    )
    return Density(
        words=len(words),
        em_dashes=len(EM_DASH_RE.findall(text)),
        echo_words=[(w, n) for w, n in counts.most_common(5) if n >= 4],
    )


# --- reporting --------------------------------------------------------------


def collect(text: str, enabled: list[Pattern]) -> list[tuple[Pattern, Hit]]:
    """All hits, earliest first, with overlaps suppressed.

    One span shouldn't be reported twice because two patterns describe the
    same tic from different angles.
    """
    raw = [(p, h) for p in enabled for h in p.find(text)]
    raw.sort(key=lambda ph: (ph[1].start, -ph[1].end))
    kept: list[tuple[Pattern, Hit]] = []
    for pattern, hit in raw:
        if kept and hit.start < kept[-1][1].end:
            continue
        kept.append((pattern, hit))
    return kept


def line_col(text: str, offset: int) -> tuple[int, int]:
    line = text.count("\n", 0, offset) + 1
    col = offset - (text.rfind("\n", 0, offset) + 1) + 1
    return line, col


def excerpt(text: str, hit: Hit, limit: int = 90) -> str:
    span = " ".join(text[hit.start : hit.end].split())
    return span if len(span) <= limit else span[: limit - 1] + "…"


def select(only: str, skip: str, noisy: bool) -> list[Pattern]:
    chosen = PATTERNS if noisy else [p for p in PATTERNS if not p.noisy]
    if only:
        wanted = {s.strip() for s in only.split(",") if s.strip()}
        unknown = wanted - PATTERNS_BY_ID.keys()
        if unknown:
            raise ValueError(f"unknown pattern id(s): {', '.join(sorted(unknown))}")
        chosen = [PATTERNS_BY_ID[i] for i in wanted]
    if skip:
        dropped = {s.strip() for s in skip.split(",") if s.strip()}
        unknown = dropped - PATTERNS_BY_ID.keys()
        if unknown:
            raise ValueError(f"unknown pattern id(s): {', '.join(sorted(unknown))}")
        chosen = [p for p in chosen if p.id not in dropped]
    return chosen


def scan(
    path: Path, enabled: list[Pattern]
) -> tuple[str, list[tuple[Pattern, Hit]], Density]:
    raw = path.read_text(errors="replace")
    masked = mask_code(raw)
    return masked, collect(masked, enabled), density(masked)


def report(
    path: Path, hits: list[tuple[Pattern, Hit]], text: str, dens: Density
) -> Iterator[str]:
    for pattern, hit in hits:
        line, col = line_col(text, hit.start)
        note = f"  ({hit.note})" if hit.note else ""
        yield f"{path}:{line}:{col}  [{pattern.id}]{note}  {excerpt(text, hit)}"


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Screen a draft for the mechanically detectable AI-writing tells."
    )
    parser.add_argument("files", nargs="*", type=Path)
    parser.add_argument(
        "--list", action="store_true", help="list the patterns and exit"
    )
    parser.add_argument("--only", default="", help="comma-separated pattern ids")
    parser.add_argument("--skip", default="", help="comma-separated pattern ids")
    parser.add_argument(
        "--noisy",
        action="store_true",
        help="also run the patterns that fire often on honest technical prose",
    )
    parser.add_argument("--json", action="store_true")
    parser.add_argument(
        "--exit-zero", action="store_true", help="exit 0 even when hits are found"
    )
    args = parser.parse_args()

    if args.list:
        for p in PATTERNS:
            flag = " (noisy, off by default)" if p.noisy else ""
            print(f"{p.id}{flag}\n    {p.name}: {p.description}\n")
        return 0

    if not args.files:
        parser.error("no files given")

    try:
        enabled = select(args.only, args.skip, args.noisy)
    except ValueError as error:
        print(f"ai-tropes: {error}", file=sys.stderr)
        return 2

    total = 0
    payload: list[dict[str, object]] = []
    for path in args.files:
        if not path.is_file():
            print(f"ai-tropes: not a file: {path}", file=sys.stderr)
            return 2
        text, hits, dens = scan(path, enabled)
        total += len(hits)

        if args.json:
            payload.append(
                {
                    "file": str(path),
                    "words": dens.words,
                    "em_dashes": dens.em_dashes,
                    "repeated_words": [
                        {"word": w, "count": n} for w, n in dens.echo_words
                    ],
                    "hits": [
                        {
                            "pattern": pattern.id,
                            "name": pattern.name,
                            "line": line_col(text, hit.start)[0],
                            "column": line_col(text, hit.start)[1],
                            "note": hit.note,
                            "text": excerpt(text, hit),
                        }
                        for pattern, hit in hits
                    ],
                }
            )
            continue

        for line in report(path, hits, text, dens):
            print(line)

        counts = Counter(pattern.id for pattern, _ in hits)
        if counts:
            print()
            print(f"{path}: {len(hits)} hits across {len(counts)} patterns")
            for pattern_id, n in counts.most_common():
                print(f"  {n:>3}  {pattern_id}")
        else:
            print(f"{path}: no hits")

        # Never a hit on its own --- 20 em dashes in a long essay is fine and
        # in a 400-word post is not, and a repeated word may just be the topic.
        print()
        print(
            f"  density: {dens.words} words, {dens.em_dashes} em dashes"
            f" ({dens.em_dashes * 1000 // max(dens.words, 1)} per 1000 words)"
        )
        if dens.echo_words:
            repeated = ", ".join(f"{w} ({n})" for w, n in dens.echo_words)
            print(
                f"  repeated words (check these are the topic, not a tic): {repeated}"
            )
        print()

    if args.json:
        print(json.dumps(payload, indent=2))

    return 0 if args.exit_zero or total == 0 else 1


if __name__ == "__main__":
    sys.exit(main())

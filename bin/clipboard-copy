#!/usr/bin/env bash
#
# Copy stdin to the system clipboard using an OSC 52 escape sequence, so it
# works both locally and over remote SSH connections in any terminal that
# supports it (e.g. ghostty).
#
# With no controlling terminal (e.g. an agent's shell subprocess), the sequence
# goes to the nearest ancestor process's terminal instead. Falls back to native
# clipboard tools (pbcopy/xclip/wl-copy) when no ancestor has one either (e.g. a
# cron job).
#
set -euo pipefail

data="$(cat)"

# Print the first writable terminal device among this process's ancestors.
ancestor_tty() {
    local pid=$$ tty
    while [[ "$pid" -gt 1 ]]; do
        tty="$(ps -o tty= -p "$pid" | tr -d ' ')"
        if [[ -n "$tty" && "$tty" != "?" && "$tty" != "??" ]] &&
            { : >"/dev/$tty"; } 2>/dev/null; then
            printf '/dev/%s' "$tty"
            return 0
        fi
        pid="$(ps -o ppid= -p "$pid" | tr -d ' ')"
    done
    return 1
}

emit_osc52() {
    local b64 seq
    # macOS base64 doesn't support `-w 0`, so strip newlines portably.
    b64="$(printf '%s' "$data" | base64 | tr -d '\n')"
    seq="\033]52;c;${b64}\a"
    # tmux and GNU screen need the sequence wrapped in their passthrough escape.
    if [[ -n "${TMUX:-}" ]]; then
        seq="\033Ptmux;\033${seq}\033\\"
    elif [[ "${TERM:-}" == screen* ]]; then
        seq="\033P${seq}\033\\"
    fi
    printf '%b' "$seq" >"$1"
}

if { : >/dev/tty; } 2>/dev/null; then
    emit_osc52 /dev/tty
elif target="$(ancestor_tty)"; then
    emit_osc52 "$target"
elif command -v pbcopy &>/dev/null; then
    printf '%s' "$data" | pbcopy
elif command -v xclip &>/dev/null; then
    printf '%s' "$data" | xclip -selection clipboard
elif command -v wl-copy &>/dev/null; then
    printf '%s' "$data" | wl-copy
else
    echo "clipboard-copy: no clipboard mechanism available" >&2
    exit 1
fi

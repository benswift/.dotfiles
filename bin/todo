#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.12"
# dependencies = []
# ///
"""todo: Ben's open tasks, the quick edits to them, and a way into an editor.

  todo                  list open tasks: todos, blocked, bot, then lx
  todo do <n>...        mark done
  todo undo <n>...      reopen
  todo block <n>...     mark blocked; `unblock` reopens
  todo e <n>...         open in $VISUAL, else $EDITOR, else hx (or `todo edit`)
  todo <words...>       a new anu task titled from the words, no quoting

The numbers are the rows of the last listing, remembered in
~/.local/state/todo/last.json, so `todo do 3` closes the third row shown and
`todo e 3` opens it (every file of a collapsed bot row). `todo e`/`edit`
followed by anything but numbers files a task, as any other words do. A
task is "bot" when tagged bot (unit-oncall files job failures so); "blocked"
is status blocked. The first three sections hold every open task in the anu and
ben vaults (both Ben's own). Bot tasks with the same title (a job that keeps failing
past unit-oncall's 24h re-arm) collapse to one row, and `do` on it closes
them all. The lx section lists that vault's open tasks whose agent is Ben;
closing one shares it with the team at once.

Everything goes through the wiz CLI. Every command but the listing and `e`
commits what it changes; the anu and ben vaults' commits are shared by their
next scheduled sync.
"""

from __future__ import annotations

import json
import os
import shlex
import subprocess
import sys
from dataclasses import dataclass
from pathlib import Path
from typing import NoReturn

ME = "[[people/ben-swift]]"
# Ben's own vaults: every open task in them is his. Others' tasks (lx) are his
# only when their agent is him.
MINE = ("anu", "ben")
STATE = (
    Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state"))
    / "todo"
    / "last.json"
)

# ANSI colour codes, so the listing takes the terminal's own palette.
ANSI = {"blue": 94, "yellow": 33, "magenta": 35, "cyan": 36, "dim": 90}
SECTION_STYLE = {"todos": "blue", "blocked": "yellow", "bot": "magenta", "lx": "cyan"}
# Each status verb: the status it sets, and how its commit message names it.
VERBS = {
    "do": ("done", "close"),
    "undo": ("open", "reopen"),
    "block": ("blocked", "block"),
    "unblock": ("open", "unblock"),
}


@dataclass(frozen=True)
class Task:
    vault: str
    path: str
    title: str
    status: str
    tags: frozenset[str]
    due: str

    @property
    def ref(self) -> str:
        return f"{self.vault}:{self.path}"

    @property
    def section(self) -> str:
        if self.vault not in MINE:
            return "lx"
        if "bot" in self.tags:
            return "bot"
        return "blocked" if self.status == "blocked" else "todos"


def wiz(*args: str, capture: bool = True, ok: tuple[int, ...] = (0,)) -> str:
    """Run wiz, exiting on any exit code but those in ok. Only sync (which exits
    1 when it didn't share) needs more than 0."""
    result = subprocess.run(
        ["wiz", *args], capture_output=capture, text=True, check=False
    )
    if result.returncode not in ok:
        sys.exit(f"todo: wiz {' '.join(args)} failed: {(result.stderr or '').strip()}")
    return result.stdout if capture else ""


def open_tasks() -> list[Task]:
    mine = " || ".join(f'vault == "{v}"' for v in MINE)
    query = f'type == "task" && !(status in ["done", "cancelled"]) && ({mine} || agent == "{ME}")'
    records = json.loads(wiz("query", *MINE, "lx", "-json", query))
    tasks = [
        Task(
            vault=r["vault"],
            path=r["path"],
            title=r["title"],
            status=r["fields"].get("status", "open"),
            tags=frozenset(r["fields"].get("tags") or ()),
            due=r["fields"].get("due_date", ""),
        )
        for r in records
    ]
    # Newest first: tasks are named by the date they were made.
    return sorted(tasks, key=lambda t: t.path, reverse=True)


def rows(tasks: list[Task]) -> list[tuple[str, list[Task]]]:
    """(section, tasks) per row, in listing order, bot tasks with the same
    title collapsed into one row."""
    out: list[tuple[str, list[Task]]] = []
    for section in ("todos", "blocked", "bot", "lx"):
        seen: dict[str, list[Task]] = {}
        for t in tasks:
            if t.section != section:
                continue
            if section == "bot" and t.title in seen:
                seen[t.title].append(t)
                continue
            group = [t]
            seen[t.title] = group
            out.append((section, group))
    return out


def use_color() -> bool:
    return sys.stdout.isatty() and not os.environ.get("NO_COLOR")


def paint(name: str, text: str, bold: bool = False) -> str:
    if not use_color():
        return text
    return f"\033[{'1;' if bold else ''}{ANSI[name]}m{text}\033[0m"


def render(listing: list[tuple[str, list[Task]]]) -> str:
    if not listing:
        return "(no open tasks)\n"
    out, section = [], None
    for n, (sec, group) in enumerate(listing, start=1):
        if sec != section:
            section = sec
            out += ["", paint(SECTION_STYLE[sec], sec, bold=True)]
        t = group[0]
        number = paint("dim", f"{n:>5}")
        due = paint("dim", f"  due {t.due}") if t.due else ""
        count = paint("dim", f"  ×{len(group)}") if len(group) > 1 else ""
        out.append(f"  {number}  {t.title}{due}{count}")
    return "\n".join([*out, ""]) + "\n"


def remembered(numbers: list[str]) -> list[list[str]]:
    """The task refs behind each number of the last listing."""
    try:
        last = json.loads(STATE.read_text())
    except (OSError, json.JSONDecodeError):
        sys.exit("todo: run todo first, to list the tasks these numbers name")
    out = []
    for n in numbers:
        if not n.isdigit() or not 1 <= int(n) <= len(last):
            sys.exit(f"todo: no row {n} in the last listing")
        out.append(last[int(n) - 1])
    return out


def commit(vault: str, paths: list[str], message: str) -> None:
    """Commit the vault's new or changed task files. Ben's own vaults defer their
    commits and keep them local, for their scheduled sync to share; any other
    vault's change is shared at once."""
    root = Path(wiz("path", vault).strip())
    files = [str(root / p) for p in paths]
    if vault not in MINE:
        wiz("sync", vault, "-m", message, *files, capture=False, ok=(0, 1))
        return
    out = wiz("sync", vault, "-local", "-m", message, *files, ok=(0, 1))
    if out.rstrip().rsplit("\n", 1)[-1] != "Saved locally; not shared":
        sys.exit(f"todo: couldn't commit to {vault}:\n{out.rstrip()}")


def list_tasks() -> int:
    listing = rows(open_tasks())
    STATE.parent.mkdir(parents=True, exist_ok=True)
    STATE.write_text(json.dumps([[t.ref for t in group] for _, group in listing]))
    print(render(listing), end="")
    return 0


def set_status(verb: str, numbers: list[str]) -> int:
    status, label = VERBS[verb]
    # Resolve every number before touching anything, so a typo in the second
    # does not leave the first half-applied.
    groups = remembered(numbers)
    touched: dict[str, list[str]] = {}
    for group in groups:
        for ref in group if verb == "do" else group[:1]:
            wiz("update", ref, "-set", f"status={status}")
            print(f"{status}: {ref}")
            vault, path = ref.split(":", 1)
            touched.setdefault(vault, []).append(path)
    for vault, paths in touched.items():
        what = Path(paths[0]).stem if len(paths) == 1 else f"{len(paths)} tasks"
        commit(vault, paths, f"todo: {label} {what}")
    return 0


def edit(numbers: list[str]) -> NoReturn:
    paths = [wiz("path", ref).strip() for group in remembered(numbers) for ref in group]
    editor = shlex.split(os.environ.get("VISUAL") or os.environ.get("EDITOR") or "hx")
    os.execvp(editor[0], [*editor, *paths])


def add_task(words: list[str]) -> int:
    title = " ".join(words)
    added = json.loads(
        wiz("add", "anu", "task", "-title", title, "-set", "status=open", "-json")
    )
    commit("anu", added["paths"], f"todo: add {title}")
    print(f"added {', '.join('anu:' + p for p in added['paths'])}")
    return 0


def main(argv: list[str] | None = None) -> int:
    match sys.argv[1:] if argv is None else argv:
        case []:
            return list_tasks()
        case [verb, *numbers] if verb in VERBS and numbers:
            return set_status(verb, numbers)
        case [verb] if verb in VERBS:
            print(__doc__, file=sys.stderr)
            return 2
        case ["e" | "edit", *numbers] if numbers and all(n.isdigit() for n in numbers):
            edit(numbers)
        case ["-h" | "--help"]:
            print(__doc__)
            return 0
        # A flag is never a task title, so a mistyped option files nothing.
        case [first, *_] if first.startswith("-"):
            print(f"todo: unknown option {first}\n{__doc__}", file=sys.stderr)
            return 2
        case words:
            return add_task(words)


if __name__ == "__main__":
    sys.exit(main())

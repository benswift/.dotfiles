#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.12"
# dependencies = []
# ///
"""todo: Ben's open tasks, the quick edits to them, and a way into an editor.

  todo                  list open tasks by section, priority last
  todo do <n>...        mark done
  todo undo <n>...      reopen
  todo block <n>...     mark blocked; `unblock` reopens
  todo prio <n>...      tag priority; `unprio` untags
  todo rm <n>...        delete
  todo e <n|ref>...     open in $VISUAL, else $EDITOR, else hx (or `todo edit`)
  todo <words...>       a new anu task titled from the words, no quoting

The numbers are the rows of the last listing, remembered in
~/.local/state/todo/last.json, so `todo do 3` closes the third row shown and
`todo e 3` opens it (every file of a collapsed bot row); `todo e` also takes
a record as vault:path. `todo e`/`edit` followed by plain words files a task,
as any other words do, but words mixed with numbers or vault:path refs are
refused, so a mistyped edit files nothing. A task is "bot" when tagged bot
(unit-oncall files job failures so); "blocked" is status blocked. The anu, ben
and hdr sections hold each vault's other open tasks; blocked and bot hold all
three vaults' (all are Ben's own). Bot tasks with the same title (a job that
keeps failing past unit-oncall's 24h re-arm) collapse to one row, and `do`,
`rm` or `prio` on it acts on them all. The lx section lists that vault's open
tasks whose agent is Ben; closing, deleting or tagging one shares it with the
team at once. A task tagged priority, from any vault, is listed under priority
whatever else it is; that section comes last so it stays on screen when the
top of a long listing has scrolled away.

Everything goes through the wiz CLI. Every command but the listing and `e`
commits what it changes; Ben's own vaults' commits are shared by their
next scheduled sync.
"""

from __future__ import annotations

import json
import os
import shlex
import subprocess
import sys
from dataclasses import dataclass
from pathlib import Path
from typing import NoReturn

ME = "[[people/ben-swift]]"
# Ben's own vaults: every open task in them is his. Others' tasks (lx) are his
# only when their agent is him.
MINE = ("anu", "ben", "hdr")
STATE = (
    Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state"))
    / "todo"
    / "last.json"
)

# ANSI colour codes, so the listing takes the terminal's own palette.
ANSI = {
    "red": 31,
    "blue": 94,
    "green": 32,
    "yellow": 33,
    "magenta": 35,
    "cyan": 36,
    "dim": 90,
    "bright-red": 91,
}
SECTIONS = {
    "anu": "blue",
    "ben": "green",
    "hdr": "red",
    "blocked": "yellow",
    "bot": "magenta",
    "lx": "cyan",
    "priority": "bright-red",
}
# Each status verb and the status it sets.
VERBS = {"do": "done", "undo": "open", "block": "blocked", "unblock": "open"}
PRIORITY = "priority"
# Each tag verb: whether it adds the priority tag.
TAG_VERBS = {"prio": True, "unprio": False}
# How each verb's commit message says what happened, to one task and to several.
# The lx team's Claude reads these to them, so they name tasks by title in
# plain words.
SAYS = {
    "add": ("add {}", "add {}"),
    "do": ("{} is done", "{} are done"),
    "undo": ("{} is open again", "{} are open again"),
    "block": ("{} is blocked", "{} are blocked"),
    "unblock": ("{} is unblocked", "{} are unblocked"),
    "prio": ("{} is a priority", "{} are priorities"),
    "unprio": ("{} is no longer a priority", "{} are no longer priorities"),
    "rm": ("delete {}", "delete {}"),
}


@dataclass(frozen=True)
class Task:
    vault: str
    path: str
    title: str
    status: str
    tags: frozenset[str]
    due: str

    @property
    def ref(self) -> str:
        return f"{self.vault}:{self.path}"

    @property
    def section(self) -> str:
        if PRIORITY in self.tags:
            return PRIORITY
        if self.vault not in MINE:
            return self.vault
        if "bot" in self.tags:
            return "bot"
        return "blocked" if self.status == "blocked" else self.vault


def wiz(*args: str, capture: bool = True, ok: tuple[int, ...] = (0,)) -> str:
    """Run wiz, exiting on any exit code but those in ok. Only sync (which exits
    1 when it didn't share) needs more than 0."""
    result = subprocess.run(
        ["wiz", *args], capture_output=capture, text=True, check=False
    )
    if result.returncode not in ok:
        sys.exit(f"todo: wiz {' '.join(args)} failed: {(result.stderr or '').strip()}")
    return result.stdout if capture else ""


def open_tasks() -> list[Task]:
    mine = " || ".join(f'vault == "{v}"' for v in MINE)
    query = f'type == "task" && !(status in ["done", "cancelled"]) && ({mine} || agent == "{ME}")'
    records = json.loads(wiz("query", *MINE, "lx", "-json", query))
    tasks = [
        Task(
            vault=r["vault"],
            path=r["path"],
            title=r["title"],
            status=r["fields"].get("status", "open"),
            tags=frozenset(r["fields"].get("tags") or ()),
            due=r["fields"].get("due_date", ""),
        )
        for r in records
    ]
    # Newest first: tasks are named by the date they were made.
    return sorted(tasks, key=lambda t: t.path, reverse=True)


def rows(tasks: list[Task]) -> list[tuple[str, list[Task]]]:
    """(section, tasks) per row, in listing order, bot tasks with the same
    title collapsed into one row."""
    out: list[tuple[str, list[Task]]] = []
    for section in SECTIONS:
        seen: dict[str, list[Task]] = {}
        for t in tasks:
            if t.section != section:
                continue
            if "bot" in t.tags and t.title in seen:
                seen[t.title].append(t)
                continue
            group = [t]
            seen[t.title] = group
            out.append((section, group))
    return out


def use_color() -> bool:
    return sys.stdout.isatty() and not os.environ.get("NO_COLOR")


def paint(name: str, text: str, bold: bool = False) -> str:
    if not use_color():
        return text
    return f"\033[{'1;' if bold else ''}{ANSI[name]}m{text}\033[0m"


def render(listing: list[tuple[str, list[Task]]]) -> str:
    if not listing:
        return "(no open tasks)\n"
    out, section = [], None
    for n, (sec, group) in enumerate(listing, start=1):
        if sec != section:
            section = sec
            out += ["", paint(SECTIONS[sec], sec, bold=True)]
        t = group[0]
        number = paint("dim", f"{n:>5}")
        due = paint("dim", f"  due {t.due}") if t.due else ""
        count = paint("dim", f"  ×{len(group)}") if len(group) > 1 else ""
        out.append(f"  {number}  {t.title}{due}{count}")
    return "\n".join([*out, ""]) + "\n"


def remembered(numbers: list[str]) -> list[list[str]]:
    """The task refs behind each number of the last listing."""
    try:
        last = json.loads(STATE.read_text())
    except (OSError, json.JSONDecodeError):
        sys.exit("todo: run todo first, to list the tasks these numbers name")
    out = []
    for n in numbers:
        if not n.isdigit() or not 1 <= int(n) <= len(last):
            sys.exit(f"todo: no row {n} in the last listing")
        out.append(last[int(n) - 1])
    return out


def commit(vault: str, paths: list[str], message: str) -> None:
    """Commit the vault's new or changed task files. Ben's own vaults defer their
    commits and keep them local, for their scheduled sync to share; any other
    vault's change is shared at once."""
    refs = [f"{vault}:{p}" for p in paths]
    if vault not in MINE:
        # The writes are already committed, so print only the status line,
        # not sync's note that it found nothing left to commit.
        out = wiz("sync", vault, "-m", message, *refs, ok=(0, 1))
        print(out.rstrip().rsplit("\n", 1)[-1])
        return
    out = wiz("sync", vault, "-local", "-m", message, *refs, ok=(0, 1))
    if out.rstrip().rsplit("\n", 1)[-1] != "Saved locally; not shared":
        sys.exit(f"todo: couldn't commit to {vault}:\n{out.rstrip()}")


def message(verb: str, titles: list[str]) -> str:
    """The commit message for verb acting on the tasks with these titles (a
    collapsed bot row's repeat as one)."""
    names = list(dict.fromkeys(titles))
    one, several = SAYS[verb]
    if len(names) == 1:
        return f"task: {one.format(names[0])}"
    listed = (
        str(len(names))
        if len(names) > 3
        else f"{', '.join(names[:-1])} and {names[-1]}"
    )
    return f"tasks: {several.format(listed)}"


def show(ref: str) -> dict:
    return json.loads(wiz("show", ref, "-json"))


def update(ref: str, verb: str, title: str, *changes: str) -> None:
    """Change a task's fields, with todo's message where its vault commits on
    write (lx); a deferred vault ignores it."""
    wiz("update", ref, *changes, "-m", message(verb, [title]))


Touched = dict[str, list[tuple[str, str]]]


def touch(touched: Touched, ref: str, title: str) -> None:
    vault, path = ref.split(":", 1)
    touched.setdefault(vault, []).append((path, title))


def list_tasks() -> int:
    listing = rows(open_tasks())
    STATE.parent.mkdir(parents=True, exist_ok=True)
    STATE.write_text(json.dumps([[t.ref for t in group] for _, group in listing]))
    print(render(listing), end="")
    return 0


def set_status(verb: str, numbers: list[str]) -> int:
    status = VERBS[verb]
    # Resolve every number before touching anything, so a typo in the second
    # does not leave the first half-applied.
    groups = remembered(numbers)
    touched: Touched = {}
    for group in groups:
        for ref in group if verb == "do" else group[:1]:
            title = show(ref)["title"]
            update(ref, verb, title, "-set", f"status={status}")
            print(f"{status}: {ref}")
            touch(touched, ref, title)
    commit_each(touched, verb)
    return 0


def set_priority(verb: str, numbers: list[str]) -> int:
    """Tag or untag every task of the rows, so a collapsed bot row moves as one,
    keeping their other tags."""
    add = TAG_VERBS[verb]
    groups = remembered(numbers)
    touched: Touched = {}
    for group in groups:
        for ref in group:
            record = show(ref)
            title = record["title"]
            tags: list[str] = record["fields"].get("tags") or []
            if (PRIORITY in tags) == add:
                continue
            new = [*tags, PRIORITY] if add else [t for t in tags if t != PRIORITY]
            if new:
                # wiz writes the value as given, so keep the vaults' flow style.
                update(ref, verb, title, "-set", f"tags=[{', '.join(new)}]")
            else:
                update(ref, verb, title, "-unset", "tags")
            print(f"{'priority' if add else 'not priority'}: {ref}")
            touch(touched, ref, title)
    commit_each(touched, verb)
    return 0


def commit_each(touched: Touched, verb: str) -> None:
    for vault, changed in touched.items():
        paths = [path for path, _ in changed]
        commit(vault, paths, message(verb, [title for _, title in changed]))


def remove(numbers: list[str]) -> int:
    """Delete the rows' tasks with one wiz remove, which deletes none of them
    while anything links to one."""
    refs = [ref for group in remembered(numbers) for ref in group]
    titles = [show(ref)["title"] for ref in refs]
    wiz("remove", "-m", message("rm", titles), *refs)
    touched: Touched = {}
    for ref, title in zip(refs, titles):
        print(f"deleted: {ref}")
        touch(touched, ref, title)
    commit_each(touched, "rm")
    return 0


def open_in_editor(paths: list[str]) -> NoReturn:
    editor = shlex.split(os.environ.get("VISUAL") or os.environ.get("EDITOR") or "hx")
    os.execvp(editor[0], [*editor, *paths])


def is_ref(word: str) -> bool:
    """Whether a word names a record, as vault:path or a path to a .md file."""
    return ":" in word or word.endswith(".md")


def edit(targets: list[str]) -> NoReturn:
    """Open each target, a row number of the last listing or a record."""
    refs = [
        ref for t in targets for ref in (remembered([t])[0] if t.isdigit() else [t])
    ]
    paths = [wiz("path", ref).strip() for ref in refs]
    for ref, path in zip(refs, paths):
        if not Path(path).is_file():
            sys.exit(f"todo: no record at {ref}")
    open_in_editor(paths)


def add_task(words: list[str]) -> int:
    title = " ".join(words)
    added = json.loads(
        wiz("add", "anu", "task", "-title", title, "-set", "status=open", "-json")
    )
    commit("anu", added["paths"], message("add", [title]))
    print(f"added {', '.join('anu:' + p for p in added['paths'])}")
    return 0


def main(argv: list[str] | None = None) -> int:
    match sys.argv[1:] if argv is None else argv:
        case []:
            return list_tasks()
        case [verb, *numbers] if verb in VERBS and numbers:
            return set_status(verb, numbers)
        case [verb, *numbers] if verb in TAG_VERBS and numbers:
            return set_priority(verb, numbers)
        case [verb] if verb in VERBS or verb in TAG_VERBS:
            print(__doc__, file=sys.stderr)
            return 2
        case ["rm", *numbers] if numbers and all(n.isdigit() for n in numbers):
            return remove(numbers)
        case ["rm", *_]:
            print(
                f"todo: rm takes row numbers of the last listing\n{__doc__}",
                file=sys.stderr,
            )
            return 2
        case ["e" | "edit", *targets] if targets and all(
            t.isdigit() or is_ref(t) for t in targets
        ):
            edit(targets)
        case ["e" | "edit" as verb, *words] if any(
            w.isdigit() or is_ref(w) for w in words
        ):
            print(
                f"todo: {verb} takes row numbers of the last listing or records as"
                " vault:path; to file a task, start its title with another word",
                file=sys.stderr,
            )
            return 2
        case ["-h" | "--help"]:
            print(__doc__)
            return 0
        # A flag is never a task title, so a mistyped option files nothing.
        case [first, *_] if first.startswith("-"):
            print(f"todo: unknown option {first}\n{__doc__}", file=sys.stderr)
            return 2
        case words:
            return add_task(words)


if __name__ == "__main__":
    sys.exit(main())

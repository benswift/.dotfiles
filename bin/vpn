#!/usr/bin/env bash
set -euo pipefail

# ANU account password for the GlobalProtect VPN. Prefer $ANU_PASSWORD from the
# environment (e.g. an untracked [env] block in ~/.config/mise/config.local.toml);
# otherwise read it from the login keychain, as the mail configs do. Store it once
# with:
#   security add-generic-password -a u2548636@anu.edu.au -s anu-vpn -w
# Note the item must live in login.keychain-db --- an entry saved in the Passwords
# app syncs via the iCloud keychain, which the `security` CLI cannot read.
password="${ANU_PASSWORD:-}"
[[ -n "$password" ]] ||
    password="$(security find-generic-password -a u2548636@anu.edu.au -s anu-vpn -w)"

printf '%s\n' "$password" |
    sudo openconnect --user=u2548636 --protocol=gp --passwd-on-stdin https://staff-access.anu.edu.au

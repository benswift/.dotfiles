#!/usr/bin/env bash
#
# The launchd entry point for mailsync. launchd/com.benswift.mailsync.plist
# runs it under bin/launchd-run, which supplies the wall-clock cap and the
# failure paging; what is left here is the judgement that being offline is
# not a failure. The machine sleeps and networks drop, so a metered
# connection or an unreachable IMAP host skips the run with exit 0 rather
# than counting towards a page. `mailsync` by hand still syncs regardless.

set -euo pipefail

if "$(dirname "$0")/on-metered-network"; then
    echo "[$(date '+%H:%M:%S')] on a metered network; skipping"
    exit 0
fi

if ! nc -z -w 5 outlook.office365.com 993 2>/dev/null; then
    echo "[$(date '+%H:%M:%S')] offline (outlook.office365.com:993 unreachable); skipping"
    exit 0
fi

exec mailsync

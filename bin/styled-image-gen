#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.12,<3.14"
# dependencies = ["replicate", "httpx", "typer"]
# ///
"""Generate styled images using various models via Replicate API.

Environment:
    REPLICATE_API_TOKEN: Your Replicate API token (required)

Supported models:
    banana    - Google Nano Banana Pro (default): style transfer, up to 14 ref images, 4K
    imagen    - Google Imagen 4 Ultra: high-fidelity text-to-image, no ref images, 1K/2K
    seedream  - ByteDance Seedream 5 Pro: cinematic aesthetics, up to 10 ref images, 1K/2K
    gpt       - OpenAI GPT Image 2: all-round text-to-image + editing
    recraft   - Recraft v4 Pro SVG: text-to-SVG vector graphics (no ref images)

Nano Banana Pro runs out of capacity often enough to matter; it is asked to fall
back to Seedream automatically, and transient errors are retried (--retries).

Provide a single prompt. Optionally include one or more input images with
--input-image (repeatable) to transform or use as reference.

Generated images will be saved to:
    <output-dir>/<iso-timestamp>/<slugified-image-prompt>.avif
"""

import datetime
import os
import re
import subprocess
import sys
import time
from contextlib import ExitStack
from pathlib import Path
from typing import Annotated, Any, NoReturn
from urllib.parse import urlparse

import httpx
import replicate
import typer
from replicate.exceptions import ReplicateException

MODELS: dict[str, str] = {
    "banana": "google/nano-banana-pro",
    "imagen": "google/imagen-4-ultra",
    "seedream": "bytedance/seedream-5-pro",
    "gpt": "openai/gpt-image-2",
    "recraft": "recraft-ai/recraft-v4-pro-svg",
}

app = typer.Typer()


def error_exit(message: str) -> NoReturn:
    print(f"Error: {message}", file=sys.stderr)
    sys.exit(1)


def get_api_token() -> str:
    token = os.environ.get("REPLICATE_API_TOKEN")
    if not token:
        raise KeyError(
            "REPLICATE_API_TOKEN not set. Add it to an [env] block in "
            "~/.config/mise/config.local.toml. Get a token at "
            "https://replicate.com/account/api-tokens"
        )
    return token


def slugify(text: str, max_words: int = 6) -> str:
    words = text.lower().split()[:max_words]
    slug = "-".join(words)
    slug = re.sub(r"[^a-z0-9-]", "-", slug)
    slug = re.sub(r"-+", "-", slug)
    slug = slug.strip("-")
    return slug if slug else "untitled"


# Generous read timeout: the Replicate client's sync run holds one long-lived
# request open until the prediction finishes. Slow models outlast a short
# timeout, and a busy model can sit queued for many minutes before it even
# starts --- waiting is cheaper than timing out and resubmitting.
HTTP_TIMEOUT = httpx.Timeout(600.0, connect=10.0)


def download_image(url: str, target_dir: Path, base_name: str) -> Path:
    ext = Path(urlparse(url).path).suffix.lower()
    if ext == ".jpeg" or ext not in (".jpg", ".png", ".webp", ".svg"):
        ext = ".jpg"
    target_path = target_dir / f"{base_name}{ext}"
    response = httpx.get(url, timeout=HTTP_TIMEOUT, follow_redirects=True)
    response.raise_for_status()
    target_path.write_bytes(response.content)
    return target_path


AVIF_QUALITY = 60


def convert_to_avif(jpg_path: Path, avif_path: Path) -> None:
    subprocess.run(
        ["avifenc", "-q", str(AVIF_QUALITY), str(jpg_path), str(avif_path)],
        check=True,
        capture_output=True,
    )
    jpg_path.unlink()


def warn(message: str) -> None:
    print(f"Warning: {message}", file=sys.stderr)


def build_model_input(
    model: str,
    prompt: str,
    aspect_ratio: str,
    resolution: str,
    output_format: str,
    safety_filter_level: str,
    image_paths: list[Path],
    stack: ExitStack,
) -> dict[str, Any]:
    params: dict[str, Any] = {
        "prompt": prompt,
        "aspect_ratio": aspect_ratio,
        "output_format": output_format,
    }

    if model == "banana":
        params["resolution"] = resolution
        params["safety_filter_level"] = safety_filter_level
        # Nano Banana Pro hits Google's capacity limits regularly; let Replicate
        # serve the request from Seedream rather than erroring out. Billed at the
        # fallback model's price, and skipped for 4K or 4:5/5:4 aspect ratios.
        params["allow_fallback_model"] = True
        if image_paths:
            params["image_input"] = [
                stack.enter_context(open(p, "rb")) for p in image_paths
            ]

    elif model == "imagen":
        # Imagen 4 Ultra is text-to-image only: fixed aspect ratios, 1K/2K, no refs.
        imagen_ratios = {"1:1", "9:16", "16:9", "3:4", "4:3"}
        if aspect_ratio not in imagen_ratios:
            warn(f"imagen does not support aspect ratio {aspect_ratio}; using 16:9")
            params["aspect_ratio"] = "16:9"
        size_map = {"1K": "1K", "2K": "2K", "4K": "2K"}
        mapped_size = size_map.get(resolution, "2K")
        if mapped_size != resolution:
            warn(f"imagen supports only 1K/2K; using {mapped_size} for {resolution}")
        params["image_size"] = mapped_size
        params["safety_filter_level"] = safety_filter_level
        if image_paths:
            warn("imagen model does not accept input images; ignoring them")

    elif model == "seedream":
        # Seedream 5 Pro renders at 1K or 2K, takes up to 10 refs, and exposes no
        # safety knob.
        params["output_format"] = "jpeg"
        seedream_ratios = {"1:1", "4:3", "3:4", "16:9", "9:16", "3:2", "2:3", "21:9"}
        if aspect_ratio not in seedream_ratios:
            warn(f"seedream does not support aspect ratio {aspect_ratio}; using 16:9")
            params["aspect_ratio"] = "16:9"
        size_map = {"1K": "1K", "2K": "2K", "4K": "2K"}
        mapped_size = size_map.get(resolution, "2K")
        if mapped_size != resolution:
            warn(f"seedream supports only 1K/2K; using {mapped_size} for {resolution}")
        params["size"] = mapped_size
        if image_paths:
            if len(image_paths) > 10:
                warn("seedream supports up to 10 input images; using first 10")
                image_paths = image_paths[:10]
            params["image_input"] = [
                stack.enter_context(open(p, "rb")) for p in image_paths
            ]

    elif model == "recraft":
        params.pop("output_format", None)
        if image_paths:
            warn("recraft model does not accept input images; ignoring them")

    elif model == "gpt":
        gpt_ratio_map = {
            "1:1": "1:1",
            "3:2": "3:2",
            "2:3": "2:3",
            "16:9": "16:9",
            "9:16": "9:16",
            "4:3": "3:2",
            "3:4": "2:3",
        }
        mapped = gpt_ratio_map.get(aspect_ratio, "1:1")
        if mapped != aspect_ratio:
            warn(
                f"gpt model does not support aspect ratio {aspect_ratio}; using {mapped}"
            )
        params["aspect_ratio"] = mapped
        params["output_format"] = "jpeg" if output_format == "jpg" else output_format
        quality_map = {"1K": "medium", "2K": "high", "4K": "high"}
        params["quality"] = quality_map.get(resolution, "high")
        params["moderation"] = (
            "low" if safety_filter_level == "block_only_high" else "auto"
        )
        if image_paths:
            params["input_images"] = [
                stack.enter_context(open(p, "rb")) for p in image_paths
            ]

    return params


def extract_output(output: Any) -> str:
    if isinstance(output, list):
        return str(output[0])
    return str(output)


# Replicate surfaces provider capacity problems as ordinary errors, so a busy
# afternoon on a popular model reads as a hard failure. These are worth waiting
# out; anything else (bad input, refused prompt) is not.
TRANSIENT_MARKERS = (
    "rate limit",
    "high demand",
    "e003",
    "capacity",
    "temporarily unavailable",
    "try again later",
    "internal server error",
    "502",
    "503",
    "504",
    "timed out",
)
RETRY_BASE_DELAY = 15


def is_transient(exc: Exception) -> bool:
    # A timeout usually means the model is queued behind a backlog, not that
    # anything is wrong with the request.
    if isinstance(exc, httpx.TimeoutException):
        return True
    message = str(exc).lower()
    return any(marker in message for marker in TRANSIENT_MARKERS)


def generate_image(
    model: str,
    prompt: str,
    target_dir: Path,
    base_name: str,
    client: replicate.Client,
    aspect_ratio: str,
    resolution: str,
    output_format: str,
    safety_filter_level: str,
    input_image_paths: list[Path] | None = None,
    retries: int = 2,
) -> Path:
    image_paths = input_image_paths or []
    for attempt in range(retries + 1):
        # Rebuild the input each attempt: the file handles are consumed by the
        # upload, so a retry needs fresh ones.
        try:
            with ExitStack() as stack:
                model_input = build_model_input(
                    model,
                    prompt,
                    aspect_ratio,
                    resolution,
                    output_format,
                    safety_filter_level,
                    image_paths,
                    stack,
                )
                output = client.run(MODELS[model], input=model_input)
            break
        except (ReplicateException, httpx.HTTPError) as e:
            if attempt == retries or not is_transient(e):
                raise
            delay = RETRY_BASE_DELAY * 2**attempt
            warn(f"{e}\nRetrying in {delay}s ({attempt + 1}/{retries})")
            time.sleep(delay)

    if not output:
        raise ValueError("Model returned empty output")

    image_url = extract_output(output)
    return download_image(image_url, target_dir, base_name)


@app.command()
def _main_impl(
    prompt: Annotated[str, typer.Argument(help="Image prompt")],
    model: Annotated[
        str,
        typer.Option(help="Model to use: banana, imagen, seedream, gpt, recraft"),
    ] = "banana",
    output_dir: Annotated[Path, typer.Option(help="Output directory")] = Path(
        "styled_image_gen_output"
    ),
    input_image: Annotated[
        list[Path] | None,
        typer.Option(
            "--input-image",
            help="Input image(s) for reference (repeat for multiple)",
            exists=True,
            dir_okay=False,
        ),
    ] = None,
    aspect_ratio: Annotated[
        str,
        typer.Option(help="Aspect ratio for generated images"),
    ] = "16:9",
    resolution: Annotated[
        str,
        typer.Option(help="Resolution: 1K, 2K, or 4K"),
    ] = "2K",
    jpg: Annotated[
        bool,
        typer.Option("--jpg", help="Keep original JPG instead of converting to AVIF"),
    ] = False,
    output_filename: Annotated[
        str | None,
        typer.Option(
            help="Output filename (without extension, defaults to slugified prompt)"
        ),
    ] = None,
    safety_filter_level: Annotated[
        str,
        typer.Option(
            help="Safety filter: block_low_and_above, block_medium_and_above, block_only_high"
        ),
    ] = "block_only_high",
    retries: Annotated[
        int,
        typer.Option(help="Retries on transient provider errors (capacity, 5xx)"),
    ] = 2,
    fallback_model: Annotated[
        str | None,
        typer.Option(
            help="Model to use if the chosen one stays unavailable, e.g. seedream"
        ),
    ] = None,
) -> None:
    """Generate a styled image using Replicate models.

    Examples:

      styled-image-gen "sunrise over a misty valley" --resolution 2K

      styled-image-gen "studio portrait" --model flux --input-image ref.jpg

      styled-image-gen "abstract pattern" --input-image refs/a.jpg --input-image refs/b.jpg
    """
    if input_image is None:
        input_image = []
    if model not in MODELS:
        error_exit(f"Unknown model '{model}'. Choose from: {', '.join(MODELS)}")
    if fallback_model is not None and fallback_model not in MODELS:
        error_exit(
            f"Unknown fallback model '{fallback_model}'. Choose from: {', '.join(MODELS)}"
        )

    all_input_images: list[Path] = list(input_image)

    api_token = get_api_token()

    if output_filename:
        target_dir = output_dir
    else:
        timestamp = datetime.datetime.now(datetime.timezone.utc).strftime(
            "%Y-%m-%dT%H-%M-%SZ"
        )
        target_dir = output_dir / timestamp
    target_dir.mkdir(parents=True, exist_ok=True)

    client = replicate.Client(api_token=api_token, timeout=HTTP_TIMEOUT)

    if model == "recraft":
        output_format = "svg"
    else:
        output_format = "jpg" if jpg else "avif"
    filename = output_filename if output_filename else slugify(prompt)

    print(f"Model: {MODELS[model]} ({model})")
    print(f"Aspect ratio: {aspect_ratio}")
    print(f"Resolution: {resolution}")
    print(f"Format: {output_format}")
    print(f"Safety filter: {safety_filter_level}")
    if all_input_images:
        print(f"Input images: {', '.join(str(p) for p in all_input_images)}")
    print(f"Output directory: {target_dir}")
    print("Generating 1 image...")
    print()

    print(f"Prompt: {prompt}")

    try:
        downloaded_path = generate_image(
            model,
            prompt,
            target_dir,
            filename,
            client,
            aspect_ratio,
            resolution,
            "jpg",
            safety_filter_level,
            all_input_images if all_input_images else None,
            retries,
        )
    except (ReplicateException, httpx.HTTPError) as e:
        if not fallback_model or not is_transient(e):
            raise
        warn(f"{e}\n{model} is unavailable; falling back to {fallback_model}")
        model = fallback_model
        print(f"Model: {MODELS[model]} ({model})")
        downloaded_path = generate_image(
            model,
            prompt,
            target_dir,
            filename,
            client,
            aspect_ratio,
            resolution,
            "jpg",
            safety_filter_level,
            all_input_images if all_input_images else None,
            retries,
        )

    final_path = downloaded_path
    if not jpg:
        suffix = downloaded_path.suffix.lower()
        if suffix in (".jpg", ".jpeg", ".png"):
            avif_path = target_dir / f"{filename}.avif"
            print("Converting to AVIF...")
            convert_to_avif(downloaded_path, avif_path)
            final_path = avif_path
        elif suffix != ".svg":
            warn(f"Cannot convert {suffix} to AVIF; keeping as downloaded")

    print()
    print(f"Image generated: {final_path}")


if __name__ == "__main__":
    try:
        app()
    except KeyboardInterrupt:
        print("\nInterrupted by user", file=sys.stderr)
        sys.exit(130)
    except KeyError as e:
        error_exit(str(e))
    except ValueError as e:
        error_exit(str(e))
    except FileNotFoundError as e:
        if "avifenc" in str(e):
            error_exit("avifenc not found. Install with: brew install libavif")
        error_exit(f"File not found: {e}")
    except subprocess.CalledProcessError as e:
        error_exit(f"AVIF conversion failed: {e.stderr.decode() if e.stderr else e}")
    except OSError as e:
        error_exit(f"File operation failed: {e}")
    except httpx.HTTPError as e:
        error_exit(f"HTTP request failed: {e}")
    except ReplicateException as e:
        error_exit(f"Replicate API error: {e}")

#!/usr/bin/env bash
# hx-rex --- open files in helix in a new Rex pane, split to the right of the
# pane this runs in (REX_SESSION/REX_BLOCK), on whichever server that pane
# lives on. The pane closes when helix exits.
#
# Usage: hx-rex FILE[:LINE[:COL]]...
set -euo pipefail

if [[ $# -eq 0 || "$1" == -h || "$1" == --help ]]; then
    sed -n 's/^# \{0,1\}Usage: /Usage: /p' "$0"
    exit $(($# == 0))
fi

[[ -n "${REX_SESSION:-}" && -n "${REX_BLOCK:-}" ]] || {
    echo "hx-rex: not in a Rex terminal (REX_SESSION/REX_BLOCK unset)" >&2
    exit 1
}

# helix is a source build in ~/.local/bin (see bin/helix-build), which the
# login environment Rex runs the command in may not have on PATH.
if [[ -x "$HOME/.local/bin/hx" ]]; then
    hx="$HOME/.local/bin/hx"
else
    hx="$(command -v hx)" || {
        echo "hx-rex: no hx found --- run helix-build" >&2
        exit 1
    }
fi

abspath() { printf '%s\n' "$(cd "$(dirname "$1")" && pwd -P)/$(basename "$1")"; }

paths=()
for file in "$@"; do paths+=("$(abspath "$file")"); done
label="$(basename "${paths[0]}")"

rex split -s "$REX_SESSION" -b "$REX_BLOCK" --split=right \
    -c "$PWD" --label "${label%%:*}" -- "$hx" "${paths[@]}"

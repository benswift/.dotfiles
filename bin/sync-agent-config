#!/usr/bin/env bash
#
# Synchronise AI-agent configuration that cannot be represented as plain
# dotfile symlinks, such as Claude plugin installation and Codex skill links.
#
set -euo pipefail

DOTFILES_DIR="${DOTFILES_DIR:-$HOME/.dotfiles}"
UPDATE_CLAUDE=false

source "$DOTFILES_DIR/lib/log.sh"

usage() {
    cat <<EOF
Usage: sync-agent-config [--update-claude]

Options:
  --update-claude   Pull Claude marketplaces and refresh installed plugins
  -h, --help        Show this help message
EOF
}

while [[ $# -gt 0 ]]; do
    case "$1" in
    --update-claude)
        UPDATE_CLAUDE=true
        shift
        ;;
    -h | --help)
        usage
        exit 0
        ;;
    *)
        echo "Unknown option: $1" >&2
        usage >&2
        exit 1
        ;;
    esac
done

sync_claude_plugins() {
    local settings="$DOTFILES_DIR/claude/settings.json"

    if ! command -v claude &>/dev/null; then
        warn "claude not installed --- skipping Claude plugin sync"
        return
    fi
    if ! command -v jq &>/dev/null; then
        warn "jq not installed --- skipping Claude plugin sync"
        return
    fi
    if [[ ! -f "$settings" ]]; then
        warn "Claude settings missing at $settings"
        return
    fi

    info "Synchronising Claude plugins..."
    # Build one `marketplace add` spec per entry: GitHub repos pin a ref with
    # @ref, plain git URLs with #ref (package marketplaces pin release tags).
    # Serial on purpose: each add writes settings.json back, and parallel adds
    # race on that write (losing refs from other entries).
    jq -r '.extraKnownMarketplaces // {} | to_entries[] | .value.source |
        if .repo then .repo + (if .ref then "@" + .ref else "" end)
        else .url + (if .ref then "#" + .ref else "" end) end' "$settings" |
        xargs -I {} claude plugin marketplace add {} >/dev/null 2>&1 || true
    jq -r '.enabledPlugins // {} | to_entries[] | select(.value) | .key' "$settings" |
        xargs -P 4 -I {} claude plugin install --scope user {} >/dev/null 2>&1 || true

    if [[ "$UPDATE_CLAUDE" == "true" ]]; then
        claude plugin marketplace update >/dev/null 2>&1 || true
        # Every installed plugin, enabled or not. A disabled one is still
        # installed, and pinning it to an old version just hides the skew
        # until the day it's enabled; updating it changes no session.
        claude plugin list --json 2>/dev/null |
            jq -r '.[] | "\(.id) \(.scope)"' |
            xargs -P 8 -L 1 sh -c 'claude plugin update --scope "$2" "$1" >/dev/null 2>&1' _ || true
    fi
}

remove_legacy_codex_profile() {
    local profile="$HOME/.codex/dotfiles.config.toml"
    local old_target="$DOTFILES_DIR/codex/config.toml"

    if [[ -L "$profile" && "$(readlink "$profile")" == "$old_target" ]]; then
        rm "$profile"
        info "Removed obsolete Codex dotfiles profile link"
    elif [[ -e "$profile" || -L "$profile" ]]; then
        warn "$profile is not the legacy dotfiles link, leaving it alone"
    fi
}

sync_codex_skills() {
    local claude_skills="$HOME/.claude/plugins/marketplaces/ben/skills"
    local agent_skills="$HOME/.agents/skills"
    local legacy_codex_skills="$HOME/.codex/skills"

    if [[ ! -d "$claude_skills" ]]; then
        warn "ben marketplace skills missing at $claude_skills"
        return
    fi

    if [[ -e "$agent_skills" && ! -d "$agent_skills" ]]; then
        warn "$agent_skills exists but is not a directory"
        return
    fi
    mkdir -p "$agent_skills"

    local skill name dest existing
    for skill in "$claude_skills"/*; do
        [[ -d "$skill" ]] || continue
        name="$(basename "$skill")"
        [[ "$name" == .* ]] && continue
        dest="$agent_skills/$name"
        if [[ -L "$dest" ]]; then
            local target
            target="$(readlink "$dest")"
            if [[ "$target" == "$claude_skills"/* ]]; then
                ln -sfn "$skill" "$dest"
            else
                warn "Agent skill $dest links outside the ben marketplace, leaving it alone"
            fi
        elif [[ -e "$dest" ]]; then
            warn "Agent skill $dest already exists and is not a symlink"
        else
            ln -s "$skill" "$dest"
        fi
    done

    # Remove stale links created by this sync, without touching independently
    # installed skills such as agent-browser or dogfood.
    for existing in "$agent_skills"/*; do
        [[ -L "$existing" ]] || continue
        local target
        target="$(readlink "$existing")"
        if [[ "$target" == "$claude_skills"/* && ! -e "$existing" ]]; then
            rm "$existing"
        fi
    done

    # Migrate links made by the previous implementation. Codex owns everything
    # else in ~/.codex/skills, especially its generated .system directory.
    if [[ -d "$legacy_codex_skills" ]]; then
        for existing in "$legacy_codex_skills"/*; do
            [[ -L "$existing" ]] || continue
            local target
            target="$(readlink "$existing")"
            if [[ "$target" == "$claude_skills"/* ]]; then
                rm "$existing"
            fi
        done
    fi

    info "Exposed Claude personal skills to Codex in $agent_skills"
}

sync_claude_plugins
remove_legacy_codex_profile
sync_codex_skills

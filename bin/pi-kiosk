#!/usr/bin/env bash
#
# pi-kiosk --- flash an SD card that boots a Raspberry Pi straight into a
# fullscreen Chromium kiosk at a given URL, joined to Tailscale.
#
# The heavy lifting is done by cloud-init, which ships on every Raspberry Pi
# OS image since the Trixie release (Nov 2025): flash the stock desktop image,
# then drop `user-data` and `network-config` onto the FAT32 boot partition.
# First boot creates the user, joins the wifi, installs Tailscale, and wires
# up a labwc session whose only job is running Chromium in kiosk mode. No SDM,
# no chroot image surgery --- this replaces the SDM pipeline in the panic and
# imaginative-restoration repos, from which the kiosk session config is ported.
#
#   pi-kiosk --url https://example.com --hostname lobby-pi \
#            --wifi-ssid MyNet --wifi-password secret \
#            --tailscale-authkey tskey-auth-... --ssh-key ~/.ssh/id_ed25519.pub
#
# The kiosk URL lives at /kiosk-url.txt on the boot partition, so it can be
# changed later by mounting the card on any machine, or on the running Pi
# with `sudo kiosk-set-url <url>` (e.g. over `tailscale ssh`).
#
# Notes:
#   - Pi 4/5 are the supported targets. The image boots a Pi 3, but 1 GB of
#     RAM plus a known Chromium-on-Pi-3 regression make that best-effort.
#   - Tailscale is installed on first boot, so the Pi needs network then
#     (it's an online kiosk; it needs network anyway).
#   - With --tailscale-tag, the auth key is minted per card through the
#     Tailscale OAuth client in TS_OAUTH_CLIENT_ID/TS_OAUTH_CLIENT_SECRET
#     (scopes: auth keys + devices core, owning the tag), and any existing
#     node with the same name and tag is removed once the card is written.
#     Only the single-use key goes on the card, never the client secret.
#     Tagged nodes never expire, so the kiosk stays on the tailnet.
#   - A watchdog timer restarts Chromium when it is showing an error page or
#     a crashed renderer rather than the kiosk URL's site.

set -euo pipefail
# Bash 5.2+ expands & in ${var//pat/repl} replacements to the matched pattern,
# which would corrupt any substituted value containing & (shell commands in
# the templates, passwords, auth keys). Restore literal replacement.
shopt -u patsub_replacement 2>/dev/null || true

readonly IMAGE_URL="${PI_KIOSK_IMAGE_URL:-https://downloads.raspberrypi.com/raspios_arm64_latest}"
readonly CACHE_DIR="${PI_KIOSK_CACHE_DIR:-$HOME/.cache/raspios-images}"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

info() { echo -e "${GREEN}$*${NC}"; }
warn() { echo -e "${YELLOW}$*${NC}"; }
die() {
    echo -e "${RED}Error: $*${NC}" >&2
    exit 1
}

usage() {
    cat <<EOF
Usage: pi-kiosk [OPTIONS]

Flash an SD card with Raspberry Pi OS configured as a Chromium web kiosk.

Required:
    --url <url>                  URL to display in kiosk mode

Identity:
    --hostname <name>            Hostname (default: pi-kiosk)
    --username <user>            Admin account name (default: kiosk)
    --password <pass>            Optional console password (default: locked)
    --ssh-key <path>             Required SSH public key; SSH is key-only

Network:
    --wifi-ssid <ssid>           WiFi network name
    --wifi-password <pass>       WiFi password (WPA2-PSK)
    --wifi-enterprise-user <u>   Enterprise (802.1X) WiFi username
    --wifi-enterprise-pass <p>   Enterprise (802.1X) WiFi password
    --wifi-ca-cert <path>        Required PEM CA certificate for enterprise WiFi
    --wifi-domain-suffix <name>  Required RADIUS server DNS suffix for enterprise WiFi
    --wifi-country <cc>          WiFi regulatory country (default: AU)
    --tailscale-authkey <key>    Tailscale auth key for automatic join
    --tailscale-tag <tag[,tag]>  Mint a single-use key with these tags via the
                                 OAuth client (instead of --tailscale-authkey)

Other:
    --device <dev>               SD card device (default: auto-detect)
    --test                       Generate config into a temp dir; don't flash

Examples:
    pi-kiosk --url https://panic.fly.dev/ --hostname panic-lobby \\
        --wifi-ssid MyNet --wifi-password secret \\
        --tailscale-authkey tskey-auth-... --ssh-key ~/.ssh/id_ed25519.pub

    pi-kiosk --url https://slop.university/signage/portrait/ \\
        --hostname slopu-kiosk-1 --wifi-ssid ANU-Secure \\
        --wifi-enterprise-user "\$RPI_SSID" --wifi-enterprise-pass "\$RPI_PASSWORD" \\
        --wifi-ca-cert /path/to/institution-ca.pem --wifi-domain-suffix radius.example.edu \\
        --tailscale-tag tag:signage --ssh-key ~/.ssh/id_ed25519.pub
EOF
    exit "${1:-1}"
}

check_required_tools() {
    local missing=() cmd
    for cmd in curl xz dd lsblk openssl mktemp ssh-keygen base64; do
        command -v "$cmd" >/dev/null 2>&1 || missing+=("$cmd")
    done
    ((${#missing[@]} == 0)) || die "missing required tools: ${missing[*]}"
}

# ---------------------------------------------------------------------------
# SD card detection (ported from panic/rpi/pi-setup.sh). sd* devices must be
# removable; mmcblk* readers are accepted regardless, because built-in SD
# readers often report removable=0. Size-gated to 2--256GB either way, which
# excludes system disks.
find_sd_card() {
    local devices=() device_info=() path name device removable size size_gb model

    for path in /sys/block/*; do
        name="${path##*/}"
        [[ "$name" =~ ^(sd[a-z]+|mmcblk[0-9]+)$ ]] || continue
        device="/dev/$name"
        removable=$(cat "$path/removable" 2>/dev/null || echo 0)
        [[ "$name" == sd* && "$removable" != 1 ]] && continue
        size=$(lsblk -b -d -n -o SIZE "$device" 2>/dev/null || echo 0)
        size_gb=$((size / 1024 / 1024 / 1024))
        ((size_gb >= 2 && size_gb <= 256)) || continue
        model=$(lsblk -d -n -o MODEL "$device" 2>/dev/null | tr -s ' ' || echo Unknown)
        devices+=("$device")
        device_info+=("${size_gb}GB - ${model:-Unknown}")
    done

    ((${#devices[@]} > 0)) || die "no SD card found --- insert one and re-run (or pass --device)"

    if ((${#devices[@]} == 1)); then
        warn "Found SD card: ${devices[0]} (${device_info[0]})" >&2
        echo "${devices[0]}"
        return 0
    fi

    warn "Multiple candidate devices:" >&2
    local i
    for i in "${!devices[@]}"; do
        echo "  $((i + 1))) ${devices[$i]} - ${device_info[$i]}" >&2
    done
    local selection
    read -r -p "Select device (1-${#devices[@]}): " selection
    if ! [[ "$selection" =~ ^[0-9]+$ ]] || ((selection < 1 || selection > ${#devices[@]})); then
        die "invalid selection"
    fi
    echo "${devices[$((selection - 1))]}"
}

# ---------------------------------------------------------------------------
# Image download. IMAGE_URL is Raspberry Pi's "latest" redirect; resolve it so
# the cache is keyed by the real release filename and a new release triggers a
# fresh download. Only the .xz is cached --- flashing decompresses on the fly.
fetch_image() {
    local resolved filename cached
    resolved=$(curl -fsSIL -o /dev/null -w '%{url_effective}' "$IMAGE_URL") ||
        die "could not resolve image URL: $IMAGE_URL"
    filename=$(basename "$resolved")
    cached="$CACHE_DIR/$filename"

    if [[ -f "$cached" ]]; then
        warn "Using cached image: $filename" >&2
    else
        warn "Downloading $filename ..." >&2
        mkdir -p "$CACHE_DIR"
        curl -fL -o "$cached.partial" "$resolved" >&2 || {
            rm -f "$cached.partial"
            die "download failed: $resolved"
        }
        mv "$cached.partial" "$cached"
    fi

    xz -t "$cached" 2>/dev/null || {
        rm -f "$cached"
        die "cached image is not valid xz (removed; re-run to re-download)"
    }
    echo "$cached"
}

flash_image() {
    local image="$1" device="$2" part

    # Unmount anything auto-mounted from a previous life of this card.
    for part in "$device"?*; do
        [[ -b "$part" ]] || continue
        sudo umount "$part" 2>/dev/null || true
    done

    warn "Flashing $(basename "$image") -> $device (this takes a few minutes)..."
    xz -dc "$image" | sudo dd of="$device" bs=4M status=progress conv=fsync
    sudo partprobe "$device" 2>/dev/null || true
    sleep 2
    info "✓ Image written"
}

boot_partition() {
    local device="$1"
    if [[ "$device" == *[0-9] ]]; then
        echo "${device}p1"
    else
        echo "${device}1"
    fi
}

# ---------------------------------------------------------------------------
# Tailscale API via the OAuth client. Secrets go to curl on stdin or through
# process substitution, so they never appear in the process list.
readonly TS_API="https://api.tailscale.com/api/v2"

ts_token() {
    printf 'client_id=%s&client_secret=%s' "$TS_OAUTH_CLIENT_ID" "$TS_OAUTH_CLIENT_SECRET" |
        curl -fsS -d @- "$TS_API/oauth/token" | jq -er .access_token
}

ts_api() {
    local token="$1"
    shift
    curl -fsS -H @<(printf 'Authorization: Bearer %s\n' "$token") "$@"
}

# Single-use, preauthorized, tagged; a week to get the card into the Pi.
ts_mint_authkey() {
    local token="$1" tags="$2" hostname="$3" body
    body=$(jq -nc --arg tags "$tags" --arg desc "pi-kiosk $hostname" '{
        capabilities: {devices: {create: {
            reusable: false, ephemeral: false, preauthorized: true,
            tags: ($tags | split(","))}}},
        expirySeconds: 604800, description: $desc}')
    ts_api "$token" -H 'Content-Type: application/json' -d "$body" \
        "$TS_API/tailnet/-/keys" | jq -er .key
}

# The card's previous incarnation would otherwise keep the name, and the new
# node would join as <hostname>-1. Only nodes carrying one of the card's tags
# are touched, so a same-named personal machine is safe.
ts_remove_stale_nodes() {
    local token="$1" tags="$2" hostname="$3" id name
    while IFS=$'\t' read -r id name; do
        warn "Removing previous tailnet node $name"
        ts_api "$token" -X DELETE "$TS_API/device/$id" >/dev/null
    done < <(ts_api "$token" "$TS_API/tailnet/-/devices" |
        jq -r --arg h "$hostname" --arg tags "$tags" '
            ($tags | split(",")) as $want
            | .devices[]
            | select((.name | split(".")[0]) == $h)
            | select((.tags // []) | any(. as $t | $want | index($t)))
            | [.id, .name] | @tsv')
}

# ---------------------------------------------------------------------------
# cloud-init config generation. Templates use @TOKEN@ placeholders substituted
# with bash string replacement, so no value ever meets a shell-quoting or
# sed-delimiter edge case.

# The kiosk session, ported from panic/rpi/pi-setup.sh: labwc autostarts a
# systemd user service that reads the URL from the boot partition on every
# start, restarts Chromium on crash, and restarts it nightly. The GPU-forcing
# Chromium flags (--ignore-gpu-blocklist etc.) are deliberately absent ---
# imaginative-restoration traced Pi 5 lockups to them.
generate_user_data() {
    local out="$1"
    local ud

    IFS= read -r -d '' ud <<'EOF' || true
#cloud-config
hostname: @HOSTNAME@
manage_etc_hosts: true

users:
  - name: @USERNAME@
    gecos: Kiosk
    shell: /bin/bash
    groups: [adm, sudo, video, render, input, audio, tty, netdev, gpio, i2c, spi]
    lock_passwd: @LOCK_PASSWD@
    passwd: "@PASSWD_HASH@"
    sudo: ALL=(ALL) NOPASSWD:ALL
@SSH_KEYS@

ssh_pwauth: false
timezone: @TIMEZONE@

write_files:
  - path: /home/@USERNAME@/.config/labwc/autostart
    owner: "@USERNAME@:@USERNAME@"
    permissions: "0755"
    defer: true
    content: |
      systemctl --user start chromium-kiosk.service &

  - path: /home/@USERNAME@/.config/labwc/rc.xml
    owner: "@USERNAME@:@USERNAME@"
    permissions: "0644"
    defer: true
    content: |
      <?xml version="1.0"?>
      <labwc_config>
        <core>
          <decoration>no</decoration>
          <gap>0</gap>
        </core>
        <keyboard>
          <keybind key="Super-q">
            <action name="Exit"/>
          </keybind>
        </keyboard>
      </labwc_config>

  - path: /home/@USERNAME@/.config/systemd/user/chromium-kiosk.service
    owner: "@USERNAME@:@USERNAME@"
    permissions: "0644"
    defer: true
    content: |
      [Unit]
      Description=Chromium kiosk browser
      After=graphical-session.target
      Requires=graphical-session.target

      [Service]
      Type=simple
      Environment="WAYLAND_DISPLAY=wayland-0"
      ExecStartPre=/bin/bash -c 'while [ ! -S "/run/user/$(id -u)/${WAYLAND_DISPLAY}" ]; do sleep 0.5; done'
      ExecStart=/bin/bash -c 'URL=$(cat /boot/firmware/kiosk-url.txt 2>/dev/null || echo "@URL@"); BROWSER=$(command -v chromium || command -v chromium-browser); exec "$BROWSER" --kiosk --password-store=basic --user-data-dir=%h/.cache/chromium-kiosk --remote-debugging-port=9222 --no-first-run --noerrdialogs --disable-infobars --disable-pinch --disable-component-update --autoplay-policy=no-user-gesture-required --check-for-update-interval=31536000 --ozone-platform=wayland "$URL"'
      Restart=always
      RestartSec=5

      [Install]
      WantedBy=default.target

  - path: /home/@USERNAME@/.config/systemd/user/chromium-restart.service
    owner: "@USERNAME@:@USERNAME@"
    permissions: "0644"
    defer: true
    content: |
      [Unit]
      Description=Restart Chromium kiosk browser

      [Service]
      Type=oneshot
      ExecStart=/usr/bin/systemctl --user restart chromium-kiosk.service

  - path: /home/@USERNAME@/.config/systemd/user/chromium-restart.timer
    owner: "@USERNAME@:@USERNAME@"
    permissions: "0644"
    defer: true
    content: |
      [Unit]
      Description=Restart Chromium kiosk nightly

      [Timer]
      OnCalendar=daily
      RandomizedDelaySec=30

      [Install]
      WantedBy=timers.target

  - path: /home/@USERNAME@/.config/systemd/user/chromium-watchdog.service
    owner: "@USERNAME@:@USERNAME@"
    permissions: "0644"
    defer: true
    content: |
      [Unit]
      Description=Restart Chromium kiosk if it is stuck on an error page

      [Service]
      Type=oneshot
      ExecStart=/usr/local/bin/kiosk-watchdog

  - path: /home/@USERNAME@/.config/systemd/user/chromium-watchdog.timer
    owner: "@USERNAME@:@USERNAME@"
    permissions: "0644"
    defer: true
    content: |
      [Unit]
      Description=Check the Chromium kiosk every 5 minutes

      [Timer]
      OnBootSec=10min
      OnUnitActiveSec=5min

      [Install]
      WantedBy=timers.target

  - path: /usr/local/bin/kiosk-watchdog
    owner: "root:root"
    permissions: "0755"
    content: |
      #!/usr/bin/env python3
      """Restart the kiosk browser unless it shows a live page from the kiosk URL.

      Chromium's own error pages (no network yet, an upstream 5xx) and a crashed
      renderer ("Aw, Snap!") otherwise stay on screen until the nightly restart.
      A page counts as live when it is on the kiosk URL's origin and its renderer
      answers a script evaluation over the local DevTools port. A second check a
      minute later keeps a page that is merely mid-load from triggering a restart.
      """

      import base64
      import json
      import os
      import socket
      import struct
      import subprocess
      import time
      import urllib.request
      from pathlib import Path
      from urllib.parse import urlsplit

      DEVTOOLS = "http://127.0.0.1:9222"
      URL_FILE = Path("/boot/firmware/kiosk-url.txt")
      DEFAULT_URL = "@URL@"
      UNIT = "chromium-kiosk.service"


      def kiosk_origin() -> str:
          url = URL_FILE.read_text().strip() if URL_FILE.exists() else DEFAULT_URL
          parts = urlsplit(url)
          return f"{parts.scheme}://{parts.netloc}/"


      def recv_exact(sock: socket.socket, n: int, buf: bytes) -> tuple[bytes, bytes]:
          while len(buf) < n:
              chunk = sock.recv(4096)
              if not chunk:
                  raise ConnectionError("DevTools socket closed")
              buf += chunk
          return buf[:n], buf[n:]


      def renderer_answers(ws_url: str) -> bool:
          """Evaluate 1 + 1 in the page over a minimal websocket client."""
          parts = urlsplit(ws_url)
          with socket.create_connection((parts.hostname, parts.port), timeout=10) as sock:
              key = base64.b64encode(os.urandom(16)).decode()
              sock.sendall(
                  f"GET {parts.path} HTTP/1.1\r\nHost: {parts.netloc}\r\n"
                  "Upgrade: websocket\r\nConnection: Upgrade\r\n"
                  f"Sec-WebSocket-Key: {key}\r\nSec-WebSocket-Version: 13\r\n\r\n".encode()
              )
              buf = b""
              while b"\r\n\r\n" not in buf:
                  chunk = sock.recv(4096)
                  if not chunk:
                      raise ConnectionError("DevTools socket closed")
                  buf += chunk
              head, buf = buf.split(b"\r\n\r\n", 1)
              if b" 101 " not in head.split(b"\r\n", 1)[0]:
                  return False

              msg = json.dumps(
                  {
                      "id": 1,
                      "method": "Runtime.evaluate",
                      "params": {"expression": "1 + 1", "returnByValue": True},
                  }
              ).encode()
              mask = os.urandom(4)
              length = (
                  bytes([0x80 | len(msg)])
                  if len(msg) < 126
                  else bytes([0x80 | 126]) + struct.pack(">H", len(msg))
              )
              masked = bytes(b ^ mask[i % 4] for i, b in enumerate(msg))
              sock.sendall(bytes([0x81]) + length + mask + masked)

              while True:
                  header, buf = recv_exact(sock, 2, buf)
                  n = header[1] & 0x7F
                  if n == 126:
                      ext, buf = recv_exact(sock, 2, buf)
                      n = struct.unpack(">H", ext)[0]
                  elif n == 127:
                      ext, buf = recv_exact(sock, 8, buf)
                      n = struct.unpack(">Q", ext)[0]
                  payload, buf = recv_exact(sock, n, buf)
                  if header[0] & 0x0F != 1:
                      continue
                  reply = json.loads(payload)
                  if reply.get("id") == 1:
                      return reply.get("result", {}).get("result", {}).get("value") == 2


      def healthy() -> bool:
          origin = kiosk_origin()
          try:
              with urllib.request.urlopen(f"{DEVTOOLS}/json/list", timeout=5) as resp:
                  targets = json.load(resp)
              return any(
                  renderer_answers(t["webSocketDebuggerUrl"])
                  for t in targets
                  if t.get("type") == "page"
                  and t.get("url", "").startswith(origin)
                  and "webSocketDebuggerUrl" in t
              )
          except (OSError, ValueError):
              return False


      def main() -> None:
          active = subprocess.run(["systemctl", "--user", "is-active", "--quiet", UNIT])
          if active.returncode != 0 or healthy():
              return
          time.sleep(60)
          if healthy():
              return
          print("kiosk not showing a live page from the kiosk URL; restarting")
          subprocess.run(["systemctl", "--user", "restart", UNIT], check=True)


      if __name__ == "__main__":
          main()

  - path: /usr/local/bin/kiosk-set-url
    owner: "root:root"
    permissions: "0755"
    content: |
      #!/bin/bash
      # Show or update the kiosk URL (takes effect on next Chromium restart).
      f=/boot/firmware/kiosk-url.txt
      if [ $# -eq 0 ]; then
          echo "Usage: sudo kiosk-set-url <url>"
          echo "Current URL: $(cat "$f" 2>/dev/null || echo "not set")"
          exit 1
      fi
      echo "$1" > "$f"
      echo "✓ URL updated. Restart the browser (or reboot) to apply:"
      echo "  systemctl --user restart chromium-kiosk.service"
@ENTERPRISE_WIFI@

runcmd:
  - systemctl enable --now ssh
  - rm -f /etc/xdg/autostart/piwiz.desktop
  # autologin to the graphical desktop (B4 targets the first regular user)
  - raspi-config nonint do_boot_behaviour B4
@WIFI_CMDS@
  # enable the kiosk user units without a running user manager
  - install -d -o @USERNAME@ -g @USERNAME@ /home/@USERNAME@/.config/systemd/user/default.target.wants /home/@USERNAME@/.config/systemd/user/timers.target.wants
  - ln -sf ../chromium-kiosk.service /home/@USERNAME@/.config/systemd/user/default.target.wants/chromium-kiosk.service
  - ln -sf ../chromium-restart.timer /home/@USERNAME@/.config/systemd/user/timers.target.wants/chromium-restart.timer
  - ln -sf ../chromium-watchdog.timer /home/@USERNAME@/.config/systemd/user/timers.target.wants/chromium-watchdog.timer
  - chown -h @USERNAME@:@USERNAME@ /home/@USERNAME@/.config/systemd/user/default.target.wants/chromium-kiosk.service /home/@USERNAME@/.config/systemd/user/timers.target.wants/chromium-restart.timer /home/@USERNAME@/.config/systemd/user/timers.target.wants/chromium-watchdog.timer
  # hide the cursor: no Wayland-native option, so blank the theme's pointer
  - if [ -f /usr/share/icons/PiXflat/cursors/left_ptr ]; then mv /usr/share/icons/PiXflat/cursors/left_ptr /usr/share/icons/PiXflat/cursors/left_ptr.bak; fi
@TAILSCALE_CMDS@

# The kiosk pieces (autologin, deferred user files, unit enablement) land
# after the first-boot desktop session has already logged in, so the browser
# only autostarts from the next boot --- reboot into a working kiosk rather
# than leaving a bare desktop up.
power_state:
  mode: reboot
  message: pi-kiosk first-boot config complete; rebooting into the kiosk

final_message: "pi-kiosk setup complete after $UPTIME seconds"
EOF

    # --- conditional sections -------------------------------------------
    local ssh_keys=""
    if [[ -n "$ssh_key_file" ]]; then
        ssh_keys=$'    ssh_authorized_keys:\n      - |\n          '"$(cat "$ssh_key_file")"
    fi

    local enterprise_wifi=""
    if [[ -n "$wifi_enterprise_user" ]]; then
        IFS= read -r -d '' enterprise_wifi <<'EOF' || true

  - path: /etc/ssl/certs/kiosk-wifi-ca.pem
    owner: "root:root"
    permissions: "0644"
    encoding: b64
    content: @WIFI_CA_CERT@

  - path: /etc/NetworkManager/system-connections/@WIFI_SSID@.nmconnection
    owner: "root:root"
    permissions: "0600"
    content: |
      [connection]
      id=@WIFI_SSID@
      type=wifi
      interface-name=wlan0
      autoconnect=true

      [wifi]
      mode=infrastructure
      ssid=@WIFI_SSID@

      [wifi-security]
      key-mgmt=wpa-eap

      [802-1x]
      eap=peap
      identity=@WIFI_ENTERPRISE_USER@
      password=@WIFI_ENTERPRISE_PASS@
      phase2-auth=mschapv2
      ca-cert=/etc/ssl/certs/kiosk-wifi-ca.pem
      domain-suffix-match=@WIFI_DOMAIN_SUFFIX@

      [ipv4]
      method=auto

      [ipv6]
      method=auto
EOF
    fi

    local wifi_cmds=""
    if [[ -n "$wifi_ssid" ]]; then
        wifi_cmds="  - rfkill unblock wifi || true
  - raspi-config nonint do_wifi_country @WIFI_COUNTRY@ || true
  # pick up connection files written after NetworkManager started
  - nmcli connection reload || true"
    fi

    local tailscale_cmds=""
    if [[ -n "$tailscale_authkey" ]]; then
        IFS= read -r -d '' tailscale_cmds <<'EOF' || true
  # a cold Pi's clock is stuck at the image build date, which makes TLS cert
  # validation fail --- wait for NTP before fetching the installer
  - timeout 300 sh -c 'until timedatectl show -p NTPSynchronized --value | grep -q yes; do sleep 2; done' || true
  # download to a file, then run: `curl | sh` reports success on an empty
  # download, which would break out of the retry loop with nothing installed
  - for i in $(seq 1 30); do curl -fsSL https://tailscale.com/install.sh -o /tmp/tailscale-install.sh && sh /tmp/tailscale-install.sh && break; sleep 10; done
  - tailscale up --authkey=@TAILSCALE_AUTHKEY@ --ssh --hostname=@HOSTNAME@ --accept-dns=false
EOF
        tailscale_cmds="${tailscale_cmds%$'\n'}"
    fi

    # --- substitution ----------------------------------------------------
    ud="${ud//@SSH_KEYS@/$ssh_keys}"
    ud="${ud//@ENTERPRISE_WIFI@/$enterprise_wifi}"
    ud="${ud//@WIFI_CMDS@/$wifi_cmds}"
    ud="${ud//@TAILSCALE_CMDS@/$tailscale_cmds}"
    ud="${ud//@HOSTNAME@/$hostname}"
    ud="${ud//@USERNAME@/$username}"
    ud="${ud//@PASSWD_HASH@/$passwd_hash}"
    ud="${ud//@LOCK_PASSWD@/$lock_passwd}"
    ud="${ud//@TIMEZONE@/$timezone}"
    ud="${ud//@URL@/$url}"
    ud="${ud//@WIFI_SSID@/$wifi_ssid}"
    ud="${ud//@WIFI_ENTERPRISE_USER@/$wifi_enterprise_user}"
    ud="${ud//@WIFI_ENTERPRISE_PASS@/$wifi_enterprise_pass}"
    ud="${ud//@WIFI_CA_CERT@/$wifi_ca_data}"
    ud="${ud//@WIFI_DOMAIN_SUFFIX@/$wifi_domain_suffix}"
    ud="${ud//@WIFI_COUNTRY@/$wifi_country}"
    ud="${ud//@TAILSCALE_AUTHKEY@/$tailscale_authkey}"

    printf '%s\n' "$ud" >"$out"
}

# WPA2-PSK wifi goes in network-config (netplan v2); enterprise wifi is
# handled by the nmconnection file in user-data instead. Without wifi the
# stock file is left alone --- ethernet DHCP works out of the box.
generate_network_config() {
    local out="$1"
    [[ -n "$wifi_ssid" && -z "$wifi_enterprise_user" ]] || return 0
    local nc
    IFS= read -r -d '' nc <<'EOF' || true
version: 2
wifis:
  wlan0:
    dhcp4: true
    optional: true
    access-points:
      "@WIFI_SSID@":
        password: "@WIFI_PASSWORD@"
EOF
    nc="${nc//@WIFI_SSID@/$wifi_ssid}"
    nc="${nc//@WIFI_PASSWORD@/$wifi_password}"
    printf '%s\n' "$nc" >"$out"
}

# ---------------------------------------------------------------------------

main() {
    local url="" hostname="pi-kiosk" username="kiosk" password=""
    local wifi_ssid="" wifi_password="" wifi_enterprise_user="" wifi_enterprise_pass=""
    local wifi_ca_cert="" wifi_domain_suffix="" wifi_ca_data=""
    local wifi_country="AU" tailscale_authkey="" tailscale_tag="" ssh_key_file="" device="" test_mode=false

    (($# > 0)) || usage 0
    while (($# > 0)); do
        case "$1" in
        --url) url="$2"; shift 2 ;;
        --hostname) hostname="$2"; shift 2 ;;
        --username) username="$2"; shift 2 ;;
        --password) password="$2"; shift 2 ;;
        --ssh-key) ssh_key_file="$2"; shift 2 ;;
        --wifi-ssid) wifi_ssid="$2"; shift 2 ;;
        --wifi-password) wifi_password="$2"; shift 2 ;;
        --wifi-enterprise-user) wifi_enterprise_user="$2"; shift 2 ;;
        --wifi-enterprise-pass) wifi_enterprise_pass="$2"; shift 2 ;;
        --wifi-ca-cert) wifi_ca_cert="$2"; shift 2 ;;
        --wifi-domain-suffix) wifi_domain_suffix="$2"; shift 2 ;;
        --wifi-country) wifi_country="$2"; shift 2 ;;
        --tailscale-authkey) tailscale_authkey="$2"; shift 2 ;;
        --tailscale-tag) tailscale_tag="$2"; shift 2 ;;
        --device) device="$2"; shift 2 ;;
        --test) test_mode=true; shift ;;
        -h | --help) usage 0 ;;
        *) die "unknown option: $1 (see --help)" ;;
        esac
    done

    # --- validation ------------------------------------------------------
    [[ "$OSTYPE" == linux-gnu* ]] || die "Linux only (needs lsblk/dd on raw devices)"
    [[ -n "$url" ]] || die "--url is required"
    [[ "$url" =~ ^https?:// ]] || die "invalid URL: $url"
    if [[ -n "$wifi_ssid" ]]; then
        if [[ -n "$wifi_enterprise_user" || -n "$wifi_enterprise_pass" ]]; then
            [[ -n "$wifi_enterprise_user" && -n "$wifi_enterprise_pass" ]] ||
                die "enterprise wifi needs both --wifi-enterprise-user and --wifi-enterprise-pass"
            [[ -n "$wifi_ca_cert" && -n "$wifi_domain_suffix" ]] ||
                die "enterprise wifi requires --wifi-ca-cert and --wifi-domain-suffix from your network administrator"
        else
            [[ -n "$wifi_password" ]] || die "--wifi-password required for WPA2-PSK"
        fi
    fi
    [[ -n "$ssh_key_file" && -f "$ssh_key_file" ]] ||
        die "--ssh-key must name an SSH public key file; password SSH login is disabled"
    if [[ -n "$tailscale_tag" ]]; then
        [[ -z "$tailscale_authkey" ]] || die "pass --tailscale-tag or --tailscale-authkey, not both"
        [[ -n "${TS_OAUTH_CLIENT_ID:-}" && -n "${TS_OAUTH_CLIENT_SECRET:-}" ]] ||
            die "--tailscale-tag needs TS_OAUTH_CLIENT_ID and TS_OAUTH_CLIENT_SECRET in the environment"
        command -v jq >/dev/null 2>&1 || die "--tailscale-tag needs jq"
    fi
    check_required_tools

    local ssh_public_key
    ssh_public_key=$(cat "$ssh_key_file")
    if [[ "$ssh_public_key" == *$'\n'* || ! "$ssh_public_key" =~ ^(ssh-|ecdsa-|sk-) ]] ||
        ! ssh-keygen -l -f "$ssh_key_file" >/dev/null 2>&1; then
        die "--ssh-key must contain one valid SSH public key, not a private key"
    fi
    if [[ -n "$wifi_enterprise_user" ]]; then
        [[ -n "$wifi_ssid" ]] || die "enterprise wifi requires --wifi-ssid"
        [[ -f "$wifi_ca_cert" ]] || die "WiFi CA certificate not found: $wifi_ca_cert"
        [[ "$wifi_domain_suffix" =~ ^[a-zA-Z0-9]([a-zA-Z0-9-]*[a-zA-Z0-9])?(\.[a-zA-Z0-9]([a-zA-Z0-9-]*[a-zA-Z0-9])?)+$ ]] ||
            die "--wifi-domain-suffix must be the RADIUS server's DNS domain"
        openssl x509 -in "$wifi_ca_cert" -noout >/dev/null 2>&1 ||
            die "--wifi-ca-cert must be a valid PEM CA certificate"
        wifi_ca_data=$(base64 <"$wifi_ca_cert" | tr -d '\n')
    fi

    local passwd_hash="!" lock_passwd=true timezone
    if [[ -n "$password" ]]; then
        passwd_hash=$(printf '%s\n' "$password" | openssl passwd -6 -stdin)
        lock_passwd=false
    fi
    timezone=$(timedatectl show --property=Timezone --value 2>/dev/null || echo UTC)

    # --- show config -----------------------------------------------------
    info "pi-kiosk"
    echo "  URL:       $url"
    echo "  Hostname:  $hostname"
    echo "  User:      $username"
    echo "  Timezone:  $timezone"
    if [[ -n "$wifi_ssid" ]]; then
        echo "  WiFi:      $wifi_ssid ($([[ -n "$wifi_enterprise_user" ]] && echo "802.1X as $wifi_enterprise_user" || echo WPA2-PSK), country $wifi_country)"
    else
        echo "  WiFi:      none (ethernet)"
    fi
    if [[ -n "$tailscale_tag" ]]; then
        echo "  Tailscale: minted key, $tailscale_tag"
    else
        echo "  Tailscale: $([[ -n "$tailscale_authkey" ]] && echo "given key" || echo no)"
    fi
    echo "  SSH key:   ${ssh_key_file:-none}"
    echo

    local work
    work=$(mktemp -d -t pi-kiosk-XXXXX)

    if [[ "$test_mode" == true ]]; then
        [[ -z "$tailscale_tag" ]] || tailscale_authkey="tskey-auth-TEST-PLACEHOLDER"
        generate_user_data "$work/user-data"
        generate_network_config "$work/network-config"
        printf '%s\n' "$url" >"$work/kiosk-url.txt"
        warn "TEST MODE: config generated in $work (not flashing)"
        ls -l "$work"
        exit 0
    fi

    # --- flash -----------------------------------------------------------
    [[ -n "$device" ]] || device=$(find_sd_card)
    [[ -b "$device" ]] || die "not a block device: $device"

    warn "WARNING: this will ERASE all data on $device"
    lsblk -d -o NAME,SIZE,MODEL "$device"
    local confirm
    read -r -p "Continue? (yes/no): " confirm
    [[ "$confirm" == yes ]] || { echo "Aborted."; rm -rf "$work"; exit 0; }

    # Mint before erasing anything, so an API failure leaves the card as it was.
    local ts_bearer=""
    if [[ -n "$tailscale_tag" ]]; then
        ts_bearer=$(ts_token) || die "Tailscale OAuth token request failed"
        tailscale_authkey=$(ts_mint_authkey "$ts_bearer" "$tailscale_tag" "$hostname") ||
            die "Tailscale auth key mint failed (does the OAuth client own $tailscale_tag?)"
        info "✓ Minted single-use Tailscale auth key"
    fi

    generate_user_data "$work/user-data"
    generate_network_config "$work/network-config"
    printf '%s\n' "$url" >"$work/kiosk-url.txt"

    local image
    image=$(fetch_image)
    flash_image "$image" "$device"

    # --- drop cloud-init config on the boot partition ---------------------
    local part mnt
    part=$(boot_partition "$device")
    mnt=$(mktemp -d -t pi-kiosk-boot-XXXXX)
    sudo mount "$part" "$mnt"
    sudo cp "$work/user-data" "$mnt/user-data"
    [[ -f "$work/network-config" ]] && sudo cp "$work/network-config" "$mnt/network-config"
    sudo cp "$work/kiosk-url.txt" "$mnt/kiosk-url.txt"
    sudo umount "$mnt"
    rmdir "$mnt"
    rm -rf "$work"
    sync

    [[ -z "$ts_bearer" ]] || ts_remove_stale_nodes "$ts_bearer" "$tailscale_tag" "$hostname"

    info "✓ SD card ready --- eject it and boot the Pi."
    echo
    echo "First boot takes a few minutes (cloud-init + Tailscale install)."
    if [[ -n "$tailscale_authkey" ]]; then
        echo "Then: tailscale ssh $username@$hostname"
    fi
    echo "Change the URL later with: sudo kiosk-set-url <url>  (or edit kiosk-url.txt on the card)"
}

main "$@"

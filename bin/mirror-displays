#!/usr/bin/env bash
#
# mirror-displays: mirror every connected external display onto the MacBook's
# built-in screen (no extended desktop), with the largest-native external as
# the primary so the audience-facing screen dictates resolution and aspect.
#
# The point is to be safe to run blind: it inspects what is actually connected
# and degrades to a no-op rather than guessing. Concretely:
#
#   - only the built-in present        -> nothing to mirror, exit 0
#   - built-in inactive (clamshell)    -> leave the arrangement alone, exit 0
#   - one external missing             -> mirror whichever ones are there
#   - displayplacer absent or its      -> exit 1 without touching anything
#     output unparseable
#
# The applied command is `displayplacer "id:A+B+C res:WxH ..."`. Left alone,
# a mirror set inherits the primary's mode, and MacBook panels aren't 16:9,
# so leading with the built-in pillarboxes the externals (the screens the
# audience actually sees). Instead the external with the largest native panel
# leads the chain as the primary (list order is arbitrary, and would happily
# put a 1080p pen display ahead of a 4K projector): displayplacer validates
# res against the primary only, and macOS then fits every secondary into the
# mirror as best it can --- downscaling/letterboxing the built-in and any
# smaller external, which beats capping the audience-facing screen.
#
# The chosen res is the primary's native (largest) mode, except on 4K-class
# panels where the half-native HiDPI mode is preferred when offered: it sends
# the same full-resolution signal to the display but keeps UI at a sane size
# (a 4K projector runs "looks like 1920x1080" rendered at 3840x2160). Some
# listed modes are refused at apply time (e.g. a MacBook panel's TV-style
# 1080p modes when primary), so if the res-qualified command fails, retry the
# bare id chain, which leaves all resolutions at their current values rather
# than wedging anything into an unsupported mode.
#
# Requires displayplacer (`brew install displayplacer`). macOS only.

set -euo pipefail

if [[ "$(uname)" != "Darwin" ]]; then
  echo "mirror-displays: macOS only" >&2
  exit 1
fi

# Don't trust the caller's PATH (launchd and non-interactive ssh don't carry
# /opt/homebrew/bin) --- the same trap that silently broke ship-claude-logs.
displayplacer_bin="$(command -v displayplacer || true)"
if [[ -z "$displayplacer_bin" && -x /opt/homebrew/bin/displayplacer ]]; then
  displayplacer_bin=/opt/homebrew/bin/displayplacer
fi
if [[ -z "$displayplacer_bin" ]]; then
  echo "mirror-displays: displayplacer not found (brew install displayplacer)" >&2
  exit 1
fi

list_output="$("$displayplacer_bin" list)"

# One block of key/value lines per screen, blank-line separated; the trailing
# "run this to recreate the current arrangement" paragraph has no persistent
# id, so it's dropped by the id=="" guard. The fourth field is the screen's
# supported modes ("WxH/on" or "WxH/off" by HiDPI scaling, deduped across hz
# variants) as a comma-separated list.
screens="$(awk '
  BEGIN { RS=""; FS="\n" }
  {
    id = ""; type = ""; enabled = "true"; reslist = ""
    split("", seen)
    for (i = 1; i <= NF; i++) {
      if ($i ~ /^Persistent screen id: /)  { sub(/^Persistent screen id: /, "", $i); id = $i }
      else if ($i ~ /^Type: /)             { sub(/^Type: /, "", $i); type = $i }
      else if ($i ~ /^Enabled: /)          { sub(/^Enabled: /, "", $i); enabled = $i }
      else if ($i ~ /^ *mode [0-9]+: res:[0-9]+x[0-9]+/) {
        r = $i
        sub(/^ *mode [0-9]+: res:/, "", r)
        sub(/ .*/, "", r)
        key = r "/" ($i ~ / scaling:on/ ? "on" : "off")
        if (!(key in seen)) {
          seen[key] = 1
          reslist = reslist (reslist == "" ? "" : ",") key
        }
      }
    }
    if (id != "") print id "\t" type "\t" enabled "\t" reslist
  }
' <<<"$list_output")"

if [[ -z "$screens" ]]; then
  echo "mirror-displays: couldn't parse 'displayplacer list' output; changing nothing" >&2
  exit 1
fi

builtin_id=""
external_ids=()
external_res=()
while IFS=$'\t' read -r id type enabled reslist; do
  [[ "$enabled" == "true" ]] || continue
  if [[ "$type" == *"built in"* ]]; then
    builtin_id="$id"
  else
    external_ids+=("$id")
    external_res+=("$reslist")
  fi
done <<<"$screens"

if [[ -z "$builtin_id" ]]; then
  echo "built-in display not active (clamshell mode?); leaving arrangement untouched"
  exit 0
fi

if (( ${#external_ids[@]} == 0 )); then
  echo "no external displays connected; nothing to mirror"
  exit 0
fi

# Prints "W H" for the largest mode by area in a "WxH/on,WxH/off,..." list
# (the display's native resolution); prints nothing if the list is empty.
native_res() {
  tr ',' '\n' <<<"$1" | awk -F'[x/]' '
    NF >= 2 && $1 * $2 > best { best = $1 * $2; w = $1; h = $2 }
    END { if (best) print w, h }
  '
}

# The external with the largest native panel becomes the mirror set's
# primary; res is validated against (and applied to) the primary alone.
primary_idx=0
primary_area=0
for i in "${!external_ids[@]}"; do
  read -r w h <<<"$(native_res "${external_res[$i]}")"
  [[ -n "${w:-}" ]] || continue
  if ((w * h > primary_area)); then
    primary_area=$((w * h))
    primary_idx=$i
  fi
done

chain="${external_ids[$primary_idx]}+$builtin_id"
for i in "${!external_ids[@]}"; do
  ((i == primary_idx)) && continue
  chain+="+${external_ids[$i]}"
done

# Native mode by default; on 4K-class panels prefer the half-native HiDPI
# mode (Apple's "Retina 2x" default) when the display offers it --- same
# signal resolution, sane UI size.
target=""
read -r w h <<<"$(native_res "${external_res[$primary_idx]}")"
if [[ -n "${w:-}" ]]; then
  if ((w * h >= 3840 * 2160)) &&
    [[ ",${external_res[$primary_idx]}," == *",$((w / 2))x$((h / 2))/on,"* ]]; then
    target="res:$((w / 2))x$((h / 2)) scaling:on"
  else
    target="res:${w}x${h}"
  fi
fi

if [[ -n "$target" ]]; then
  echo "mirroring ${#external_ids[@]} external display(s), primary external at $target"
  if "$displayplacer_bin" "id:$chain $target"; then
    exit 0
  fi
  echo "mirror-displays: $target refused; retrying at current resolutions" >&2
fi

echo "mirroring ${#external_ids[@]} external display(s) at current resolutions"
if ! "$displayplacer_bin" "id:$chain"; then
  echo "mirror-displays: displayplacer failed; arrangement left as-is" >&2
  exit 1
fi

#!/usr/bin/env bash
#
# The one place mail config reads and writes secrets, so mbsyncrc, msmtprc
# and mail-utils can be identical on every host:
#
#   mail-secret get <account> <service>            print the secret
#   mail-secret set <account> <service>            store a secret: prompts at
#                                                  a terminal, else reads stdin
#   mail-secret oauth <name> [mutt_oauth2 args]    print a fresh OAuth2 access
#                                                  token, refreshing if needed
#
# The <account>/<service> pair is the macOS keychain's addressing, kept on
# both platforms so the existing keychain items on the Mac carry over
# unchanged. Backends:
#
#   macOS  login keychain via `security` (never the iCloud keychain, which
#          the CLI cannot read --- add items with `set`, not the Passwords app)
#   Linux  mode-0600 files under $XDG_STATE_HOME/mail-secret, one per
#          service. Files rather than the mise [env] block because the
#          OAuth2 token is rewritten on every refresh, which a config file
#          can't accommodate, and one store beats two.
#
# `oauth` wraps mail/mutt_oauth2.py with this script as both its encryption
# and decryption pipe. mutt_oauth2 insists on a token *file*, so it gets an
# empty 0600 stub in the state dir: the encryption pipe stores the JSON in
# the backend and prints nothing, so the stub stays empty, and the decryption
# pipe ignores its (empty) stdin and reads the backend back. Pass
# `--authorize --authflow devicecode` to (re)authorise --- devicecode needs
# no browser on this host, so it works over ssh.

set -euo pipefail

self="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"
dotfiles="$(dirname "$(dirname "$self")")"
state="${XDG_STATE_HOME:-$HOME/.local/state}/mail-secret"

usage() {
    sed -n '3,/^$/p' "$self" | sed 's/^# \{0,1\}//' >&2
    exit 2
}

# Thunderbird's client id: a public client that ANU's tenant permits, so no
# client secret is needed (the empty stdin below answers that prompt).
ANU_CLIENT_ID="9e5f94bc-e8a4-4e73-b8be-63364c29d753"

get() {
    local account="$1" service="$2"
    if [[ "$(uname -s)" == Darwin ]]; then
        security find-generic-password -a "$account" -s "$service" -w
    else
        cat "$state/$service"
    fi
}

set_() {
    local account="$1" service="$2" value
    if [[ -t 0 ]]; then
        read -rs -p "$service secret for $account (not echoed): " value
        echo >&2
    else
        value="$(cat)"
    fi
    [[ -n "$value" ]] || { echo "mail-secret: refusing to store an empty secret" >&2; exit 1; }
    if [[ "$(uname -s)" == Darwin ]]; then
        security add-generic-password -U -a "$account" -s "$service" -w "$value"
    else
        (umask 077 && mkdir -p "$state" && printf '%s' "$value" > "$state/$service.tmp")
        mv -f "$state/$service.tmp" "$state/$service"
    fi
}

oauth() {
    local name="$1"
    shift
    local email service provider
    case "$name" in
    anu)
        email="u2548636@anu.edu.au"
        service="mutt_oauth2_anu"
        provider="microsoft"
        ;;
    *) echo "mail-secret: unknown oauth name '$name'" >&2; exit 2 ;;
    esac

    local stub="$state/oauth-$name.stub"
    if [[ ! -e "$stub" ]]; then
        (umask 077 && mkdir -p "$state" && : > "$stub")
    fi

    local authorize=false
    local arg
    for arg in "$@"; do
        [[ "$arg" == "--authorize" || "$arg" == "-a" ]] && authorize=true
    done

    local cmd=(
        "$dotfiles/mail/mutt_oauth2.py"
        --provider "$provider" --email "$email" --client-id "$ANU_CLIENT_ID"
        --decryption-pipe "$self get $email $service"
        --encryption-pipe "$self set $email $service"
        "$@" "$stub"
    )
    if [[ "$authorize" == true ]]; then
        echo "" | "${cmd[@]}"
    else
        "${cmd[@]}"
    fi
}

[[ $# -ge 1 ]] || usage
case "$1" in
get) [[ $# -eq 3 ]] || usage; get "$2" "$3" ;;
set) [[ $# -eq 3 ]] || usage; set_ "$2" "$3" ;;
oauth) [[ $# -ge 2 ]] || usage; shift; oauth "$@" ;;
*) usage ;;
esac

#!/usr/bin/env bash
# Claude Code hook: send a Pushover notification when a long turn ends.
#
# UserPromptSubmit calls `start`; Stop calls `stop`. Both receive the hook
# payload as JSON on stdin. The threshold defaults to 300s (5 min); override it
# with CLAUDE_NOTIFY_THRESHOLD. Notifications are tagged "host:project", the
# project being the cwd basename from the payload.
#
# Nothing here may fail loudly: a hook that exits non-zero surfaces as an
# error inside Claude Code, so notification delivery is best-effort.

set -euo pipefail

cmd="${1:-}"
threshold_seconds="${CLAUDE_NOTIFY_THRESHOLD:-300}"
stamp_dir="${TMPDIR:-/tmp}"

input=$(cat)
sid=$(echo "$input" | jq -r '.session_id // empty')
[[ -n "$sid" ]] || exit 0

stamp_file="$stamp_dir/claude-turn-$sid"

case "$cmd" in
    start)
        date +%s > "$stamp_file"
        ;;
    stop)
        [[ -f "$stamp_file" ]] || exit 0
        start=$(cat "$stamp_file")
        rm -f "$stamp_file"
        elapsed=$(( $(date +%s) - start ))
        (( elapsed >= threshold_seconds )) || exit 0
        cwd=$(echo "$input" | jq -r '.cwd // empty')
        proj="${cwd##*/}"
        [[ -n "$proj" ]] || proj="?"
        minutes=$((elapsed / 60))
        seconds=$((elapsed % 60))
        msg=$(printf 'Turn finished in %dm %02ds' "$minutes" "$seconds")
        transcript=$(echo "$input" | jq -r '.transcript_path // empty')
        if [[ -n "$transcript" && -f "$transcript" ]]; then
            title=$(jq -r 'select(.type=="ai-title") | .aiTitle' "$transcript" 2>/dev/null | tail -n1)
            [[ -n "$title" ]] && msg="${msg}"$'\n'"${title}"
        fi
        echo "$msg" | notify-pushover --title "Claude done: $(hostname -s):$proj" || true
        ;;
    *)
        echo "Usage: $(basename "$0") {start|stop}" >&2
        exit 1
        ;;
esac

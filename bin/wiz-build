#!/usr/bin/env bash
# wiz-build --- build and install the wiz engine from source, at its main.
#
# Collaborators install wiz from the build the lx vault pins (its
# admin/tools/wiz-install, into ~/.wiz/bin). Ben's machines don't: each vault
# would pin its own version into the one install, and the engine reads every
# older vault format anyway, so one build of the engine's main serves every
# vault in the registry, ahead of any release. It goes into ~/.local/bin/wiz,
# ahead of nothing else. That includes watson, which runs the lx automation and
# reads the engine with a read-only deploy key (~/.ssh/wiz-engine-deploy, set as
# its checkout's core.sshCommand).
#
# The engine repo is cloned to $WIZ_SRC and built with the Go its mise.toml
# names. The version wiz reports carries the commit (`v1.0.0-3-g63b7857`),
# which is how --check knows what is installed. An unchanged main makes this a
# no-op, so `dotfiles update` only pays for a build when the engine changes.
#
# Usage:
#   wiz-build              build and install the engine's main (no-op if current)
#   wiz-build --force      rebuild even when main is installed
#   wiz-build --check      report status only; non-zero if not on main as last fetched
#   wiz-build --no-test    skip the engine's tests, and tests/test_todo_wiz.py after
set -euo pipefail

DOTFILES_DIR="${DOTFILES_DIR:-$HOME/.dotfiles}"
source "$DOTFILES_DIR/lib/log.sh"

WIZ_SRC="${WIZ_SRC:-${XDG_DATA_HOME:-$HOME/.local/share}/wiz-src}"
WIZ_PREFIX="${WIZ_PREFIX:-$HOME/.local}"
REPO_URL="git@gitlab.anu.edu.au:u2548636/wiz-engine.git"
WIZ="$WIZ_PREFIX/bin/wiz"

MODE=build
RUN_TESTS=true
while [[ $# -gt 0 ]]; do
    case "$1" in
    --force) MODE=force ;;
    --check) MODE=check ;;
    --no-test) RUN_TESTS=false ;;
    -h | --help)
        sed -n '/^# Usage:/,/^#   wiz-build --no-test/p' "$0" | sed 's/^# \{0,1\}//'
        exit 0
        ;;
    *)
        error "unknown option: $1"
        exit 1
        ;;
    esac
    shift
done

# `wiz version` on a source build prints "v1.0.0-3-g63b7857a".
installed_rev() {
    [[ -x "$WIZ" ]] || return 1
    "$WIZ" version 2>/dev/null | grep -oE 'g[0-9a-f]{7,}$' | cut -c2-
}

ensure_checkout() {
    if [[ ! -d "$WIZ_SRC/.git" ]]; then
        info "Cloning the wiz engine into $WIZ_SRC"
        git clone -q "$REPO_URL" "$WIZ_SRC"
    fi
    mise trust -q "$WIZ_SRC/mise.toml" >/dev/null 2>&1 || true
}

# The engine's main, fetched now where the network allows, else as last
# fetched.
main_rev() {
    ensure_checkout
    git -C "$WIZ_SRC" fetch -q --prune --tags origin ||
        warn "couldn't fetch the engine; using main as last fetched" >&2
    git -C "$WIZ_SRC" rev-parse origin/main
}

build() {
    local rev="$1"
    ensure_checkout
    if ! git -C "$WIZ_SRC" cat-file -e "${rev}^{commit}" 2>/dev/null; then
        git -C "$WIZ_SRC" fetch -q --prune --tags origin
    fi
    git -C "$WIZ_SRC" -c advice.detachedHead=false checkout -q "$rev"
    local version
    version="$(git -C "$WIZ_SRC" describe --tags --always --long --abbrev=10 "$rev")"
    if [[ "$RUN_TESTS" == true ]]; then
        info "Testing wiz $version"
        (cd "$WIZ_SRC" && mise exec -- go test ./... >/dev/null) || {
            error "the engine's tests fail at $rev; not installing it"
            return 1
        }
    fi
    info "Building wiz $version"
    mkdir -p "$WIZ_PREFIX/bin"
    (cd "$WIZ_SRC" && CGO_ENABLED=0 mise exec -- go build -trimpath \
        -ldflags "-s -w -X main.version=$version" -o "$WIZ.new" .)
    mv -f "$WIZ.new" "$WIZ"
}

# bin/todo drives the wiz CLI, so a new engine has to pass its suite too.
run_tests() {
    [[ "$RUN_TESTS" == true ]] || return 0
    local suite="$DOTFILES_DIR/tests/test_todo_wiz.py"
    [[ -x "$suite" ]] || return 0
    info "Running the todo integration tests"
    if ! WIZ="$WIZ" "$suite"; then
        error "bin/todo fails against this wiz; fix bin/todo or the engine"
        return 1
    fi
}

check_shadowing() {
    local found
    found="$(command -v wiz 2>/dev/null || true)"
    if [[ -n "$found" && "$found" != "$WIZ" ]]; then
        warn "PATH resolves wiz to $found, not $WIZ"
        return 1
    fi
}

report() {
    local want got
    want="$(git -C "$WIZ_SRC" rev-parse origin/main 2>/dev/null)" || {
        error "no engine checkout at $WIZ_SRC --- run wiz-build"
        return 1
    }
    got="$(installed_rev || true)"
    if [[ -z "$got" ]]; then
        error "no wiz build at $WIZ"
        return 1
    fi
    if [[ "$want" != "$got"* ]]; then
        error "$WIZ is $got, but the engine's main is ${want:0:10} --- run wiz-build"
        return 1
    fi
    info "wiz $("$WIZ" version) installed at $WIZ"
}

case "$MODE" in
check)
    report && check_shadowing
    ;;
force)
    build "$(main_rev)"
    report
    check_shadowing || true
    run_tests
    ;;
build)
    rev="$(main_rev)"
    installed="$(installed_rev || true)"
    if [[ -n "$installed" && "$rev" == "$installed"* ]]; then
        info "wiz ${rev:0:10} is already installed --- nothing to do"
        check_shadowing || true
        exit 0
    fi
    build "$rev"
    report
    check_shadowing || true
    run_tests
    ;;
esac

#!/usr/bin/env bash
#
# Mail sync script for neomutt + mbsync + mu
# Syncs all email accounts and updates mu index
#
set -euo pipefail

# Colours only at a terminal: launchd appends this to mailsync.log
if [ -t 1 ]; then
    RED='\033[0;31m'
    GREEN='\033[0;32m'
    YELLOW='\033[1;33m'
    NC='\033[0m'
else
    RED='' GREEN='' YELLOW='' NC=''
fi

# Function to print status messages
print_status() {
    echo -e "${GREEN}[$(date '+%H:%M:%S')]${NC} $1"
}

print_error() {
    echo -e "${RED}[$(date '+%H:%M:%S')] ERROR:${NC} $1" >&2
}

print_warning() {
    echo -e "${YELLOW}[$(date '+%H:%M:%S')] WARNING:${NC} $1"
}

# Check dependencies
for cmd in mbsync mu; do
    if ! command -v "$cmd" &> /dev/null; then
        print_error "$cmd is not installed"
        exit 1
    fi
done

# Every Inbox in ~/.mbsyncrc must exist before syncing. A missing maildir
# means a moved or unrestored tree, which Sync All would try to reconcile
# with the server, so exit non-zero and let the timer page.
missing=0
while read -r _ inbox; do
    inbox="${inbox/#\~/$HOME}"
    if [ ! -d "$inbox/cur" ]; then
        print_error "maildir missing: $inbox"
        missing=1
    fi
done < <(grep '^Inbox ' "$HOME/.mbsyncrc")
[ "$missing" -eq 0 ] || exit 1

# Two mbsync runs on the same maildir corrupt its sync state (the task-010
# disaster), and the launchd timer (mailsync-scheduled) can fire while a
# manual `,s` sync is still going --- so every entry point takes this lock.
# noclobber write is atomic, and the file holds the owner's PID so a lock
# left behind by a crashed run is detected and cleared.
LOCKDIR="${XDG_STATE_HOME:-$HOME/.local/state}"
mkdir -p "$LOCKDIR"
LOCKFILE="$LOCKDIR/mailsync.lock"
if ! (set -o noclobber; echo $$ > "$LOCKFILE") 2>/dev/null; then
    otherpid=$(cat "$LOCKFILE" 2>/dev/null || true)
    if [ -n "${otherpid:-}" ] && kill -0 "$otherpid" 2>/dev/null; then
        print_status "Another mailsync (pid $otherpid) is already running; nothing to do"
        exit 0
    fi
    print_warning "Clearing stale lock (pid ${otherpid:-unknown} not running)"
    rm -f "$LOCKFILE"
    if ! (set -o noclobber; echo $$ > "$LOCKFILE") 2>/dev/null; then
        print_status "Another mailsync grabbed the lock first; nothing to do"
        exit 0
    fi
fi
trap 'rm -f "$LOCKFILE"' EXIT

# Track if any sync had errors
sync_errors=0

# Initialize mu if needed
if [ ! -d ~/.cache/mu ]; then
    print_status "Initializing mu database..."
    mu init --maildir "$HOME/Maildir" \
        --my-address u2548636@anu.edu.au \
        --my-address ben.swift@anu.edu.au \
        --my-address phdconvenor.cybernetics@anu.edu.au \
        --my-address adir.hdr.cybernetics@anu.edu.au \
        --my-address lxconvenor.cybernetics@anu.edu.au \
        --my-address benswift@fastmail.com \
        --my-address ben@benswift.me
fi

# mbsync can hang rather than fail, which is the worse of the two: a run that
# never returns holds the lock above, so every subsequent timer fire exits
# "already running", and launchd-run only pages on a non-zero exit --- so
# nothing is sent and mail silently stops arriving. That is not theoretical:
# on 26 Aug 2026 a run sat 16 hours on an ESTABLISHED-but-dead socket to
# fastmail after the machine slept mid-sync, and only a manual look found it.
#
# mbsync's own Timeout (20s by default, 120 for the ANU accounts) does not
# cover this. It bounds connect and data *reads*; a write to a peer that has
# gone away without a RST sits in the retransmit/persist loop indefinitely, and
# no read timeout ever comes due. So cap the wall clock from outside instead.
# A normal run is ~20s, so ten minutes is generous even for a big backlog.
# The cap applies to each channel's mbsync separately.
MBSYNC_TIMEOUT="${MBSYNC_TIMEOUT:-600}"

# GNU coreutils timeout: /usr/bin on Linux, brew's coreutils on macOS. If it
# is missing, sync unguarded rather than not at all --- the outer cap in
# launchd-run still bounds the unattended path.
timeout_bin="$(command -v timeout || command -v gtimeout || true)"
guard=()
if [ -n "$timeout_bin" ]; then
    guard=("$timeout_bin" --kill-after=30 "$MBSYNC_TIMEOUT")
else
    print_warning "coreutils timeout not found; running mbsync unguarded"
fi

# One mbsync per channel, all at once, so a run takes as long as the slowest
# account rather than the sum of them (the Exchange channels run at
# PipelineDepth 1, so each is mostly waiting on round trips). The channels
# share no maildir or sync state, so they can't trip over each other the way
# two runs of the same channel do; the lock above still keeps whole runs
# apart. The Exchange channels all fetch one OAuth token, and
# bin/mail-secret serialises its refresh.
channels=()
while read -r ch; do channels+=("$ch"); done < <(awk '$1 == "Channel" {print $2}' "$HOME/.mbsyncrc")
outdir="$(mktemp -d)"
trap 'rm -f "$LOCKFILE"; rm -rf "$outdir"' EXIT

print_status "Syncing ${#channels[@]} mail accounts in parallel..."
pids=()
for ch in "${channels[@]}"; do
    ${guard[@]+"${guard[@]}"} mbsync "$ch" >"$outdir/$ch" 2>&1 &
    pids+=("$!")
done

# Report in config order, each line tagged with its channel, so the log
# reads the same whichever channel finished first.
for i in "${!channels[@]}"; do
    ch="${channels[$i]}"
    status=0
    wait "${pids[$i]}" || status=$?
    sed "s/^/[$ch] /" "$outdir/$ch"
    if [ "$status" -ne 0 ]; then
        # 124: timeout fired. 137: it had to escalate to SIGKILL 30s later.
        if [ "$status" -eq 124 ] || [ "$status" -eq 137 ]; then
            print_error "$ch: mbsync exceeded ${MBSYNC_TIMEOUT}s and was killed (dead socket?)"
        else
            print_warning "$ch: sync had issues (exit $status)"
        fi
        sync_errors=$((sync_errors + 1))
    fi
done
if [ "$sync_errors" -eq 0 ]; then
    print_status "All accounts synced successfully"
fi

# Update mu index. The progress spinner is for a terminal; from launchd it
# is thousands of log lines a day.
print_status "Updating search index..."
if [ -t 1 ]; then
    mu index
else
    mu index --quiet
fi

# Summary. Exit non-zero on sync errors so launchd-run can page ---
# neomutt's `,s` macro ignores the exit code, so this only feeds the timer.
echo ""
if [ $sync_errors -eq 0 ]; then
    print_status "Mail sync completed successfully!"
else
    print_warning "Mail sync completed with $sync_errors account(s) having issues"
    exit 1
fi

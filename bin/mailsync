#!/usr/bin/env bash
#
# Mail sync script for neomutt + mbsync + mu
# Syncs all email accounts and updates mu index
#
set -euo pipefail

# Colours for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Function to print status messages
print_status() {
    echo -e "${GREEN}[$(date '+%H:%M:%S')]${NC} $1"
}

print_error() {
    echo -e "${RED}[$(date '+%H:%M:%S')] ERROR:${NC} $1" >&2
}

print_warning() {
    echo -e "${YELLOW}[$(date '+%H:%M:%S')] WARNING:${NC} $1"
}

# Check dependencies
for cmd in mbsync mu; do
    if ! command -v "$cmd" &> /dev/null; then
        print_error "$cmd is not installed"
        exit 1
    fi
done

# Two mbsync runs on the same maildir corrupt its sync state (the task-010
# disaster), and the launchd timer (mailsync-scheduled) can fire while a
# manual `,s` sync is still going --- so every entry point takes this lock.
# noclobber write is atomic, and the file holds the owner's PID so a lock
# left behind by a crashed run is detected and cleared.
LOCKFILE="$HOME/Maildir/.mailsync.lock"
if ! (set -o noclobber; echo $$ > "$LOCKFILE") 2>/dev/null; then
    otherpid=$(cat "$LOCKFILE" 2>/dev/null || true)
    if [ -n "${otherpid:-}" ] && kill -0 "$otherpid" 2>/dev/null; then
        print_status "Another mailsync (pid $otherpid) is already running; nothing to do"
        exit 0
    fi
    print_warning "Clearing stale lock (pid ${otherpid:-unknown} not running)"
    rm -f "$LOCKFILE"
    if ! (set -o noclobber; echo $$ > "$LOCKFILE") 2>/dev/null; then
        print_status "Another mailsync grabbed the lock first; nothing to do"
        exit 0
    fi
fi
trap 'rm -f "$LOCKFILE"' EXIT

# Track if any sync had errors
sync_errors=0

# Initialize mu if needed
if [ ! -d ~/.cache/mu ]; then
    print_status "Initializing mu database..."
    mu init --maildir=~/Maildir \
        --personal-address=u2548636@anu.edu.au \
        --personal-address=ben.swift@anu.edu.au \
        --personal-address=phdconvenor.cybernetics@anu.edu.au \
        --personal-address=benswift@fastmail.com \
        --personal-address=ben@benswift.me
fi

# mbsync can hang rather than fail, which is the worse of the two: a run that
# never returns holds the lock above, so every subsequent timer fire exits
# "already running", and mailsync-scheduled only pages on a non-zero exit ---
# so nothing is sent and mail silently stops arriving. That is not theoretical:
# on 26 Aug 2026 a run sat 16 hours on an ESTABLISHED-but-dead socket to
# fastmail after the machine slept mid-sync, and only a manual look found it.
#
# mbsync's own Timeout (20s by default, 120 for the ANU accounts) does not
# cover this. It bounds connect and data *reads*; a write to a peer that has
# gone away without a RST sits in the retransmit/persist loop indefinitely, and
# no read timeout ever comes due. So cap the wall clock from outside instead.
# A normal run is ~20s, so ten minutes is generous even for a big backlog.
MBSYNC_TIMEOUT="${MBSYNC_TIMEOUT:-600}"

# GNU coreutils timeout: /usr/bin on Linux, brew's coreutils on macOS. If it
# is missing, sync unguarded rather than not at all --- the outer cap in
# mailsync-scheduled still bounds the unattended path.
timeout_bin="$(command -v timeout || command -v gtimeout || true)"
sync_cmd=(mbsync -a)
if [ -n "$timeout_bin" ]; then
    sync_cmd=("$timeout_bin" --kill-after=30 "$MBSYNC_TIMEOUT" "${sync_cmd[@]}")
else
    print_warning "coreutils timeout not found; running mbsync unguarded"
fi

# Sync all accounts
print_status "Syncing all mail accounts..."
if "${sync_cmd[@]}"; then
    print_status "All accounts synced successfully"
else
    sync_status=$?
    # 124: timeout fired. 137: it had to escalate to SIGKILL 30s later.
    if [ "$sync_status" -eq 124 ] || [ "$sync_status" -eq 137 ]; then
        print_error "mbsync exceeded ${MBSYNC_TIMEOUT}s and was killed (dead socket?)"
    else
        print_warning "Mail sync had issues"
    fi
    sync_errors=$((sync_errors + 1))
fi

# Update mu index
print_status "Updating search index..."
mu index

# Summary. Exit non-zero on sync errors so mailsync-scheduled can page ---
# neomutt's `,s` macro ignores the exit code, so this only feeds the timer.
echo ""
if [ $sync_errors -eq 0 ]; then
    print_status "Mail sync completed successfully!"
else
    print_warning "Mail sync completed with $sync_errors account(s) having issues"
    exit 1
fi

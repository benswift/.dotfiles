#!/usr/bin/env bash
#
# Dotfiles management command
# Usage: dotfiles <command>
#
set -euo pipefail

DOTFILES_DIR="${DOTFILES_DIR:-$HOME/.dotfiles}"

source "$DOTFILES_DIR/lib/log.sh"
source "$DOTFILES_DIR/lib/symlink-manifest.sh"
source "$DOTFILES_DIR/lib/private.sh"

pass=0
fail=0
warn=0

check_pass() { echo -e "  ${GREEN}✓${NC} $1"; ((pass++)) || true; }
check_fail() { echo -e "  ${RED}✗${NC} $1"; ((fail++)) || true; }
check_warn() { echo -e "  ${YELLOW}⚠${NC} $1 ${CYAN}(optional)${NC}"; ((warn++)) || true; }
section() { echo -e "\n${CYAN}$1${NC}"; }

command_exists() { command -v "$1" &>/dev/null; }

symlink_valid() {
    local target="$1"
    [[ -L "$target" && -e "$target" ]]
}

check_shell() {
    if [[ "$SHELL" == *zsh ]]; then
        check_pass "zsh is login shell"
        return
    fi

    if ! command_exists zsh; then
        check_fail "zsh not installed"
        return
    fi

    local zsh_path
    zsh_path=$(command -v zsh)

    # An exec stanza in a login rc bridges to zsh when chsh isn't an option
    # (typical on LDAP-managed accounts where the user isn't in /etc/passwd).
    local rc
    for rc in "$HOME/.profile" "$HOME/.bash_profile" "$HOME/.bash_login"; do
        if [[ -f "$rc" ]] && grep -qE "exec[[:space:]]+.*zsh" "$rc"; then
            check_warn "login shell is $SHELL but $(basename "$rc") execs zsh"
            return
        fi
    done

    check_fail "zsh installed at $zsh_path but login shell is $SHELL"

    # Detect LDAP/SSSD account: present via NSS but absent from /etc/passwd.
    # In that case chsh fails with 'user does not exist' --- suggest the
    # exec workaround instead.
    if command_exists getent \
        && ! getent -s files passwd "$USER" >/dev/null 2>&1 \
        && getent passwd "$USER" >/dev/null 2>&1; then
        cat <<EOF
    Account is in LDAP/NSS (not /etc/passwd) --- chsh will fail locally.
    Append to ~/.profile:

      case \$- in
        *i*) [ -x $zsh_path ] && [ -z "\$ZSH_VERSION" ] && exec $zsh_path -l ;;
      esac

    Or ask sysadmin to set loginShell in LDAP.
EOF
    else
        echo "    Run: chsh -s $zsh_path"
    fi
}

check_core() {
    section "Checking core requirements..."

    check_shell

    # Homebrew (macOS only)
    if [[ "$OSTYPE" == darwin* ]]; then
        if command_exists brew; then
            local brew_prefix
            brew_prefix=$(brew --prefix)
            check_pass "Homebrew installed at $brew_prefix"
        else
            check_fail "Homebrew not installed"
        fi
    fi

    # mise
    if command_exists mise; then
        check_pass "mise installed"
    else
        check_fail "mise not installed"
    fi

    # git
    if command_exists git; then
        check_pass "git installed"
    else
        check_fail "git not installed"
    fi

    # zoxide
    if command_exists zoxide; then
        check_pass "zoxide installed"
    else
        check_fail "zoxide not installed"
    fi
}

check_symlinks() {
    section "Checking symlinks..."

    # Verify exactly what create_symlinks.sh installs: everything comes
    # from lib/symlink-manifest.sh, so the two can't drift.
    local entries=("${SYMLINK_MANIFEST[@]}" "${SYMLINK_MANIFEST_WITH_BACKUP[@]}")
    local entry

    for entry in "${entries[@]}"; do
        local expected target pretty
        expected=$(manifest_source "$entry")
        target=$(manifest_target "$entry")
        pretty="${target/#$HOME/\~}"

        if [[ -L "$target" ]]; then
            local actual
            actual=$(readlink "$target")
            if [[ "$actual" == "$expected" ]]; then
                check_pass "$pretty → ${entry%%:*}"
            else
                check_fail "$pretty points to $actual (expected $expected)"
            fi
        elif [[ -e "$target" ]]; then
            check_fail "$pretty exists but is not a symlink"
        else
            check_fail "$pretty missing"
        fi
    done
}

check_tools() {
    section "Checking tools..."

    local optional_tools=(mu mbsync msmtp rclone fzf mosh)

    # helix is built from source by bin/helix-build, not installed by mise, so
    # `hx` merely being on PATH proves nothing: it must be the pinned build,
    # and nothing earlier on PATH may shadow it.
    local helix_status
    if helix_status=$("$DOTFILES_DIR/bin/helix-build" --check 2>&1); then
        check_pass "helix (source build at the pinned rev)"
    else
        check_fail "helix: $(tail -1 <<<"$helix_status")"
    fi

    # Likewise the wiz engine, built by bin/wiz-build from its main. watson
    # knows only the lx vault, whose automation it runs.
    local wiz_status vaults=(ben hdr lx)
    [[ "$(hostname -s)" == watson ]] && vaults=(lx)
    if wiz_status=$("$DOTFILES_DIR/bin/wiz-build" --check 2>&1); then
        check_pass "wiz (source build of main)"
    else
        check_fail "wiz: $(tail -1 <<<"$wiz_status")"
    fi
    # The registry is how wiz's commands and the wiz-due scheduler find the
    # vaults; one missing here silently drops out of both.
    local vault dir
    for vault in "${vaults[@]}"; do
        if dir=$(wiz path "$vault" 2>/dev/null) && [[ -f "$dir/mdbase.yaml" ]]; then
            check_pass "wiz vault $vault registered ($dir)"
        else
            check_fail "wiz vault $vault not registered --- wiz vaults -add <its clone>"
        fi
    done

    for tool in "${optional_tools[@]}"; do
        if command_exists "$tool"; then
            check_pass "$tool"
        else
            check_warn "$tool not installed"
        fi
    done
}

check_script_deps() {
    section "Checking script dependencies..."

    # Hard requirements of bin/ scripts: jq (sync-agent-config),
    # uv (mail utils and the python scripts), ast-grep (the preferred
    # code-search tool per claude/CLAUDE.md). Fall back to 'mise which'
    # so mise-managed tools resolve even when the parent shell hasn't
    # activated mise.
    local tool
    for tool in jq uv ast-grep; do
        if command_exists "$tool" || { command_exists mise && mise which "$tool" &>/dev/null; }; then
            check_pass "$tool"
        else
            check_fail "$tool not installed"
        fi
    done

    # agent-browser is the browser-automation CLI claude/CLAUDE.md prescribes
    if command_exists agent-browser; then
        check_pass "agent-browser"
    else
        check_warn "agent-browser not installed"
    fi
}

check_mise_tools() {
    section "Checking mise-managed tools..."

    if ! command_exists mise; then
        check_fail "mise not available, skipping tool check"
        return
    fi

    local tools
    tools=$(mise list --current 2>/dev/null | awk '{print $1}' | sort -u || echo "")

    if [[ -z "$tools" ]]; then
        check_warn "no mise tools installed (run 'mise install')"
    else
        for tool in $tools; do
            check_pass "$tool"
        done
    fi
}

check_directories() {
    section "Checking directories..."

    local dirs=(
        "$HOME/.config/mise"
        "$HOME/.claude"
        "$HOME/.codex"
    )

    local optional_dirs=(
        "$HOME/Maildir"
        "$HOME/.config/neomutt"
        "$HOME/.config/ghostty"
    )

    for dir in "${dirs[@]}"; do
        if [[ -d "$dir" ]]; then
            check_pass "$(basename "$dir")/"
        else
            check_fail "$(basename "$dir")/ missing"
        fi
    done

    for dir in "${optional_dirs[@]}"; do
        if [[ -d "$dir" ]]; then
            check_pass "$(basename "$dir")/"
        else
            check_warn "$(basename "$dir")/ missing"
        fi
    done
}

# One tracked plist: installed, identical to the tracked copy, loaded, and not
# broken. Also used by the private overlay's check_private.
check_launchd_job() {
    local plist="$1" label installed job
    label=$(basename "$plist" .plist)
    installed="$HOME/Library/LaunchAgents/$label.plist"
    if [[ ! -f "$installed" ]]; then
        check_fail "$label not installed (see ${plist#"$DOTFILES_DIR"/} header)"
        return
    fi
    if ! cmp -s "$plist" "$installed"; then
        check_fail "$label installed copy differs from ${plist#"$DOTFILES_DIR"/}"
        return
    fi
    if ! launchctl print "gui/$(id -u)/$label" >/dev/null 2>&1; then
        check_fail "$label not loaded (launchctl bootstrap it)"
        return
    fi
    # Broken is launchd-run's verdict, not launchd's last exit code, which is
    # non-zero after any blip the wrapper deliberately ignores (a sleep, a
    # single failure). The wrapper's marker exists from the page until the
    # next success.
    job=$(plutil -extract ProgramArguments.1 raw "$plist")
    if [[ -f "${XDG_STATE_HOME:-$HOME/.local/state}/launchd-run/$job.failed" ]]; then
        check_fail "$label failing, paged (see ~/Library/Logs/$job.log)"
    else
        check_pass "$label loaded"
    fi
}

# The plists in launchd/ are installed by hand (see each header), so this is
# what notices an installed copy drifting from the tracked one, a job that was
# never bootstrapped, or one launchd-run has paged about.
check_launchd() {
    [[ "$OSTYPE" == darwin* ]] || return 0
    section "Checking launchd jobs..."

    local plist label
    for plist in "$DOTFILES_DIR"/launchd/*.plist; do
        label=$(basename "$plist" .plist)
        check_launchd_job "$plist"
    done

    # A plist left behind by a job that no longer exists in launchd/ (or the
    # private overlay's) keeps running whatever it pointed at.
    local stray
    for stray in "$HOME"/Library/LaunchAgents/com.benswift.*.plist "$HOME"/Library/LaunchAgents/com.xwmx.*.plist; do
        [[ -f "$stray" ]] || continue
        label=$(basename "$stray" .plist)
        [[ -f "$DOTFILES_DIR/launchd/$label.plist" || -f "$PRIVATE_DIR/launchd/$label.plist" ]] ||
            check_warn "$label installed but not in launchd/ (bootout and remove it)"
    done
}

check_skill_yaml() {
    if "$DOTFILES_DIR/bin/check-skill-yaml" "$1" >/dev/null 2>&1; then
        check_pass "skill front matter parses"
    else
        check_fail "skill front matter has YAML errors (run check-skill-yaml $1)"
    fi
}

check_agent_config() {
    section "Checking AI agent configuration..."

    local ben_skills="$HOME/.claude/plugins/marketplaces/ben/skills"

    if command_exists claude; then
        check_pass "claude installed"
    else
        check_fail "claude not installed"
    fi

    if [[ -d "$ben_skills" ]]; then
        check_pass "ben marketplace skills cloned"
        check_skill_yaml "$ben_skills"
    else
        check_fail "ben marketplace skills missing"
    fi

    if [[ -f "$HOME/.agents/skills/agent-browser/SKILL.md" ]]; then
        check_pass "agent-browser skill installed for Codex"
    else
        check_warn "agent-browser skill not installed in ~/.agents"
    fi

    if command_exists claude && command_exists jq; then
        local plugins
        if plugins=$(claude plugin list --json 2>/dev/null) &&
            jq -e '.[] | select(.id == "ben@ben" and .enabled == true)' >/dev/null <<<"$plugins"; then
            check_pass "ben@ben Claude plugin enabled"
        else
            check_fail "ben@ben Claude plugin not enabled"
        fi
    else
        check_warn "claude or jq unavailable, skipping plugin status"
    fi
}

# The private overlay (lib/private.sh): its own checks, or a note that this
# machine runs without it.
check_private() {
    section "Checking private overlay..."
    if [[ ! -d "$PRIVATE_DIR/.git" ]]; then
        check_warn "no overlay at $PRIVATE_DIR --- 'dotfiles update' clones it once this machine's ssh key can read $PRIVATE_REPO"
        return
    fi
    check_pass "overlay at $PRIVATE_DIR"
    if [[ -f "$PRIVATE_DIR/lib/doctor.sh" ]]; then
        # shellcheck disable=SC1091  # the private overlay's, absent in public CI
        source "$PRIVATE_DIR/lib/doctor.sh"
        private_doctor
    fi
}

doctor() {
    echo ""
    echo "╔═══════════════════════════════════════╗"
    echo "║         Dotfiles Doctor               ║"
    echo "╚═══════════════════════════════════════╝"

    check_core
    check_symlinks
    check_tools
    check_script_deps
    check_mise_tools
    check_directories
    check_launchd
    check_private
    check_agent_config

    echo ""
    section "Summary"
    echo -e "  ${GREEN}$pass passed${NC}, ${RED}$fail failed${NC}, ${YELLOW}$warn warnings${NC}"
    echo ""

    if [[ $fail -gt 0 ]]; then
        echo "Run '$DOTFILES_DIR/create_symlinks.sh' to fix symlinks"
        echo "Run '$DOTFILES_DIR/install.sh' for full setup"
        return 1
    fi
}

update() {
    echo "Updating dotfiles..."

    # --autostash so a dirty working tree doesn't block the pull: git shelves
    # the changes, rebases, then restores them. The one case worth bailing on
    # is a restore that conflicts --- and git reports that as a *warning* and
    # still exits 0, leaving the tree conflicted. It does keep the stash entry
    # in that case (and drops it on success), so the stash ref moving is the
    # honest signal, not the exit status.
    local stash_before stash_after
    stash_before="$(git -C "$DOTFILES_DIR" rev-parse -q --verify refs/stash || true)"
    if ! git -C "$DOTFILES_DIR" pull --rebase --autostash; then
        echo "Pull failed --- sort out the repo state, then re-run." >&2
        return 1
    fi
    stash_after="$(git -C "$DOTFILES_DIR" rev-parse -q --verify refs/stash || true)"
    if [[ "$stash_after" != "$stash_before" ]]; then
        echo "Autostash couldn't be restored cleanly --- your changes are safe in stash@{0}." >&2
        echo "Resolve the conflicts (git stash pop / git stash drop), then re-run 'dotfiles update'." >&2
        return 1
    fi

    # Before the symlinks, so they pick up the overlay's manifest.
    private_sync
    "$DOTFILES_DIR/create_symlinks.sh"
    # Install whatever the pull just changed in mise/config.toml, before the
    # steps below run scripts written against the new versions. A pin that
    # moved is the case that matters: restic's reads and writes a shared
    # backup repo, and lumis's CLI is what bin/lumis-parsers drives. A tool on
    # "latest" that is already installed is left alone --- upgrading those is
    # `mise upgrade`'s job. From $HOME, so only the global config is in scope
    # and not a mise.toml in whatever directory this was run from.
    mise --cd "$HOME" install --yes
    # A no-op unless the pull just moved helix/pinned-rev; only then does this
    # pay for a compile.
    "$DOTFILES_DIR/bin/helix-build" ||
        echo "helix build failed --- hx is still the previously built binary"
    "$DOTFILES_DIR/bin/wiz-build" ||
        echo "wiz build failed --- wiz is still the previously built binary"
    "$DOTFILES_DIR/bin/sync-agent-config" --update-claude
    "$DOTFILES_DIR/bin/lumis-parsers" --update || echo "parser sync failed --- yazi previews fall back to bat"
    private_setup
    echo "Done!"
}

usage() {
    echo "Usage: dotfiles <command>"
    echo ""
    echo "Commands:"
    echo "  doctor    Check if everything is set up correctly"
    echo "  update    Pull latest changes and re-run symlinks"
    echo "  edit      Open dotfiles in editor"
    echo "  cd        Print dotfiles directory (use: cd \$(dotfiles cd))"
    echo ""
}

case "${1:-}" in
    doctor) doctor ;;
    update) update ;;
    edit)   "${EDITOR:-hx}" "$DOTFILES_DIR" ;;
    cd)     echo "$DOTFILES_DIR" ;;
    *)      usage ;;
esac

[apply]
	# Detect whitespace errors when applying a patch
	whitespace = fix

[core]
	# Use custom `.gitignore`
	excludesfile = ~/.gitignore
	# Git only reads ~/.config/git/attributes by default, so the mergiraf
	# driver in ~/.gitattributes needs this to activate
	attributesfile = ~/.gitattributes
	# Treat spaces before tabs, lines that are indented with 8 or more spaces, and all kinds of trailing whitespace as an error
	whitespace = space-before-tab,trailing-space
	autocrlf = input
	# git only pages terminal output, so agents and scripts reading `git diff`
	# still get the raw patch
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true

[init]
   defaultBranch = main

[color]
	# Use colors in Git commands that are capable of colored output when outputting to the terminal
	ui = auto
[color "branch"]
	current = yellow reverse
	local = yellow
	remote = green
[color "diff"]
	meta = yellow bold
	frag = magenta bold
	old = red bold
	new = green bold
[color "status"]
	added = yellow
	changed = green
	untracked = cyan

[diff]
	algorithm = histogram

[merge]
	# Include summaries of merged commits in newly created merge commit messages
	log = true
	# Conflict markers carry the common ancestor as well as both sides
	conflictStyle = zdiff3

[rerere]
	# Replay a conflict resolution when the same conflict comes back, as it
	# does on each rebase of a long-lived branch
	enabled = true

[rebase]
	autoStash = true
	# Move any branch that points into the rebased range along with it
	updateRefs = true

[push]
	autoSetupRemote = true

[fetch]
	prune = true

[branch]
	sort = -committerdate

[merge "mergiraf"]
    name = mergiraf
    driver = mergiraf merge --git %O %A %B -s %S -x %X -y %Y -p %P -l %L

[pull]
	rebase = true

[user]
	name = Ben Swift
	email = ben@benswift.me

[github]
	user = benswift

[filter "lfs"]
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process

[url "git@github.com:"]
	insteadOf = https://github.com/

# COMP4020 crit agents (weddle only; TASK-28.1 AC#3/#4): interactive sessions
# inside an agent's directory commit as that agent, not as Ben. Scheduled runs
# don't read this file at all (they run with HOME=<agent dir>); these entries
# cover the convenor's own sessions. Trailing / makes the match recursive, and
# the entries are inert on machines without these directories.
[includeIf "gitdir:~/projects/comp4020/agents/shitao/"]
	path = ~/projects/comp4020/agents/shitao/.gitconfig
[includeIf "gitdir:~/projects/comp4020/agents/bada/"]
	path = ~/projects/comp4020/agents/bada/.gitconfig
[includeIf "gitdir:~/projects/comp4020/agents/baishi/"]
	path = ~/projects/comp4020/agents/baishi/.gitconfig
[includeIf "gitdir:~/projects/comp4020/agents/dachi/"]
	path = ~/projects/comp4020/agents/dachi/.gitconfig
[includeIf "gitdir:~/projects/comp4020/agents/yunlin/"]
	path = ~/projects/comp4020/agents/yunlin/.gitconfig
[includeIf "gitdir:~/projects/comp4020/agents/liuru/"]
	path = ~/projects/comp4020/agents/liuru/.gitconfig
[credential "https://github.com"]
	helper = 
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !gh auth git-credential
[credential "https://git.overleaf.com"]
	helper = 
	helper = "!f() { test \"$1\" = get && echo username=git && echo \"password=$OVERLEAF_GIT_TOKEN\"; }; f"

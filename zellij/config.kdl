// Overrides on top of zellij's default keybindings, deliberately not
// `clear-defaults=true`: a full copy of the default keymap freezes it, and
// misses every binding a later release adds.
keybinds {
    // Ctrl x toggles locked mode, in place of the default Ctrl g.
    unbind "Ctrl g"
    locked {
        bind "Ctrl x" {
            SwitchToMode "normal"
        }
    }
    shared_except "locked" {
        bind "Ctrl x" {
            SwitchToMode "locked"
        }
        bind "Alt s" {
            Run "zj-switch" {
                floating true
                close_on_exit true
                width "50%"
                height "40%"
                x "25%"
                y "30%"
            }
        }
    }
    // Ctrl b would enter the unused tmux mode; leave it to the shell and
    // editor. Scroll and search keep it as page-up.
    shared_except "locked" "scroll" "search" {
        unbind "Ctrl b"
    }
}
theme "catppuccin-mocha"
// zellij's compact layout with a clock; see layouts/compact-clock.kdl.
default_layout "compact-clock"
show_startup_tips false

